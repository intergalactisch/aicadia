preflight() {
    local codex_bin prerequisite result=1
    reject_public_overrides || return
    [[ -n "${DATABASE_URL:-}" ]] || fail 'DATABASE_URL must name a PostgreSQL administration database.' || return
    for prerequisite in cargo curl jq openssl perl shasum; do
        command -v "$prerequisite" >/dev/null || fail "missing prerequisite: $prerequisite" || return
    done
    [[ -x "$SYSTEM_ENV" ]] || fail "exact environment launcher missing: $SYSTEM_ENV" || return
    validate_candidate_freeze || return
    codex_bin="$(resolve_codex_bin)" || fail 'Codex CLI is unavailable through PATH.' || return
    validate_token_free_contract || return
    validate_output_schemas || fail 'six strict Trait schemas are invalid.' || return
    validate_allowlists || fail 'one Trait Agent phase exceeds its least-privilege allowlist.' || return
    validate_codex "$codex_bin" || return
    (cd "$REPO_DIR" && cargo build --quiet --bin aicadia --bin aicadia-provision-user --bin aicadia-playtest-database) \
        || fail 'required World/operator binaries do not build.' || return
    prepare_preflight_artifacts || return
    trap 'preflight_exit_cleanup $?' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    local catalog_hash schema_hash
    catalog_hash="$(shasum -a 256 "$TOOL_CATALOG" | awk '{print $1}')" || return
    schema_hash="$(shasum -a 256 "$SCHEMA_DIR/proposals.json" "$SCHEMA_DIR/establish-preview.json" \
        "$SCHEMA_DIR/establish-commit.json" "$SCHEMA_DIR/develop-preview.json" "$SCHEMA_DIR/develop-commit.json" \
        "$SCHEMA_DIR/observer.json" | shasum -a 256 | awk '{print $1}')" || return
    manifest_set '.catalog.fixture_sha256=$catalog | .schemas.bundle_sha256=$schemas' \
        --arg catalog "$catalog_hash" --arg schemas "$schema_hash" || return
    if start_owned_server && verify_runtime_catalog; then
        manifest_set '.catalog.status="live_runtime_equal"' || return
        if [[ "${AICADIA_INTERNAL_TRAIT_PREFLIGHT_MODE:-}" == fail-after-catalog ]]; then
            fail 'injected token-free failure after catalog verification.'
            return 1
        fi
        if cleanup_owned_database; then
            manifest_set '.run_status="preflight_go" | .go=true' || return
            find "$RUN_DIR" -type f -exec chmod 600 {} +
            [[ "$(stat -f '%Lp' "$RUN_DIR")" == 700 ]] || return
            [[ -z "$(find "$RUN_DIR" -type f ! -perm 600 -print -quit)" ]] || return
            jq -c '{go,candidate_started,authorization_consumed,codex_invoked,model_calls,candidate_digest,paid_command,frozen,codex,catalog,schemas,deployment,cleanup,evidence_dir:$dir}' \
                --arg dir "$RUN_DIR" "$MANIFEST"
            trap - EXIT INT TERM HUP
            return 0
        fi
    fi
    manifest_set '.run_status="preflight_no_go" | .go=false' || true
    cleanup_owned_database || true
    printf 'trait-playtest: NO-GO; token-free preflight evidence retained at %s\n' "$RUN_DIR" >&2
    return "$result"
}

http_request() {
    local method="$1" path="$2" user_id="$3" body="$4" expected="$5" output="$6" status
    local -a args=(--disable --silent --show-error --connect-timeout 2 --max-time 10 -X "$method" -H 'Content-Type: application/json')
    [[ -z "$user_id" ]] || args+=(-H "Aicadia-User-Id: $user_id")
    [[ -z "$body" ]] || args+=(--data "$body")
    args+=(-o "$output" -w '%{http_code}' "$BASE_URL$path")
    status="$(curl "${args[@]}")" || return
    [[ "$status" == "$expected" ]] || fail "$method $path returned $status, expected $expected." || return
    jq -e 'type=="object"' "$output" >/dev/null
    chmod 600 "$output"
}

agent_timeout_seconds() {
    local value="${AICADIA_AGENT_TIMEOUT_SECONDS:-$DEFAULT_AGENT_TIMEOUT_SECONDS}"
    [[ "$value" =~ ^[0-9]+$ && "$value" -ge 30 && "$value" -le 1800 ]] \
        || fail 'AICADIA_AGENT_TIMEOUT_SECONDS must be 30 through 1800.' || return
    printf '%s\n' "$value"
}

