validate_action_commit() {
    local events="$1" final="$2" preview="$3" marker="$4" revision="$5" pip_id="$6"
    validate_event_tools "$events" "$ACTION_COMMIT_TOOLS" || return
    local call
    call="$(single_completed_call "$events")" || return
    jq -e --arg revision "$revision" --arg pip "$pip_id" --slurpfile preview "$preview" '
      (.arguments|keys|sort)==(["request_id","expected_place_revision","prose","consequence"]|sort)
      and (.arguments.request_id|test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"))
      and .arguments.expected_place_revision==$revision and .arguments.prose==$preview[0].prose
      and .arguments.consequence=={type:"change_entity_trait",trait_change:[{type:"establish",entity_id:$pip,statement:$preview[0].proposed_characterization}]}
      and .result.structured_content.activity.operation=="submit_action"
      and .result.structured_content.activity.prose==$preview[0].prose
      and .result.structured_content.activity.trait_change[0].type=="establish"
      and .result.structured_content.activity.trait_change[0].entity.id==$pip
      and .result.structured_content.activity.trait_change[0].trait.statement==$preview[0].proposed_characterization
    ' <<<"$call" >/dev/null || return
    jq -e --arg marker "$marker" --argjson call "$call" '
      .status=="committed" and .marker==$marker and .request_id==$call.arguments.request_id
      and .activity_id==$call.result.structured_content.activity.id
      and .trait_id==$call.result.structured_content.activity.trait_change[0].trait.id
      and .entity_id==$call.result.structured_content.activity.trait_change[0].entity.id
      and .statement==$call.result.structured_content.activity.trait_change[0].trait.statement
    ' "$final" >/dev/null
}

