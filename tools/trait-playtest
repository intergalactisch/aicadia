build_sanitized_env() {
    local variable
    SANITIZED_ENV=()
    while IFS= read -r variable; do
        case "$variable" in
            DATABASE_URL|AICADIA_DATABASE_NAME|AICADIA_PORT|AICADIA_AGENT_TIMEOUT_SECONDS|AICADIA_TRAIT_PLAYTEST_*|AICADIA_INTERNAL_TRAIT_*|CODEX_BIN|FAKE_*|PGDATABASE|PGHOST|PGHOSTADDR|PGPASSWORD|PGPORT|PGSERVICE|PGSERVICEFILE|PGSSLMODE|PGUSER)
                SANITIZED_ENV+=(-u "$variable") ;;
        esac
    done < <(compgen -e)
}

stop_agent_watchdog() {
    [[ -z "$AGENT_WATCHDOG_PID" ]] || { kill -TERM "$AGENT_WATCHDOG_PID" 2>/dev/null || true; wait "$AGENT_WATCHDOG_PID" 2>/dev/null || true; }
    AGENT_WATCHDOG_PID=''
}

terminate_agent_group() { [[ -z "$1" ]] || { kill -TERM -- "-$1" 2>/dev/null || true; sleep 0.1; kill -KILL -- "-$1" 2>/dev/null || true; }; }

run_codex_process() {
    local cwd="$1" user_id="$2" events="$3" stderr="$4" timeout status pgid marker
    shift 4
    timeout="$(agent_timeout_seconds)" || return
    build_sanitized_env
    marker="${events%.events.jsonl}.timeout"
    manifest_set '.codex_invoked=true | .model_calls += 1' || return
    /usr/bin/perl -e 'chdir shift or exit 125; setpgrp 0,0; exec @ARGV' "$cwd" \
        "$SYSTEM_ENV" "${SANITIZED_ENV[@]}" AICADIA_USER_ID="$user_id" "$@" >"$events" 2>"$stderr" &
    AGENT_PID=$!; pgid="$AGENT_PID"
    /usr/bin/perl -e 'my($seconds,$pgid,$marker)=@ARGV;sleep $seconds;if(kill 0,-$pgid){open my $f,">",$marker or exit 125;print {$f} "deadline_exceeded\n";close $f;kill "TERM",-$pgid;select undef,undef,undef,0.5;kill "KILL",-$pgid}' \
        "$timeout" "$pgid" "$marker" &
    AGENT_WATCHDOG_PID=$!
    wait "$AGENT_PID"; status=$?
    [[ -f "$marker" ]] && wait "$AGENT_WATCHDOG_PID" 2>/dev/null || stop_agent_watchdog
    AGENT_WATCHDOG_PID=''; terminate_agent_group "$pgid"; AGENT_PID=''
    chmod 600 "$events" "$stderr"
    [[ ! -f "$marker" ]] || return 142
    return "$status"
}

