validate_interaction_commit() {
    local events="$1" final="$2" preview="$3" marker="$4" revision="$5" pip="$6" mara="$7" trait="$8"
    validate_event_tools "$events" "$INTERACTION_COMMIT_TOOLS" || return
    local call
    call="$(single_completed_call "$events")" || return
    jq -e --arg revision "$revision" --arg pip "$pip" --arg mara "$mara" --arg trait "$trait" --slurpfile preview "$preview" '
      (.arguments|keys|sort)==(["request_id","expected_place_revision","prose","target_entity_id","property_change","trait_change"]|sort)
      and (.arguments.request_id|test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"))
      and .arguments.expected_place_revision==$revision and .arguments.prose==$preview[0].prose
      and .arguments.target_entity_id==[$mara] and .arguments.property_change==[]
      and .arguments.trait_change==[{type:"develop",trait_id:$trait,statement:$preview[0].proposed_characterization}]
      and .result.structured_content.activity.operation=="submit_interaction"
      and .result.structured_content.activity.trait_change==[{type:"develop",entity:{id:$pip,name:.result.structured_content.activity.actor_character.name},trait:{id:$trait,statement:$preview[0].proposed_characterization},previous_statement:$preview[0].current_characterization}]
      and ([.result.structured_content.activity.involved_entity[].role]|sort)==["location","target"]
    ' <<<"$call" >/dev/null || return
