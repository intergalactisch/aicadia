fail() {
    printf 'trait-playtest: %s\n' "$*" >&2
    if [[ -n "$MANIFEST" && -f "$MANIFEST" ]]; then
        local temporary="$MANIFEST.failed"
        jq '.validation="failed" | .run_status="failed"
            | if .cleanup.status=="pending" then .cleanup.status="not_needed" else . end' \
            "$MANIFEST" >"$temporary" && mv "$temporary" "$MANIFEST"
        chmod 600 "$MANIFEST"
    fi
    return 1
}

initial_statement_for_marker() { printf 'Waits for the second echo before springing — %s.' "$1"; }
developed_statement_for_marker() { printf 'Reads Mara’s second footfall through the returning echo — %s.' "$1"; }
action_prose_for_marker() { printf 'At the Echo Arch, Pip waits for the second echo before springing — %s.' "$1"; }
interaction_prose_for_marker() { printf 'Pip circles Mara once, pauses, then moves only after her second footfall — %s.' "$1"; }

manifest_set() {
    local expression="$1"
    shift
    local temporary="$MANIFEST.tmp"
    jq "$@" "$expression" "$MANIFEST" >"$temporary" && mv "$temporary" "$MANIFEST"
    chmod 600 "$MANIFEST"
}

validate_schema_policy() {
    jq -e '
        def forbidden: ["uniqueItems","minLength","maxLength","allOf","not","if","then","else"];
        ([..|objects|keys[]|select(. as $key|(forbidden|index($key))!=null)]|length)==0
        and all(..|objects|select(.type?=="object");
            .additionalProperties==false and (.properties|type)=="object"
            and (.required|type)=="array"
            and (.required|sort)==(.properties|keys|sort))
    ' "$1" >/dev/null
}

validate_token_free_contract() {
    local schema
    command -v jq >/dev/null || fail 'jq is required.' || return
    [[ -f "$TOOL_CATALOG" ]] || fail 'the exact catalog fixture is missing.' || return
    jq -e --argjson expected "$CAPABILITIES" '
        type=="array" and [.[]|.name]==$expected and length==13
        and all(.[];(.description|type)=="string" and (.description|length)>0
            and (.inputSchema|type)=="object" and (.outputSchema|type)=="object")
        and (map(select(.name=="get_entity_at_current_place"))[0].description|contains("Property and Trait"))
        and (map(select(.name=="submit_action"))[0].description|contains("Traits in one mixed package"))
        and (map(select(.name=="submit_interaction"))[0].description|contains("target-authored"))
    ' "$TOOL_CATALOG" >/dev/null || fail 'the fixed Trait-aware thirteen-tool catalog is invalid.' || return
    jq -n -e --argjson all "$CAPABILITIES" --argjson ar "$ACTION_READ_TOOLS" \
        --argjson ac "$ACTION_COMMIT_TOOLS" --argjson ir "$INTERACTION_READ_TOOLS" \
        --argjson ic "$INTERACTION_COMMIT_TOOLS" --argjson observer "$OBSERVER_TOOLS" --argjson zero "$ZERO_TOOL_TOOLS" '
        def subset($set): all(.[];. as $item|($set|index($item))!=null);
        ($ar|subset($all)) and ($ac|subset($all)) and ($ir|subset($all))
        and ($ic|subset($all)) and ($observer|subset($all))
        and $ac==["submit_action"] and $ic==["submit_interaction"]
        and $zero==[]
        and ([$ar[],$ir[],$observer[]]|index("submit_action")|not)
        and ([$ar[],$ir[],$observer[]]|index("submit_interaction")|not)
    ' >/dev/null || fail 'one fake Agent role is not least privilege.' || return
    for schema in proposals establish-preview establish-commit develop-preview develop-commit observer; do
        [[ -f "$SCHEMA_DIR/$schema.json" ]] || fail "missing schema $schema.json" || return
        validate_schema_policy "$SCHEMA_DIR/$schema.json" \
            || fail "schema $schema.json violates the closed token-free policy" || return
    done
    printf 'Trait token-free contract passed: catalog, schemas and least-privilege roles.\n'
}

prepare_artifacts() {
    local root run_id marker
    umask 077
    root="${AICADIA_TRAIT_PLAYTEST_OUTPUT_ROOT:?internal fake run requires AICADIA_TRAIT_PLAYTEST_OUTPUT_ROOT}"
    if [[ -e "$root" ]]; then
        [[ -d "$root" && ! -L "$root" ]] || fail 'output root must be a real directory.' || return
    else
        mkdir -p "$root" || return
    fi
    RUN_DIR="$(mktemp -d "$root/run-XXXXXXXX")" || return
    chmod 700 "$RUN_DIR"
    MANIFEST="$RUN_DIR/manifest.json"
    run_id="$(basename "$RUN_DIR")"
    marker="aicadia-trait-fake-$run_id"
    jq -n --arg run "$run_id" --arg marker "$marker" --arg mode "$MODE" '
      {run_id:$run,evidence_kind:"fake_controller_test",marker:$marker,mode:$mode,
       codex_invoked:false,model_calls:0,paid_candidate:false,
       roles:{action_read:["get_world","get_character","list_entity_at_current_place","list_activity_at_current_place"],
              zero_tool_preview:[],
              action_commit:["submit_action"],
              interaction_read:["get_character","list_entity_at_current_place","list_activity_at_current_place","get_entity_at_current_place"],
              interaction_commit:["submit_interaction"],
              observer:["get_character","list_entity_at_current_place","get_entity_at_current_place","list_activity_at_current_place"]},
       phases:{action_proposals:"pending",action_preview:"pending",action_commit:"pending",
               interaction_proposals:"pending",interaction_preview:"pending",interaction_commit:"pending",
               observer:"pending"},
       validation:"pending",run_status:"running",
       cleanup:{kind:"no_database_or_process_created",status:"pending"}}
    ' >"$MANIFEST" || return
    chmod 600 "$MANIFEST"
}

emit_pair() {
    local file="$1" tool="$2" arguments="$3" result="$4" sequence="$5"
    validate_tool_output "$tool" "$result" \
        || { fail "fake $tool structured_content violates its runtime outputSchema."; return 1; }
    jq -nc --arg id "call-$sequence" --arg tool "$tool" --argjson arguments "$arguments" \
        '{type:"item.started",item:{id:$id,type:"mcp_tool_call",server:"aicadia",tool:$tool,arguments:$arguments,result:null,status:"in_progress",error:null}}' >>"$file"
    jq -nc --arg id "call-$sequence" --arg tool "$tool" --argjson arguments "$arguments" --argjson result "$result" \
        '{type:"item.completed",item:{id:$id,type:"mcp_tool_call",server:"aicadia",tool:$tool,arguments:$arguments,result:{structured_content:$result},status:"completed",error:null}}' >>"$file"
}

validate_tool_output() {
    local tool="$1" result="$2" schema
    schema="$(jq -c --arg tool "$tool" '.[]|select(.name==$tool)|.outputSchema' "$TOOL_CATALOG")" || return
    [[ -n "$schema" ]] || return 1
    jq -n -e --argjson root "$schema" --argjson value "$result" '
      def type_matches($value;$type):
        if $type=="object" then ($value|type)=="object"
        elif $type=="array" then ($value|type)=="array"
        elif $type=="string" then ($value|type)=="string"
        elif $type=="integer" then (($value|type)=="number" and ($value|floor)==$value)
        elif $type=="number" then ($value|type)=="number"
        elif $type=="boolean" then ($value|type)=="boolean"
        elif $type=="null" then $value==null
        else false end;
      def format_matches($value;$format):
        if $format=="uuid" then
          (($value|type)=="string"
            and ($value|test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$")))
        elif $format=="date-time" then
          (($value|type)=="string"
            and (try (($value|sub("\\.[0-9]+Z$";"Z")) as $normalized
              | (($normalized|fromdateiso8601|todateiso8601)==$normalized)) catch false))
        elif $format=="int64" then
          (($value|type)=="number" and ($value|floor)==$value
            and $value>=-9223372036854775808 and $value<=9223372036854775807)
        else true end;
      def valid($root;$schema;$value):
        if ($schema|has("$ref")) then
          ($schema["$ref"]|split("/")[-1]) as $name
          | valid($root;$root["$defs"][$name];$value)
        elif ($schema|has("oneOf")) then
          ([$schema.oneOf[]|. as $option|select(valid($root;$option;$value))]|length)==1
        else
          (if ($schema|has("type")) then
             if ($schema.type|type)=="array" then
               ([$schema.type[]|. as $candidate|type_matches($value;$candidate)]|any)
             else type_matches($value;$schema.type) end
           else true end)
          and (if ($schema|has("const")) then $value==$schema.const else true end)
          and (if ($schema|has("enum")) then ($schema.enum|index($value))!=null else true end)
          and (if ($schema|has("format")) then format_matches($value;$schema.format) else true end)
          and (if (($schema.type? // null)=="object") then
             (($value|type)=="object")
             and (if ($schema|has("required")) then
               all($schema.required[];. as $key|$value|has($key))
             else true end)
             and (if $schema.additionalProperties?==false then
               (($value|keys)-($schema.properties|keys)|length)==0
             else true end)
             and (if ($schema|has("properties")) then
               all($schema.properties|to_entries[];. as $property
                 | (($value|has($property.key)|not)
                   or valid($root;$property.value;$value[$property.key])))
             else true end)
           else true end)
          and (if (($schema.type? // null)=="array" and ($schema|has("items"))) then
             all($value[];. as $item|valid($root;$schema.items;$item))
           else true end)
        end;
      valid($root;$root;$value)
    ' >/dev/null
}

write_prompt() {
    local file="$1" phase="$2" text="$3"
    printf 'TOKEN-FREE FAKE CONTROLLER — %s\n%s\n' "$phase" "$text" >"$file"
    chmod 600 "$file"
}

paired_tools_equal() {
    local file="$1" expected="$2"
    jq -s -e --argjson expected "$expected" '
      [.[]|select(.item?.type=="mcp_tool_call")|{event:.type,item:.item}] as $all
      | [$all[]|select(.event=="item.started")|.item] as $started
      | [$all[]|select(.event=="item.completed")|.item] as $completed
      | [$started[].tool]==$expected and [$completed[].tool]==$expected
      and [$started[].id]==[$completed[].id]
      and [$started[].arguments]==[$completed[].arguments]
      and all($started[];.status=="in_progress" and .result==null and .error==null)
      and all($completed[];.status=="completed" and .error==null)
    ' "$file" >/dev/null
}

run_fake() {
    local marker place_revision pip mara place trait establish_activity develop_activity
    local pip_owner mara_owner introduced_at pip_entity mara_entity place_entity place_output place_flat
    local initial developed action_prose interaction_prose action_events interaction_events observer_events
    local proposals action_preview action_commit interaction_preview interaction_commit observer
    validate_token_free_contract || return 1
    prepare_artifacts || return 1
    marker="$(jq -r '.marker' "$MANIFEST")"
    place_revision='v1.fake.trait.before'
    pip='11111111-1111-4111-8111-111111111111'
    mara='22222222-2222-4222-8222-222222222222'
    place='33333333-3333-4333-8333-333333333333'
    trait='44444444-4444-4444-8444-444444444444'
    establish_activity='55555555-5555-4555-8555-555555555555'
    develop_activity='66666666-6666-4666-8666-666666666666'
    pip_owner='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
    mara_owner='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
    introduced_at='2026-08-13T19:00:00.123456Z'
    pip_entity="$(jq -nc --arg id "$pip" --arg owner "$pip_owner" --arg at "$introduced_at" '{id:$id,name:"Pip",description:"A small grey rat-like traveler.",introduced_by_user_id:$owner,introduced_at:$at}')"
    mara_entity="$(jq -nc --arg id "$mara" --arg owner "$mara_owner" --arg at "$introduced_at" '{id:$id,name:"Mara",description:"A traveler in a red wool coat.",introduced_by_user_id:$owner,introduced_at:$at}')"
    place_entity="$(jq -nc --arg id "$place" --arg owner "$pip_owner" --arg at "$introduced_at" '{id:$id,name:"Echo Arch",description:"A stone arch that returns each footfall.",introduced_by_user_id:$owner,introduced_at:$at}')"
    place_output="$(jq -nc --argjson entity "$place_entity" '{entity:$entity,is_entry:true}')"
    place_flat="$(jq -nc --arg id "$place" '{id:$id,name:"Echo Arch",description:"A stone arch that returns each footfall."}')"
    initial="$(initial_statement_for_marker "$marker")"
    developed="$(developed_statement_for_marker "$marker")"
    action_prose="$(action_prose_for_marker "$marker")"
    interaction_prose="$(interaction_prose_for_marker "$marker")"

    action_events="$RUN_DIR/action-proposals.events.jsonl"; : >"$action_events"
    write_prompt "$RUN_DIR/action-proposals.prompt.txt" action-proposals \
        'Ground with the four read-only tools. Selection, steering and confirmation are withheld. Return exactly three proposals; mutate nothing.'
    local action_character_result action_entity_page action_activity_page
    action_character_result="$(jq -nc --argjson entity "$pip_entity" --arg owner "$pip_owner" --argjson place "$place_output" --arg revision "$place_revision" '{character:{entity:$entity,owner_user_id:$owner,current_place:$place},place_revision:$revision,current_state:{association:[],next:null}}')"
    [[ "$MODE" != malformed-character-result ]] \
        || action_character_result="$(jq 'del(.character.owner_user_id)' <<<"$action_character_result")"
    [[ "$MODE" != malformed-date-time-result ]] \
        || action_character_result="$(jq '.character.entity.introduced_at="2026-02-30T19:00:00.123Z"' <<<"$action_character_result")"
    action_entity_page="$(jq -nc --argjson place "$place_flat" --argjson entity "$mara_entity" --arg revision "$place_revision" '{place:$place,place_revision:$revision,entity:[$entity|{id,name,description}],next:null}')"
    action_activity_page="$(jq -nc --argjson place "$place_flat" --arg revision "$place_revision" '{place:$place,place_revision:$revision,activity:[],next:null}')"
    emit_pair "$action_events" get_world '{}' '{"name":"Aicadia"}' 1 || return 1
    emit_pair "$action_events" get_character '{}' "$action_character_result" 2 || return 1
    emit_pair "$action_events" list_entity_at_current_place '{}' "$action_entity_page" 3 || return 1
    emit_pair "$action_events" list_activity_at_current_place '{}' "$action_activity_page" 4 || return 1
    if [[ "$MODE" == premature-action ]]; then
        jq -nc '{type:"item.started",item:{id:"call-5",type:"mcp_tool_call",server:"aicadia",tool:"submit_action",arguments:{},result:null,status:"in_progress",error:null}}' >>"$action_events"
    fi
    proposals="$RUN_DIR/action-proposals.final.json"
    jq -n --arg marker "$marker" --arg revision "$place_revision" '{status:"proposed",marker:$marker,place_revision:$revision,proposals:[{id:"one",direction:"Pip studies the fading echo.",grounding:"The arch returns each footfall."},{id:"two",direction:"Pip waits for the second echo before moving.",grounding:"Pip stands beneath the echoing arch."},{id:"three",direction:"Pip tests the echo beside Mara.",grounding:"Mara is present at the arch."}]}' >"$proposals"
    paired_tools_equal "$action_events" "$ACTION_READ_TOOLS" || fail 'Action proposal phase mutated early or violated its read allowlist.' || return
    manifest_set '.phases.action_proposals="passed"'

    write_prompt "$RUN_DIR/action-preview.prompt.txt" action-preview \
        "The User now selects proposal two and steers toward patient listening. Confirmation remains withheld. Preview exact prose, Pip by name, the existing characterization, establish lifecycle and proposed characterization. Expose no identifier."
    action_preview="$RUN_DIR/action-preview.final.json"
    jq -n --arg marker "$marker" --arg prose "$action_prose" --arg statement "$initial" '{status:"previewed",marker:$marker,selected_proposal_id:"two",prose:$prose,entity_name:"Pip",lifecycle:"establish",current_characterization:"A small grey rat-like traveler.",proposed_characterization:$statement}' >"$action_preview"
    : >"$RUN_DIR/action-preview.events.jsonl"
    if [[ "$MODE" == invented-mechanic ]]; then
        jq '.proposed_characterization="Grants +2 to every jump."' "$action_preview" >"$action_preview.tmp" \
            && mv "$action_preview.tmp" "$action_preview"
    fi
    if [[ "$MODE" == altered-action-prose ]]; then
        jq '.prose += " Almost."' "$action_preview" >"$action_preview.tmp" && mv "$action_preview.tmp" "$action_preview"
    fi
    jq -e --arg marker "$marker" --arg statement "$initial" --arg prose "$action_prose" '
      (keys|sort)==(["status","marker","selected_proposal_id","prose","entity_name","lifecycle","current_characterization","proposed_characterization"]|sort)
      and .status=="previewed" and .marker==$marker and .selected_proposal_id=="two"
      and .entity_name=="Pip" and .lifecycle=="establish"
      and .current_characterization=="A small grey rat-like traveler."
      and .proposed_characterization==$statement and .prose==$prose
      and (.proposed_characterization|length)>0 and (.proposed_characterization|length)<=4000
      and ([.proposed_characterization,.prose]|join(" ")|test("\\+2|bonus|modifier|permission|guaranteed success";"i")|not)
      and ((has("entity_id") or has("trait_id") or has("target_entity_id"))|not)
    ' "$action_preview" >/dev/null || fail 'Action preview was incomplete, executable or changed.' || return
    manifest_set '.phases.action_preview="passed"'

    write_prompt "$RUN_DIR/action-commit.prompt.txt" action-commit \
        'The User now explicitly accepts the exact retained Action preview. Only submit_action is available; call exactly once with unchanged content.'
    action_events="$RUN_DIR/action-commit.events.jsonl"; : >"$action_events"
    local action_arguments action_result
    action_arguments="$(jq -nc --arg revision "$place_revision" --arg prose "$action_prose" --arg entity "$pip" --arg statement "$initial" '{request_id:"77777777-7777-4777-8777-777777777777",expected_place_revision:$revision,prose:$prose,consequence:{type:"change_entity_trait",trait_change:[{type:"establish",entity_id:$entity,statement:$statement}]}}')"
    [[ "$MODE" != changed-action-preview ]] || action_arguments="$(jq '.consequence.trait_change[0].statement="Changed after confirmation."' <<<"$action_arguments")"
    action_result="$(jq -nc --arg id "$establish_activity" --arg pip "$pip" --arg place "$place" --arg trait "$trait" --arg statement "$initial" --arg prose "$action_prose" --argjson accepted_place "$place_output" '{activity:{id:$id,operation:"submit_action",actor_character:{id:$pip,name:"Pip"},context_place:{entity:{id:$place,name:"Echo Arch"},is_entry:true},involved_entity:[{entity:{id:$pip,name:"Pip"},role:"subject"},{entity:{id:$place,name:"Echo Arch"},role:"location"}],property_change:[],trait_change:[{type:"establish",entity:{id:$pip,name:"Pip"},trait:{id:$trait,statement:$statement}}],prose:$prose,occurred_at:"2026-08-13T20:00:00.234567Z"},consequence:{type:"change_entity_trait",trait_change:[{type:"establish",entity:{id:$pip,name:"Pip"},trait:{id:$trait,statement:$statement}}]},place:$accepted_place}')"
    [[ "$MODE" != malformed-action-result ]] || action_result="$(jq 'del(.place)' <<<"$action_result")"
    emit_pair "$action_events" submit_action "$action_arguments" "$action_result" 1 || return 1
    [[ "$MODE" != double-action ]] || emit_pair "$action_events" submit_action "$action_arguments" "$action_result" 2 || return 1
    action_commit="$RUN_DIR/action-commit.final.json"
    jq -n --arg marker "$marker" --arg activity "$establish_activity" --arg trait "$trait" --arg entity "$pip" --arg statement "$initial" '{status:"committed",marker:$marker,request_id:"77777777-7777-4777-8777-777777777777",activity_id:$activity,trait_id:$trait,entity_id:$entity,statement:$statement}' >"$action_commit"
    paired_tools_equal "$action_events" "$ACTION_COMMIT_TOOLS" \
        && jq -e --slurpfile preview "$action_preview" --arg entity "$pip" '
          select(.consequence.trait_change==[{type:"establish",entity_id:$entity,statement:$preview[0].proposed_characterization}])
          and .prose==$preview[0].prose
        ' <<<"$action_arguments" >/dev/null \
        && jq -e --arg trait "$trait" --arg statement "$initial" '.activity.trait_change==[{type:"establish",entity:{id:"11111111-1111-4111-8111-111111111111",name:"Pip"},trait:{id:$trait,statement:$statement}}]' <<<"$action_result" >/dev/null \
        || { fail 'Action commit was not the one unchanged confirmed Trait establishment.'; return 1; }
    manifest_set '.phases.action_commit="passed"'

    interaction_events="$RUN_DIR/interaction-proposals.events.jsonl"; : >"$interaction_events"
    write_prompt "$RUN_DIR/interaction-proposals.prompt.txt" interaction-proposals \
        'Later, ground one Interaction with read-only tools. Selection, steering and confirmation are withheld. Fetch Mara only after compact orientation selects her.'
    local established_character_result established_entity_page established_activity_page mara_state_result
    established_character_result="$(jq -nc --argjson entity "$pip_entity" --arg owner "$pip_owner" --argjson place "$place_output" --arg trait "$trait" --arg statement "$initial" '{character:{entity:$entity,owner_user_id:$owner,current_place:$place},place_revision:"v1.fake.trait.established",current_state:{association:[{type:"trait",trait:{id:$trait,statement:$statement}}],next:null}}')"
    established_entity_page="$(jq -nc --argjson place "$place_flat" --argjson entity "$mara_entity" '{place:$place,place_revision:"v1.fake.trait.established",entity:[$entity|{id,name,description}],next:null}')"
    established_activity_page="$(jq -nc --argjson place "$place_flat" --argjson activity "$action_result" '{place:$place,place_revision:"v1.fake.trait.established",activity:[$activity.activity],next:null}')"
    [[ "$MODE" != malformed-activity-page-result ]] || established_activity_page="$action_result"
    mara_state_result="$(jq -nc --argjson place "$place_flat" --argjson entity "$mara_entity" '{place:$place,place_revision:"v1.fake.trait.established",entity:($entity|{id,name,description}),current_state:{association:[],next:null}}')"
    emit_pair "$interaction_events" get_character '{}' "$established_character_result" 1 || return 1
    emit_pair "$interaction_events" list_entity_at_current_place '{}' "$established_entity_page" 2 || return 1
    emit_pair "$interaction_events" list_activity_at_current_place '{}' "$established_activity_page" 3 || return 1
    emit_pair "$interaction_events" get_entity_at_current_place "$(jq -nc --arg mara "$mara" '{entity_id:$mara}')" "$mara_state_result" 4 || return 1
    if [[ "$MODE" == premature-interaction ]]; then
        jq -nc '{type:"item.started",item:{id:"call-5",type:"mcp_tool_call",server:"aicadia",tool:"submit_interaction",arguments:{},result:null,status:"in_progress",error:null}}' >>"$interaction_events"
    fi
    jq -n --arg marker "$marker" '{status:"proposed",marker:$marker,place_revision:"v1.fake.trait.established",proposals:[{id:"one",direction:"Pip listens beside Mara.",grounding:"Mara stands under the echoing arch."},{id:"two",direction:"Pip circles Mara and waits for her second footfall.",grounding:"Pip already waits for returning sounds."},{id:"three",direction:"Pip answers Mara with a quiet pause.",grounding:"Their exact shared place supports outward interaction."}]}' >"$RUN_DIR/interaction-proposals.final.json"
    paired_tools_equal "$interaction_events" "$INTERACTION_READ_TOOLS" || fail 'Interaction proposal phase mutated early or violated its read allowlist.' || return
    manifest_set '.phases.interaction_proposals="passed"'

    write_prompt "$RUN_DIR/interaction-preview.prompt.txt" interaction-preview \
        'The User now selects proposal two and steers toward Mara’s second footfall. Confirmation remains withheld. Preview Pip and Mara by name, develop lifecycle, current/proposed characterization and outward prose. Expose no identifier.'
    interaction_preview="$RUN_DIR/interaction-preview.final.json"
    jq -n --arg marker "$marker" --arg prose "$interaction_prose" --arg previous "$initial" --arg statement "$developed" '{status:"previewed",marker:$marker,selected_proposal_id:"two",prose:$prose,actor_name:"Pip",target_name:"Mara",lifecycle:"develop",current_characterization:$previous,proposed_characterization:$statement}' >"$interaction_preview"
    : >"$RUN_DIR/interaction-preview.events.jsonl"
    if [[ "$MODE" == target-authored-interaction-prose ]]; then
        jq '.prose += " Mara applauds and agrees."' "$interaction_preview" >"$interaction_preview.tmp" && mv "$interaction_preview.tmp" "$interaction_preview"
    fi
    jq -e --arg previous "$initial" --arg statement "$developed" --arg prose "$interaction_prose" '
      .actor_name=="Pip" and .target_name=="Mara" and .lifecycle=="develop"
      and .current_characterization==$previous and .proposed_characterization==$statement
      and .selected_proposal_id=="two" and .prose==$prose
      and ((has("entity_id") or has("trait_id") or has("target_entity_id"))|not)
    ' "$interaction_preview" >/dev/null || fail 'Interaction preview lost natural Trait continuity or exposed an identifier.' || return
    manifest_set '.phases.interaction_preview="passed"'

    write_prompt "$RUN_DIR/interaction-commit.prompt.txt" interaction-commit \
        'The User now explicitly accepts the exact retained Interaction preview. Only submit_interaction is available; call exactly once and author no target response.'
    interaction_events="$RUN_DIR/interaction-commit.events.jsonl"; : >"$interaction_events"
    local interaction_arguments interaction_result interaction_trait
    interaction_trait="$trait"; [[ "$MODE" != wrong-trait-id ]] || interaction_trait='99999999-9999-4999-8999-999999999999'
    interaction_arguments="$(jq -nc --arg revision 'v1.fake.trait.established' --arg prose "$interaction_prose" --arg target "$mara" --arg trait "$interaction_trait" --arg statement "$developed" '{request_id:"88888888-8888-4888-8888-888888888888",expected_place_revision:$revision,prose:$prose,target_entity_id:[$target],property_change:[],trait_change:[{type:"develop",trait_id:$trait,statement:$statement}]}')"
    [[ "$MODE" != changed-interaction-preview ]] || interaction_arguments="$(jq '.trait_change[0].statement="Changed after confirmation."' <<<"$interaction_arguments")"
    interaction_result="$(jq -nc --arg id "$develop_activity" --arg pip "$pip" --arg mara "$mara" --arg place "$place" --arg trait "$trait" --arg previous "$initial" --arg statement "$developed" --arg prose "$interaction_prose" '{activity:{id:$id,operation:"submit_interaction",actor_character:{id:$pip,name:"Pip"},context_place:{entity:{id:$place,name:"Echo Arch"},is_entry:true},involved_entity:[{entity:{id:$mara,name:"Mara"},role:"target"},{entity:{id:$place,name:"Echo Arch"},role:"location"}],property_change:[],trait_change:[{type:"develop",entity:{id:$pip,name:"Pip"},trait:{id:$trait,statement:$statement},previous_statement:$previous}],prose:$prose,occurred_at:"2026-08-13T20:05:00.345678Z"},place:{id:$place,name:"Echo Arch",description:"A stone arch that returns each footfall."}}')"
    if [[ "$MODE" == incomplete-interaction ]]; then
        jq -nc --arg tool submit_interaction --argjson arguments "$interaction_arguments" '{type:"item.started",item:{id:"call-1",type:"mcp_tool_call",server:"aicadia",tool:$tool,arguments:$arguments,result:null,status:"in_progress",error:null}}' >>"$interaction_events"
    else
        emit_pair "$interaction_events" submit_interaction "$interaction_arguments" "$interaction_result" 1 || return 1
    fi
    interaction_commit="$RUN_DIR/interaction-commit.final.json"
    jq -n --arg marker "$marker" --arg activity "$develop_activity" --arg trait "$trait" --arg entity "$pip" --arg target "$mara" --arg previous "$initial" --arg statement "$developed" '{status:"committed",marker:$marker,request_id:"88888888-8888-4888-8888-888888888888",activity_id:$activity,trait_id:$trait,entity_id:$entity,target_entity_id:$target,previous_statement:$previous,statement:$statement}' >"$interaction_commit"
    paired_tools_equal "$interaction_events" "$INTERACTION_COMMIT_TOOLS" \
        && jq -e --slurpfile preview "$interaction_preview" --arg target "$mara" --arg trait "$trait" '.target_entity_id==[$target] and .prose==$preview[0].prose and .trait_change==[{type:"develop",trait_id:$trait,statement:$preview[0].proposed_characterization}]' <<<"$interaction_arguments" >/dev/null \
        && jq -e --arg trait "$trait" --arg previous "$initial" --arg statement "$developed" '.activity.trait_change[0].trait.id==$trait and .activity.trait_change[0].previous_statement==$previous and .activity.trait_change[0].trait.statement==$statement and ([.activity.involved_entity[].role]|sort)==["location","target"]' <<<"$interaction_result" >/dev/null \
        || { fail 'Interaction commit was not the one unchanged confirmed development without a response.'; return 1; }
    manifest_set '.phases.interaction_commit="passed"'

    observer_events="$RUN_DIR/observer.events.jsonl"; : >"$observer_events"
    write_prompt "$RUN_DIR/observer.prompt.txt" observer \
        'As Mara, use only four read tools. Compact orientation reveals Pip; only then fetch Pip. Report current Trait and the authorized Interaction history, inventing no observer state.'
    local observer_character_result observer_entity_page observer_pip_state observer_activity_page
    observer_character_result="$(jq -nc --argjson entity "$mara_entity" --arg owner "$mara_owner" --argjson place "$place_output" '{character:{entity:$entity,owner_user_id:$owner,current_place:$place},place_revision:"v1.fake.trait.developed",current_state:{association:[],next:null}}')"
    observer_entity_page="$(jq -nc --argjson place "$place_flat" --argjson entity "$pip_entity" '{place:$place,place_revision:"v1.fake.trait.developed",entity:[$entity|{id,name,description}],next:null}')"
    emit_pair "$observer_events" get_character '{}' "$observer_character_result" 1 || return 1
    emit_pair "$observer_events" list_entity_at_current_place '{}' "$observer_entity_page" 2 || return 1
    local observed_statement="$developed"; [[ "$MODE" != wrong-current-state ]] || observed_statement="$initial"
    observer_pip_state="$(jq -nc --argjson place "$place_flat" --argjson entity "$pip_entity" --arg trait "$trait" --arg statement "$observed_statement" '{place:$place,place_revision:"v1.fake.trait.developed",entity:($entity|{id,name,description}),current_state:{association:[{type:"trait",trait:{id:$trait,statement:$statement}}],next:null}}')"
    observer_activity_page="$(jq -nc --argjson place "$place_flat" --argjson activity "$interaction_result" '{place:$place,place_revision:"v1.fake.trait.developed",activity:[$activity.activity],next:null}')"
    emit_pair "$observer_events" get_entity_at_current_place "$(jq -nc --arg pip "$pip" '{entity_id:$pip}')" "$observer_pip_state" 3 || return 1
    emit_pair "$observer_events" list_activity_at_current_place '{}' "$observer_activity_page" 4 || return 1
    observer="$RUN_DIR/observer.final.json"
    jq -n --arg marker "$marker" --arg entity "$pip" --arg trait "$trait" --arg current "$observed_statement" --arg previous "$initial" --arg prose "$interaction_prose" '{status:"observed",marker:$marker,entity_id:$entity,trait_id:$trait,current_statement:$current,previous_statement:$previous,interaction_prose:$prose}' >"$observer"
    if [[ "$MODE" == invented-observer-state ]]; then
        jq '.observer_knowledge="stored"' "$observer" >"$observer.tmp" \
            && mv "$observer.tmp" "$observer"
    fi
    paired_tools_equal "$observer_events" "$OBSERVER_TOOLS" \
        && jq -s -e --arg pip "$pip" '
          [.[]|select(.type=="item.completed")|.item] as $c
          | $c[1].result.structured_content.entity[0].id==$pip
          and ($c[1].result.structured_content.entity[0]|has("current_state")|not)
          and $c[2].arguments.entity_id==$c[1].result.structured_content.entity[0].id
        ' "$observer_events" >/dev/null \
        && jq -e --arg pip "$pip" --arg trait "$trait" --arg current "$developed" --arg previous "$initial" --arg prose "$interaction_prose" '
          (keys|sort)==(["status","marker","entity_id","trait_id","current_statement","previous_statement","interaction_prose"]|sort)
          and .entity_id==$pip and .trait_id==$trait and .current_statement==$current
          and .previous_statement==$previous and .interaction_prose==$prose
        ' "$observer" >/dev/null \
        || { fail 'Observer did not derive the authoritative current Trait from Pip’s scoped fetch and Interaction history.'; return 1; }
    manifest_set '.phases.observer="passed"'

    if [[ "$MODE" == ambiguous-cleanup ]]; then
        manifest_set '.cleanup={kind:"ambiguous_external_state",status:"manual_inspection_required"} | .run_status="failed"'
        fail 'cleanup ownership was ambiguous; fake evidence remains failed.'
        return 1
    fi
    manifest_set '.validation="passed" | .cleanup.status="not_needed" | .run_status="fake_completed"'
    printf 'Trait fake controller passed without Codex, model spend, database or server. Artifacts: %s\n' "$RUN_DIR"
}

resolve_codex_bin() {
    local command_name binary
    if [[ $INTERNAL_TEST_MODE -eq 1 ]]; then
        [[ -n "${CODEX_BIN:-}" ]] || return 1
        command_name="$CODEX_BIN"
    else
        command_name='codex'
    fi
    binary="$(command -v "$command_name" 2>/dev/null)" || return 1
    /usr/bin/perl -MCwd=abs_path -e 'my $path=abs_path(shift); defined $path or exit 1; print "$path\n"' "$binary"
}

reject_public_overrides() {
    local variable
    [[ $INTERNAL_TEST_MODE -eq 0 ]] || return 0
    for variable in CODEX_BIN AICADIA_TRAIT_PLAYTEST_OUTPUT_ROOT AICADIA_INTERNAL_TRAIT_PLAYTEST_MODE \
        AICADIA_INTERNAL_TRAIT_SCHEMA_DIR AICADIA_INTERNAL_TRAIT_PREFLIGHT_MODE; do
        ! declare -p "$variable" >/dev/null 2>&1 \
            || fail "public Trait candidate forbids test or executable override: $variable" || return
    done
    while IFS= read -r variable; do
        case "$variable" in
            FAKE_*|AICADIA_INTERNAL_TRAIT_*) fail "public Trait candidate forbids fake-only environment: $variable"; return 1 ;;
        esac
    done < <(compgen -e)
}

