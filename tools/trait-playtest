validate_observer() {
    local events="$1" final="$2" marker="$3" pip="$4" trait="$5" previous="$6" current="$7" prose="$8"
    validate_event_tools "$events" "$OBSERVER_TOOLS" || return
    jq -s -e --arg pip "$pip" --arg trait "$trait" --arg previous "$previous" --arg current "$current" --arg prose "$prose" '
      [.[]|select(.type=="item.completed" and .item.type=="mcp_tool_call")|.item] as $c
      | $c[0].arguments=={}
      and ($c[1].arguments=={} or $c[1].arguments=={limit:25})
      and ($c[2].arguments|keys)==["entity_id"]
      and ($c[3].arguments=={} or $c[3].arguments=={limit:25})
      and any($c[1].result.structured_content.entity[];.id==$pip and (has("current_state")|not))
      and $c[2].arguments.entity_id==$pip and $c[2].result.structured_content.entity.id==$pip
      and any($c[2].result.structured_content.current_state.association[];.type=="trait" and .trait.id==$trait and .trait.statement==$current)
      and $c[0].result.structured_content.place_revision==$c[1].result.structured_content.place_revision
      and $c[0].result.structured_content.place_revision==$c[2].result.structured_content.place_revision
      and $c[0].result.structured_content.place_revision==$c[3].result.structured_content.place_revision
      and any($c[3].result.structured_content.activity[];
        .operation=="submit_interaction" and .prose==$prose
