    jq -n -e --argjson all "$CAPABILITIES" --argjson ar "$ACTION_READ_TOOLS" \
        --argjson ac "$ACTION_COMMIT_TOOLS" --argjson ir "$INTERACTION_READ_TOOLS" \
        --argjson ic "$INTERACTION_COMMIT_TOOLS" --argjson observer "$OBSERVER_TOOLS" '
        def subset($set): all(.[];. as $item|($set|index($item))!=null);
        ($ar|subset($all)) and ($ac|subset($all)) and ($ir|subset($all)) and ($ic|subset($all)) and ($observer|subset($all))
        and $ac==["submit_action"] and $ic==["submit_interaction"]
        and ([$ar[],$ir[],$observer[]]|map(select(test("^(submit|create|enter)")))|length)==0
        and ($observer|index("get_entity_at_current_place"))!=null
    ' >/dev/null
