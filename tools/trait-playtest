      and any($c[0].result.structured_content.current_state.association[];.type=="trait" and .trait.id==$trait and .trait.statement==$statement)
      and any($c[1].result.structured_content.entity[];.id==$mara and (has("current_state")|not))
      and $c[3].arguments.entity_id==$mara and $c[3].result.structured_content.entity.id==$mara
      and $c[0].result.structured_content.place_revision==$c[1].result.structured_content.place_revision
      and $c[0].result.structured_content.place_revision==$c[2].result.structured_content.place_revision
