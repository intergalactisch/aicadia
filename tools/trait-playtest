        --enable code_mode_host --enable mcp_2026_07_28 --config 'suppress_unstable_features_warning=true'
        --config 'features.code_mode.enabled=true'
        --config "features.code_mode.direct_only_tool_namespaces=$CODE_MODE_DIRECT_ONLY_NAMESPACES")
    for feature in "${DISABLED_CODEX_FEATURES[@]}"; do CODEX_COMMAND+=(--disable "$feature"); done
    CODEX_COMMAND+=(--config 'web_search="disabled"' --config 'tools.web_search=false'
        --config "model_reasoning_effort=\"$CODEX_REASONING_EFFORT\""
        --config "mcp_servers.aicadia.url=\"$MCP_URL\"" --config 'mcp_servers.aicadia.enabled=true'
        --config 'mcp_servers.aicadia.required=true' --config "mcp_servers.aicadia.enabled_tools=$enabled_tools"
        --config 'mcp_servers.aicadia.default_tools_approval_mode="approve"'
        --config 'mcp_servers.aicadia.env_http_headers={"Aicadia-User-Id"="AICADIA_USER_ID"}')
