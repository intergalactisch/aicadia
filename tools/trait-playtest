      and .request_id==$call.arguments.request_id and .activity_id==$call.result.structured_content.activity.id
      and .trait_id==$call.result.structured_content.activity.trait_change[0].trait.id
      and .entity_id==$call.result.structured_content.activity.trait_change[0].entity.id
      and .target_entity_id==$call.arguments.target_entity_id[0]
      and .previous_statement==$call.result.structured_content.activity.trait_change[0].previous_statement
      and .statement==$call.result.structured_content.activity.trait_change[0].trait.statement' "$final" >/dev/null
