events_are_clean() {
    [[ -s "$1" ]] || return 1
    jq -s -e 'length>0 and all(.[];type=="object")
      and ([..|objects|select(.type?=="error" or .type?=="turn.failed" or .type?=="turn.aborted" or .status?=="failed" or .error?!=null)]|length)==0
      and all(.[]|select(.item?!=null);.item.type as $type|["agent_message","reasoning","plan","context_compaction","mcp_tool_call"]|index($type)!=null)' "$1" >/dev/null
}

session_id_from_events() {
    jq -er '[.thread_id? // .session_id? // .thread?.id? // empty
        | select(type=="string" and test("^[0-9a-fA-F-]{36}$"))]|unique|select(length==1)|.[0]' "$1"
}

validate_event_tools() {
    local events="$1" expected="$2"
    events_are_clean "$events" || return
    jq -s -e --argjson expected "$expected" '
      [.[]|select(.item?.type=="mcp_tool_call")|{event:.type,item:.item}] as $all
      | [$all[]|select(.event=="item.started")|.item] as $s
      | [$all[]|select(.event=="item.completed")|.item] as $c
      | [$s[].tool]==$expected and [$c[].tool]==$expected and [$s[].id]==[$c[].id]
      and [$s[].arguments]==[$c[].arguments]
      and all($s[];.server=="aicadia" and .status=="in_progress" and .result==null and .error==null)
      and all($c[];.server=="aicadia" and .status=="completed" and .error==null and (.result.structured_content|type)=="object")
    ' "$events" >/dev/null || return
    while IFS=$'\t' read -r tool result; do
        validate_tool_output "$tool" "$result" || return 1
    done < <(jq -sr '.[]|select(.type=="item.completed" and .item.type=="mcp_tool_call")|[.item.tool,(.item.result.structured_content|tojson)]|@tsv' "$events")
}

validate_zero_tool_phase() {
    events_are_clean "$1" && jq -s -e '[.[]|select(.item?.type=="mcp_tool_call")]|length==0' "$1" >/dev/null
}

single_completed_call() { jq -sc '[.[]|select(.type=="item.completed" and .item.type=="mcp_tool_call")|.item][0]' "$1"; }

validate_action_proposal() {
    local events="$1" final="$2" marker="$3"
    validate_event_tools "$events" "$ACTION_READ_TOOLS" || return
    jq -s -e '
      [.[]|select(.type=="item.completed" and .item.type=="mcp_tool_call")|.item] as $c
      | $c[0].arguments=={} and $c[1].arguments=={}
      and ($c[2].arguments=={} or $c[2].arguments=={limit:25})
      and ($c[3].arguments=={} or $c[3].arguments=={limit:25})
      and $c[1].result.structured_content.current_state.association==[]
      and $c[2].result.structured_content.place_revision==$c[3].result.structured_content.place_revision
      and $c[1].result.structured_content.place_revision==$c[2].result.structured_content.place_revision
    ' "$events" >/dev/null || return
    local revision
    revision="$(jq -sr '[.[]|select(.type=="item.completed" and .item.type=="mcp_tool_call")|.item][1].result.structured_content.place_revision' "$events")"
    jq -e --arg marker "$marker" --arg revision "$revision" '
      .status=="proposed" and .marker==$marker and .place_revision==$revision
      and [.proposals[].id]==["one","two","three"] and (.proposals|length)==3
      and ([.proposals[].direction]|unique|length)==3 and all(.proposals[];(.direction|length)>0 and (.grounding|length)>0)
    ' "$final" >/dev/null
}

validate_action_preview() {
