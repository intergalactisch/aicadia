validate_codex_role_config() {
    local codex_bin="$1" enabled_tools="$2" parse_home parsed features status feature
    local -a command
    parse_home="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-trait-codex-parse-XXXXXXXX")" || return 1
    command=("$codex_bin" --enable code_mode_host --enable mcp_2026_07_28 --config 'suppress_unstable_features_warning=true'
        --config 'features.code_mode.enabled=true'
        --config "features.code_mode.direct_only_tool_namespaces=$CODE_MODE_DIRECT_ONLY_NAMESPACES"
        --config 'web_search="disabled"' --config 'tools.web_search=false'
        --config "model_reasoning_effort=\"$CODEX_REASONING_EFFORT\""
        --config 'mcp_servers.aicadia.url="http://127.0.0.1:9/mcp"'
        --config 'mcp_servers.aicadia.enabled=true' --config 'mcp_servers.aicadia.required=true'
        --config "mcp_servers.aicadia.enabled_tools=$enabled_tools"
        --config 'mcp_servers.aicadia.default_tools_approval_mode="approve"'
        --config 'mcp_servers.aicadia.env_http_headers={"Aicadia-User-Id"="AICADIA_USER_ID"}')
    for feature in "${DISABLED_CODEX_FEATURES[@]}"; do command+=(--disable "$feature"); done
    parsed="$(CODEX_HOME="$parse_home" "${command[@]}" mcp get aicadia --json)"; status=$?
    features="$(CODEX_HOME="$parse_home" "${command[@]}" features list)" || status=$?
    rm -rf "$parse_home"
    [[ $status -eq 0 ]] || fail 'Codex rejected the frozen Trait role configuration.' || return
    for feature in code_mode code_mode_host mcp_2026_07_28; do
        awk -v expected="$feature" '$1==expected && $NF=="true"{found=1}END{exit !found}' <<<"$features" \
            || fail "Codex parsed required direct MCP plumbing as disabled: $feature" || return
    done
    for feature in "${DISABLED_CODEX_FEATURES[@]}"; do
        awk -v expected="$feature" '$1==expected && $2!="removed" && $NF=="false"{found=1}END{exit !found}' <<<"$features" \
            || fail "Codex did not parse forbidden feature as disabled: $feature" || return
    done
    jq -e --argjson expected "$enabled_tools" '.name=="aicadia" and .enabled==true
        and .transport.type=="streamable_http" and .transport.url=="http://127.0.0.1:9/mcp"
        and .transport.env_http_headers=={"Aicadia-User-Id":"AICADIA_USER_ID"}
        and .enabled_tools==$expected and .disabled_tools==null' <<<"$parsed" >/dev/null \
        || fail 'Codex parsed an unexpected direct-only Aicadia MCP role.' || return
}

validate_codex() {
    local codex_bin="$1" version login models features exec_help resume_help global_help feature flag
    version="$("$codex_bin" --version)" || fail 'could not read Codex version.' || return
    [[ "$version" == "$CODEX_VERSION" ]] || fail "Codex must be exactly $CODEX_VERSION; found $version." || return
    login="$("$codex_bin" login status 2>&1)" || fail 'Codex login is unavailable.' || return
    [[ "$login" == Logged\ in\ using\ * ]] || fail 'Codex must be logged in.' || return
    models="$("$codex_bin" debug models)" || fail 'Codex model catalog is unavailable.' || return
    jq -e --arg model "$CODEX_MODEL" --arg effort "$CODEX_REASONING_EFFORT" '
        [.models[]|select(.slug==$model)] as $entry | ($entry|length)==1
        and any($entry[0].supported_reasoning_levels[];.effort==$effort)' <<<"$models" >/dev/null \
        || fail "$CODEX_MODEL/$CODEX_REASONING_EFFORT is unavailable." || return
    features="$("$codex_bin" features list)" || return
    for feature in "${DISABLED_CODEX_FEATURES[@]}" code_mode code_mode_host mcp_2026_07_28; do
        awk -v expected="$feature" '$1==expected && $2!="removed"{found=1}END{exit !found}' <<<"$features" \
            || fail "Codex feature control drifted: $feature" || return
    done
    exec_help="$("$codex_bin" exec --help)" || return
    resume_help="$("$codex_bin" exec resume --help)" || return
    global_help="$("$codex_bin" --help)" || return
    for flag in --ignore-user-config --ignore-rules --strict-config --skip-git-repo-check --json --output-schema --output-last-message; do
        grep -F -- "$flag" <<<"$exec_help" >/dev/null || fail "Codex exec flag absent: $flag" || return
        grep -F -- "$flag" <<<"$resume_help" >/dev/null || fail "Codex resume flag absent: $flag" || return
    done
    for flag in --ask-for-approval --sandbox --model; do
        grep -F -- "$flag" <<<"$global_help" >/dev/null || fail "Codex global flag absent: $flag" || return
    done
    grep -F '[SESSION_ID]' <<<"$resume_help" >/dev/null || fail 'explicit-session resume is unavailable.' || return
    INSPECTED_CODEX_BIN="$codex_bin"; INSPECTED_CODEX_VERSION="$version"
    validate_codex_role_config "$codex_bin" "$ACTION_READ_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$ACTION_COMMIT_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$INTERACTION_READ_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$INTERACTION_COMMIT_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$OBSERVER_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$ZERO_TOOL_TOOLS" || return
}

curl_json() { curl --disable --fail --silent --show-error --connect-timeout 2 --max-time 10 "$@"; }

stop_server() {
    if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
        kill -TERM -- "-$SERVER_PID" 2>/dev/null || kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    SERVER_PID=''
}

start_owned_server() {
    local ready address attempt create_result expected
    if ! create_result="$(database_helper create "$DATABASE_NAME" "$OWNERSHIP_TOKEN" 2>"$RUN_DIR/database-create.log")"; then
        manifest_set '.deployment.status="create_ambiguous_unowned" | .cleanup.status="manual_inspection_required"' || true
        fail 'owned database create/tag/verify failed; automatic cleanup is forbidden until ownership is known.'
        return 1
    fi
    expected="ownership_verified $DATABASE_NAME $OWNERSHIP_TOKEN"
    if [[ "$create_result" != "$expected" ]]; then
        manifest_set '.deployment.status="create_ambiguous_unowned" | .cleanup.status="manual_inspection_required"' || true
        fail 'database helper returned ambiguous ownership proof.'
        return 1
    fi
    printf '%s\n' "$create_result" >"$RUN_DIR/database-create.stdout.log"
    chmod 600 "$RUN_DIR/database-create.log" "$RUN_DIR/database-create.stdout.log"
    CLEANUP_REQUIRED=1
    manifest_set '.deployment.status="ownership_verified" | .cleanup.status="armed"' || return
    /usr/bin/perl -e 'chdir shift or exit 125; setpgrp 0,0; exec @ARGV' "$REPO_DIR" \
        "$SYSTEM_ENV" DATABASE_URL="$DATABASE_URL" AICADIA_DATABASE_NAME="$DATABASE_NAME" AICADIA_PORT=0 \
        cargo run --quiet --bin aicadia >"$RUN_DIR/server.stdout.log" 2>"$RUN_DIR/server.stderr.log" &
    SERVER_PID=$!
    for attempt in $(seq 1 200); do
        kill -0 "$SERVER_PID" 2>/dev/null || { fail 'disposable server exited before readiness.'; return 1; }
        ready="$(jq -c 'select(.event=="server_ready" and (.address|type)=="string")' "$RUN_DIR/server.stdout.log" 2>/dev/null | tail -1)"
        [[ -z "$ready" ]] || break
        sleep 0.1
    done
    [[ -n "${ready:-}" ]] || fail 'server was not ready within 20 seconds.' || return
    address="$(jq -r '.address' <<<"$ready")"
    [[ "$address" =~ ^127\.0\.0\.1:[0-9]+$ ]] || fail 'server address is not loopback.' || return
    BASE_URL="http://$address"; MCP_URL="$BASE_URL/mcp"
    manifest_set '.deployment.server_address=$address | .deployment.status="ready"' --arg address "$address"
}

cleanup_owned_database() {
    local output recovery
    stop_server
    if [[ $CLEANUP_REQUIRED -eq 1 ]]; then
        output="$(database_helper verify "$DATABASE_NAME" "$OWNERSHIP_TOKEN")" \
            || { manifest_set '.cleanup.status="manual_inspection_required"'; return 1; }
        [[ "$output" == "ownership_verified $DATABASE_NAME $OWNERSHIP_TOKEN" ]] || return 1
        database_helper drop "$DATABASE_NAME" "$OWNERSHIP_TOKEN" >"$RUN_DIR/database-drop.log" 2>&1 \
            || { recovery="DATABASE_URL=<admin-url> cargo run --quiet --bin aicadia-playtest-database -- drop $DATABASE_NAME $OWNERSHIP_TOKEN";
                 manifest_set '.cleanup.status="failed" | .cleanup.recovery=$recovery' --arg recovery "$recovery"; return 1; }
        chmod 600 "$RUN_DIR/database-drop.log"
        CLEANUP_REQUIRED=0
        manifest_set '.deployment.status="dropped" | .deployment.server_address=null
            | .cleanup.status="ownership_verified_and_dropped" | .cleanup.recovery=null'
    else
        [[ "$(jq -r '.cleanup.status' "$MANIFEST")" == manual_inspection_required ]] \
            || manifest_set '.cleanup.status="not_needed"'
    fi
}

verify_runtime_catalog() {
    local openapi listed
    openapi="$(curl_json "$BASE_URL/api/openapi.json")" || return
    jq -e --argjson expected "$CAPABILITIES" '([.paths[][]|.operationId]|sort)==($expected|sort)
        and ([.paths[][]|.operationId]|length)==13' <<<"$openapi" >/dev/null || return
    listed="$(curl_json -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
        -H 'MCP-Protocol-Version: 2026-07-28' -H 'Mcp-Method: tools/list' -H "Origin: $BASE_URL" \
        --data '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientInfo":{"name":"aicadia-trait-preflight","version":"0.1.0"},"io.modelcontextprotocol/clientCapabilities":{}}}}' "$MCP_URL")" || return
    jq -e --slurpfile expected "$TOOL_CATALOG" '.result.tools==$expected[0]' <<<"$listed" >/dev/null
}

preflight_exit_cleanup() {
    local original_status="$1" cleanup_status=0
    trap - EXIT INT TERM HUP
    if [[ $CLEANUP_REQUIRED -eq 1 ]]; then cleanup_owned_database || cleanup_status=1; else stop_server; fi
    if [[ -n "$MANIFEST" && -f "$MANIFEST" && $original_status -ne 0 ]]; then
        manifest_set '.run_status="preflight_no_go" | .go=false' || true
    fi
    [[ $cleanup_status -eq 0 ]] || original_status=1
    exit "$original_status"
}

