cleanup_local_directories() {
    [[ -z "$ISOLATED_PIP" ]] || rmdir "$ISOLATED_PIP" 2>/dev/null || true
    [[ -z "$ISOLATED_MARA" ]] || rmdir "$ISOLATED_MARA" 2>/dev/null || true
    ISOLATED_PIP=''; ISOLATED_MARA=''
}

cleanup_all() {
    local status=0
    [[ $CLEANUP_DONE -eq 0 ]] || return 0
    CLEANUP_DONE=1
    stop_agent_watchdog
    [[ -z "$AGENT_PID" ]] || { terminate_agent_group "$AGENT_PID"; wait "$AGENT_PID" 2>/dev/null || true; AGENT_PID=''; }
    cleanup_owned_database || status=1
    cleanup_local_directories
    return "$status"
}

on_exit() {
    local status="$1"
    trap - EXIT INT TERM HUP
    cleanup_all || status=1
    if [[ $status -ne 0 && -n "$MANIFEST" && -f "$MANIFEST" ]]; then
        manifest_set 'if .run_status=="interrupted" then . else .run_status="failed" end' || true
    fi
    exit "$status"
}

on_signal() {
    local signal="$1" status="$2"
    [[ -z "$MANIFEST" ]] || manifest_set '.run_status="interrupted" | .interrupted_by=$signal' --arg signal "$signal" || true
    on_exit "$status"
}

prepare_live_evidence_files() {
    local phase file
    for phase in action-propose action-preview action-commit interaction-propose interaction-preview interaction-commit mara-fetch; do
        for file in "$phase.events.jsonl" "$phase.stderr.log" "$phase.final.json" "$phase.exit-status"; do
            : >"$RUN_DIR/$file" || return
            chmod 600 "$RUN_DIR/$file" || return
        done
    done
}

run_live_candidate() {
    local authorized_digest="$1" codex_bin marker pip_user_json mara_user_json pip_user mara_user pip mara place session revision
    local initial developed action_prose action_activity trait interaction_activity interaction_prose exit_status actual_usage
    validate_candidate_freeze "$authorized_digest" || return 1
    preflight || return 1
    codex_bin="$INSPECTED_CODEX_BIN"
    [[ -x "$codex_bin" ]] || fail 'the Codex executable inspected by preflight is no longer executable.' || return
    prepare_candidate_artifacts || return 1
    trap 'on_exit $?' EXIT
    trap 'on_signal INT 130' INT
    trap 'on_signal TERM 143' TERM
    trap 'on_signal HUP 129' HUP
    marker="aicadia-trait-live-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
    initial="$(initial_statement_for_marker "$marker")"
    developed="$(developed_statement_for_marker "$marker")"
    action_prose="$(action_prose_for_marker "$marker")"
    interaction_prose="$(interaction_prose_for_marker "$marker")"
    printf '%s\n' "$marker" >"$RUN_DIR/marker.txt"; chmod 600 "$RUN_DIR/marker.txt"
    write_live_prompts "$marker" || return
    start_owned_server || return
    verify_runtime_catalog || fail 'candidate runtime catalog drifted after preflight.' || return
    pip_user_json="$(provision_user)" || return; mara_user_json="$(provision_user)" || return
    pip_user="$(jq -er '.id|select(type=="string")' <<<"$pip_user_json")" || return
    mara_user="$(jq -er '.id|select(type=="string")' <<<"$mara_user_json")" || return
    [[ "$pip_user" != "$mara_user" ]] || return
    printf '%s\n' "$pip_user_json" >"$RUN_DIR/user-pip.json"; printf '%s\n' "$mara_user_json" >"$RUN_DIR/user-mara.json"
    chmod 600 "$RUN_DIR/user-pip.json" "$RUN_DIR/user-mara.json"
    manifest_set '.provisioning={pip_user:$pip,mara_user:$mara}' --arg pip "$pip_user" --arg mara "$mara_user" || return
    setup_world "$marker" "$pip_user" "$mara_user" || return
    pip="$(jq -r '.setup.pip_entity_id' "$MANIFEST")"; mara="$(jq -r '.setup.mara_entity_id' "$MANIFEST")"; place="$(jq -r '.setup.place_id' "$MANIFEST")"
    prepare_live_evidence_files || return

    run_new_resumable_agent "$codex_bin" "$ISOLATED_PIP" "$pip_user" "$ACTION_READ_TOOLS" "$SCHEMA_DIR/proposals.json" \
        "$RUN_DIR/action-propose.prompt.txt" "$RUN_DIR/action-propose.events.jsonl" "$RUN_DIR/action-propose.stderr.log" "$RUN_DIR/action-propose.final.json"; exit_status=$?
    printf '%s\n' "$exit_status" >"$RUN_DIR/action-propose.exit-status"
    [[ $exit_status -eq 0 ]] || fail 'Action proposal call failed; no retry is authorized.' || return
    validate_action_proposal "$RUN_DIR/action-propose.events.jsonl" "$RUN_DIR/action-propose.final.json" "$marker" \
        || fail 'Action proposal evidence failed.' || return
    session="$(session_id_from_events "$RUN_DIR/action-propose.events.jsonl")" || fail 'Pip session id is not uniquely resumable.' || return
    revision="$(jq -r '.place_revision' "$RUN_DIR/action-propose.final.json")"
    manifest_set '.phases.action_propose={status:"passed",session_id:$session}' --arg session "$session" || return

    run_resume_agent "$codex_bin" "$ISOLATED_PIP" "$pip_user" "$session" "$ZERO_TOOL_TOOLS" "$SCHEMA_DIR/establish-preview.json" \
        "$RUN_DIR/action-preview.prompt.txt" "$RUN_DIR/action-preview.events.jsonl" "$RUN_DIR/action-preview.stderr.log" "$RUN_DIR/action-preview.final.json"; exit_status=$?
    printf '%s\n' "$exit_status" >"$RUN_DIR/action-preview.exit-status"
    [[ $exit_status -eq 0 ]] && validate_action_preview "$RUN_DIR/action-preview.events.jsonl" "$RUN_DIR/action-preview.final.json" "$marker" "$initial" "$action_prose" \
        || { fail 'Action preview call failed or changed the frozen preview; no retry is authorized.'; return 1; }
    manifest_set '.phases.action_preview="passed"' || return

    run_resume_agent "$codex_bin" "$ISOLATED_PIP" "$pip_user" "$session" "$ACTION_COMMIT_TOOLS" "$SCHEMA_DIR/establish-commit.json" \
        "$RUN_DIR/action-commit.prompt.txt" "$RUN_DIR/action-commit.events.jsonl" "$RUN_DIR/action-commit.stderr.log" "$RUN_DIR/action-commit.final.json"; exit_status=$?
    printf '%s\n' "$exit_status" >"$RUN_DIR/action-commit.exit-status"
    [[ $exit_status -eq 0 ]] && validate_action_commit "$RUN_DIR/action-commit.events.jsonl" "$RUN_DIR/action-commit.final.json" \
        "$RUN_DIR/action-preview.final.json" "$marker" "$revision" "$pip" \
        || { fail 'Action commit call failed or was not the one confirmed establishment; no retry is authorized.'; return 1; }
    trait="$(jq -r '.trait_id' "$RUN_DIR/action-commit.final.json")"; action_activity="$(jq -r '.activity_id' "$RUN_DIR/action-commit.final.json")"
    manifest_set '.phases.action_commit={status:"passed",trait_id:$trait,activity_id:$activity}' --arg trait "$trait" --arg activity "$action_activity" || return
    validate_establish_http_gate "$pip_user" "$pip" "$place" "$trait" "$initial" "$action_prose" "$action_activity" \
        || fail 'authoritative HTTP establishment gate disagreed.' || return
    manifest_set '.phases.http_establish_gate="passed"' || return

    run_resume_agent "$codex_bin" "$ISOLATED_PIP" "$pip_user" "$session" "$INTERACTION_READ_TOOLS" "$SCHEMA_DIR/proposals.json" \
        "$RUN_DIR/interaction-propose.prompt.txt" "$RUN_DIR/interaction-propose.events.jsonl" "$RUN_DIR/interaction-propose.stderr.log" "$RUN_DIR/interaction-propose.final.json"; exit_status=$?
    printf '%s\n' "$exit_status" >"$RUN_DIR/interaction-propose.exit-status"
    [[ $exit_status -eq 0 ]] && validate_interaction_proposal "$RUN_DIR/interaction-propose.events.jsonl" "$RUN_DIR/interaction-propose.final.json" \
        "$marker" "$pip" "$mara" "$trait" "$initial" \
        || { fail 'Interaction proposal call failed or lost stable Trait grounding; no retry is authorized.'; return 1; }
    revision="$(jq -r '.place_revision' "$RUN_DIR/interaction-propose.final.json")"
    manifest_set '.phases.interaction_propose="passed"' || return

    run_resume_agent "$codex_bin" "$ISOLATED_PIP" "$pip_user" "$session" "$ZERO_TOOL_TOOLS" "$SCHEMA_DIR/develop-preview.json" \
        "$RUN_DIR/interaction-preview.prompt.txt" "$RUN_DIR/interaction-preview.events.jsonl" "$RUN_DIR/interaction-preview.stderr.log" "$RUN_DIR/interaction-preview.final.json"; exit_status=$?
    printf '%s\n' "$exit_status" >"$RUN_DIR/interaction-preview.exit-status"
    [[ $exit_status -eq 0 ]] && validate_interaction_preview "$RUN_DIR/interaction-preview.events.jsonl" "$RUN_DIR/interaction-preview.final.json" "$marker" "$initial" "$developed" "$interaction_prose" \
        || { fail 'Interaction preview call failed or changed continuity; no retry is authorized.'; return 1; }
    manifest_set '.phases.interaction_preview="passed"' || return

    run_resume_agent "$codex_bin" "$ISOLATED_PIP" "$pip_user" "$session" "$INTERACTION_COMMIT_TOOLS" "$SCHEMA_DIR/develop-commit.json" \
        "$RUN_DIR/interaction-commit.prompt.txt" "$RUN_DIR/interaction-commit.events.jsonl" "$RUN_DIR/interaction-commit.stderr.log" "$RUN_DIR/interaction-commit.final.json"; exit_status=$?
    printf '%s\n' "$exit_status" >"$RUN_DIR/interaction-commit.exit-status"
    [[ $exit_status -eq 0 ]] && validate_interaction_commit "$RUN_DIR/interaction-commit.events.jsonl" "$RUN_DIR/interaction-commit.final.json" \
        "$RUN_DIR/interaction-preview.final.json" "$marker" "$revision" "$pip" "$mara" "$trait" \
        || { fail 'Interaction commit call failed or changed the stable Trait; no retry is authorized.'; return 1; }
    interaction_activity="$(jq -r '.activity_id' "$RUN_DIR/interaction-commit.final.json")"
    manifest_set '.phases.interaction_commit={status:"passed",trait_id:$trait,activity_id:$activity}' --arg trait "$trait" --arg activity "$interaction_activity" || return
    validate_develop_http_gate "$pip_user" "$mara_user" "$pip" "$mara" "$place" "$trait" "$initial" "$developed" "$interaction_prose" "$interaction_activity" \
        || fail 'authoritative HTTP development gate disagreed or implied a Mara response.' || return
    manifest_set '.phases.http_develop_gate="passed"' || return

    run_new_agent "$codex_bin" "$ISOLATED_MARA" "$mara_user" "$OBSERVER_TOOLS" "$SCHEMA_DIR/observer.json" \
        "$RUN_DIR/mara-fetch.prompt.txt" "$RUN_DIR/mara-fetch.events.jsonl" "$RUN_DIR/mara-fetch.stderr.log" "$RUN_DIR/mara-fetch.final.json"; exit_status=$?
    printf '%s\n' "$exit_status" >"$RUN_DIR/mara-fetch.exit-status"
    [[ $exit_status -eq 0 ]] && validate_observer "$RUN_DIR/mara-fetch.events.jsonl" "$RUN_DIR/mara-fetch.final.json" \
        "$marker" "$pip" "$trait" "$initial" "$developed" "$interaction_prose" \
        || { fail 'Mara fetch call failed or used out-of-band knowledge; no retry is authorized.'; return 1; }
    manifest_set '.phases.mara_fetch="passed"' || return

    [[ "$(jq -r '.model_calls' "$MANIFEST")" == "$MAX_MODEL_CALLS" ]] || fail 'candidate did not consume exactly seven frozen calls.' || return
    actual_usage="$(jq -s '[..|objects|.usage? // empty]|if length==0 then null else . end' "$RUN_DIR"/*.events.jsonl)"
    manifest_set '.actual_usage_events=$usage | .validation="passed"' --argjson usage "$actual_usage" || return
    cleanup_owned_database || return
    find "$RUN_DIR" -type f -exec chmod 600 {} +
    [[ -z "$(find "$RUN_DIR" -type f ! -perm 600 -print -quit)" ]] || return
    manifest_set '.run_status="completed"' || return
    cleanup_local_directories; CLEANUP_DONE=1
    printf 'Trait live candidate passed exactly seven calls with zero retries; evidence: %s\n' "$RUN_DIR"
}

candidate_material() {
    local name file
    printf '%s\n' 'aicadia-trait-live-candidate-material-v1'
    printf '%s\n' 'CANDIDATE_DIGEST_PATH tools/trait-playtest-schema/live-candidate.sha256'
    for name in CAPABILITIES ACTION_READ_TOOLS ACTION_COMMIT_TOOLS INTERACTION_READ_TOOLS \
        INTERACTION_COMMIT_TOOLS OBSERVER_TOOLS ZERO_TOOL_TOOLS CODEX_VERSION \
        CODEX_MODEL CODEX_REASONING_EFFORT CODE_MODE_DIRECT_ONLY_NAMESPACES \
        SYSTEM_ENV DEFAULT_AGENT_TIMEOUT_SECONDS MAX_MODEL_CALLS MAX_RETRIES TOKEN_BOUNDARY; do
        declare -p "$name"
    done
    declare -p DISABLED_CODEX_FEATURES
    for name in fail initial_statement_for_marker developed_statement_for_marker action_prose_for_marker \
        interaction_prose_for_marker manifest_set validate_schema_policy validate_token_free_contract validate_tool_output resolve_codex_bin \
        reject_public_overrides new_ownership_token database_helper \
        validate_output_schemas validate_allowlists validate_codex_role_config validate_codex curl_json \
        stop_server start_owned_server cleanup_owned_database verify_runtime_catalog preflight_exit_cleanup prepare_preflight_artifacts \
        preflight http_request agent_timeout_seconds prepare_candidate_artifacts provision_user setup_world \
        write_live_prompts build_common_codex_command build_sanitized_env stop_agent_watchdog \
        terminate_agent_group run_codex_process run_new_agent run_new_resumable_agent run_resume_agent \
        events_are_clean session_id_from_events validate_event_tools validate_zero_tool_phase single_completed_call \
        validate_action_proposal validate_action_preview validate_action_commit validate_establish_http_gate \
        validate_interaction_proposal validate_interaction_preview validate_interaction_commit \
        validate_develop_http_gate validate_observer cleanup_local_directories cleanup_all on_exit on_signal \
        prepare_live_evidence_files run_live_candidate candidate_material candidate_digest validate_candidate_freeze main; do
        printf 'FUNCTION %s\n' "$name"
        declare -f "$name"
    done
    for file in "$REPO_DIR/Cargo.toml" "$REPO_DIR/Cargo.lock" \
        "$TOOL_CATALOG" "$DEFAULT_SCHEMA_DIR/proposals.json" \
        "$DEFAULT_SCHEMA_DIR/establish-preview.json" "$DEFAULT_SCHEMA_DIR/establish-commit.json" \
        "$DEFAULT_SCHEMA_DIR/develop-preview.json" "$DEFAULT_SCHEMA_DIR/develop-commit.json" \
        "$DEFAULT_SCHEMA_DIR/observer.json"; do
        printf 'FILE %s\n' "${file#"$REPO_DIR/"}"
        while IFS= read -r line || [[ -n "$line" ]]; do printf '%s\n' "$line"; done <"$file"
    done
    while IFS= read -r file; do
        printf 'FILE %s\n' "${file#"$REPO_DIR/"}"
        while IFS= read -r line || [[ -n "$line" ]]; do printf '%s\n' "$line"; done <"$file"
    done < <(
        find "$REPO_DIR/migration" "$REPO_DIR/src" -type f \
            \( -name '*.sql' -o -name '*.rs' -o \
                \( \( -name '*.md' -o -name '*.txt' \) -path "$REPO_DIR/src/*" \) \
            \) -print | LC_ALL=C sort
    )
    if [[ $INTERNAL_TEST_MODE -eq 1 && -n "${AICADIA_INTERNAL_TRAIT_CANDIDATE_DRIFT:-}" ]]; then
        printf 'INJECTED_DRIFT %s\n' "$AICADIA_INTERNAL_TRAIT_CANDIDATE_DRIFT"
    fi
}

candidate_digest() { candidate_material | shasum -a 256 | awk '{print $1}'; }

validate_candidate_freeze() {
    local provided="${1:-}" expected computed lines
    [[ "$CANDIDATE_DIGEST_FILE" == "$DEFAULT_SCHEMA_DIR/live-candidate.sha256" ]] \
        || fail 'audited Trait candidate digest path drifted.' || return
    [[ -f "$CANDIDATE_DIGEST_FILE" ]] || fail 'audited Trait candidate digest file is missing.' || return
    lines="$(wc -l <"$CANDIDATE_DIGEST_FILE" | tr -d ' ')"
    expected="$(tr -d '\n' <"$CANDIDATE_DIGEST_FILE")"
    [[ "$lines" == 1 && "$expected" =~ ^[0-9a-f]{64}$ ]] || fail 'audited Trait candidate digest file is malformed.' || return
    computed="$(candidate_digest)" || fail 'could not compute the canonical Trait candidate digest.' || return
    [[ "$computed" == "$expected" ]] \
        || fail "Trait candidate drift: audited digest $expected, computed $computed." || return
    [[ -z "$provided" || "$provided" == "$expected" ]] \
        || fail "authorization names Trait candidate digest $provided, expected $expected." || return
    INSPECTED_CANDIDATE_DIGEST="$expected"
}

main() {
    case "$#:${1-}" in
        1:preflight) preflight ;;
        4:run)
            [[ "$2" == --confirm-token-spend && "$3" == --candidate-digest && "$4" =~ ^[0-9a-f]{64}$ ]] \
                || { fail 'usage: tools/trait-playtest run --confirm-token-spend --candidate-digest <audited-sha256>'; return 1; }
            run_live_candidate "$4"
            ;;
        2:test-internal-preflight)
            [[ "$2" == --confirm-fake-controller-test ]] || return 1
            validate_token_free_contract
            ;;
        2:test-internal-candidate-digest)
            [[ "$2" == --confirm-fake-controller-test ]] || return 1
            INTERNAL_TEST_MODE=1
            candidate_digest
            ;;
        2:test-internal-live-preflight)
            [[ "$2" == --confirm-fake-controller-test ]] || return 1
            INTERNAL_TEST_MODE=1
            preflight
            ;;
        2:test-internal-run)
            [[ "$2" == --confirm-fake-controller-test ]] || return 1
            run_fake
            ;;
        *) fail 'usage: tools/trait-playtest preflight | tools/trait-playtest run --confirm-token-spend --candidate-digest <audited-sha256>' ;;
    esac
}

main "$@"
