find_fixture_entity_id() {
    local entity_name="$1" page
    page="$(curl_json "$BASE_URL/api/entity?limit=100")" || return 1
    jq -e 'type == "object" and (.entity | type == "array")
        and all(.entity[]; (.id | type == "string") and (.name | type == "string"))
        and has("next") and ((.next == null) or ((.next | type == "string") and (.next | length > 0)))' <<<"$page" >/dev/null || return 1
    jq -er --arg name "$entity_name" '
        [.entity[] | select(.name == $name) | .id]
        | select(length == 1) | .[0]
    ' <<<"$page"
}

stop_server() {
    if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
        kill -TERM -- "-$SERVER_PID" 2>/dev/null || kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    SERVER_PID=''
}

stop_agent_watchdog() {
    if [[ -n "$AGENT_WATCHDOG_PID" ]]; then
        if kill -0 "$AGENT_WATCHDOG_PID" 2>/dev/null; then
            kill -TERM "$AGENT_WATCHDOG_PID" 2>/dev/null || true
        fi
        wait "$AGENT_WATCHDOG_PID" 2>/dev/null || true
    fi
    AGENT_WATCHDOG_PID=''
}

terminate_agent_group() {
    local pgid="$1"
    [[ -n "$pgid" ]] || return 0
    kill -TERM -- "-$pgid" 2>/dev/null || true
    sleep 0.1
    kill -KILL -- "-$pgid" 2>/dev/null || true
}

stop_agent() {
    local agent_pgid="$AGENT_PID"
    stop_agent_watchdog
    terminate_agent_group "$agent_pgid"
    if [[ -n "$AGENT_PID" ]]; then
        wait "$AGENT_PID" 2>/dev/null || true
    fi
    AGENT_PID=''
}

cleanup_deployment() {
    local recovery
    stop_server
    if [[ $CLEANUP_REQUIRED -eq 1 ]]; then
        if database_helper drop "$DATABASE_NAME" >"$RUN_DIR/database-drop.log" 2>&1; then
            CLEANUP_REQUIRED=0
            manifest_set '.cleanup.status = "dropped" | .cleanup.recovery = null' || true
        else
            recovery="DATABASE_URL=<PostgreSQL administration URL> cargo run --quiet --bin aicadia-playtest-database -- drop $DATABASE_NAME"
            manifest_set '.cleanup.status = "failed" | .cleanup.recovery = $recovery' --arg recovery "$recovery" || true
            fail "could not drop disposable database $DATABASE_NAME; recovery is recorded in $MANIFEST"
            return 1
        fi
    elif [[ -n "$MANIFEST" ]]; then
        manifest_set '.cleanup.status = "not_needed"' || true
    fi
}

cleanup_local_directories() {
    [[ -z "$ISOLATED_A" ]] || rmdir "$ISOLATED_A" 2>/dev/null || true
    [[ -z "$ISOLATED_B" ]] || rmdir "$ISOLATED_B" 2>/dev/null || true
    ISOLATED_A=''
    ISOLATED_B=''
}

cleanup_all() {
    local status=0
    [[ $CLEANUP_DONE -eq 0 ]] || return 0
    CLEANUP_DONE=1
    stop_agent
    if [[ $CLEANUP_REQUIRED -eq 1 ]]; then
        cleanup_deployment || status=1
    else
        stop_server
    fi
    cleanup_local_directories
    return "$status"
}

on_exit() {
    local status="$1"
    trap - EXIT INT TERM HUP
    cleanup_all || status=1
    if [[ $status -ne 0 && -n "$MANIFEST" ]]; then
        manifest_set 'if .run_status == "interrupted" then . else .run_status = "failed" end' || true
    fi
    exit "$status"
}

on_signal() {
    local signal="$1" status="$2"
    trap - INT TERM HUP
    [[ -z "$MANIFEST" ]] || manifest_set '.run_status = "interrupted" | .interrupted_by = $signal' --arg signal "$signal" || true
    on_exit "$status"
}

run_playtest() {
    local codex_bin marker entity_name entity_description user_a_json user_b_json user_a user_b
    local character_a_name character_a_description character_b_name character_b_description
    local place_name place_description character_a_json character_b_json character_a_id character_b_id
    local place_json place_id activity_a_json activity_b_json
    local a_exit b_exit failed=0 entity_id entity_json cleanup_failed=0

    preflight || return 1
    codex_bin="$(resolve_codex_bin)" || return 1
    prepare_artifacts || return 1
    trap 'on_exit $?' EXIT
    trap 'on_signal INT 130' INT
    trap 'on_signal TERM 143' TERM
    trap 'on_signal HUP 129' HUP
    marker="$(<"$RUN_DIR/marker.txt")"
    character_a_name="Founder Character $marker"
    character_a_description="Disposable founder Character for MCP world-entry proof: $marker"
    character_b_name="Joining Character $marker"
    character_b_description="Disposable joining Character for MCP world-entry proof: $marker"
    place_name="Entry Place $marker"
    place_description="Disposable shared entry Place for MCP world-entry proof: $marker"
    entity_name="Disposable Playtest Entity $marker"
    entity_description="Technical cross-User MCP fixture in a disposable World: $marker"

    start_deployment || return 1
    verify_deployment || return 1

    user_a_json="$(provision_user)" || fail 'failed to provision User A before the Agent phase.' || return
    user_a="$(jq -er '.id | select(type == "string")' <<<"$user_a_json")" || fail 'User A provisioner returned malformed JSON.' || return
    printf '%s\n' "$user_a_json" >"$RUN_DIR/user-a.json" || fail 'could not write User A evidence.' || return
    manifest_set '.provisioning.user_a = $id' --arg id "$user_a" || return

    user_b_json="$(provision_user)" || fail 'failed to provision User B before the Agent phase.' || return
    user_b="$(jq -er '.id | select(type == "string")' <<<"$user_b_json")" || fail 'User B provisioner returned malformed JSON.' || return
    printf '%s\n' "$user_b_json" >"$RUN_DIR/user-b.json" || fail 'could not write User B evidence.' || return
    manifest_set '.provisioning.user_b = $id' --arg id "$user_b" || return
    [[ "$user_a" != "$user_b" ]] || fail 'provisioning did not create two distinct Users.' || return
    verify_provisioned_user "$user_a" || fail 'provisioned User A is not visible in the disposable World.' || return
    verify_provisioned_user "$user_b" || fail 'provisioned User B is not visible in the disposable World.' || return
    prepare_agent_evidence_files || fail 'could not prepare all Agent evidence files before the Agent phase.' || return

    run_agent "$codex_bin" "$user_a" "$RUN_DIR/agent-a.prompt.txt" "$FOUND_SCHEMA" \
        "$RUN_DIR/agent-a.events.jsonl" "$RUN_DIR/agent-a.stderr.log" "$RUN_DIR/agent-a.final.json" \
        "$ISOLATED_A" "$AGENT_A_TOOLS"
    a_exit=$?

    run_agent "$codex_bin" "$user_b" "$RUN_DIR/agent-b.prompt.txt" "$JOIN_SCHEMA" \
        "$RUN_DIR/agent-b.events.jsonl" "$RUN_DIR/agent-b.stderr.log" "$RUN_DIR/agent-b.final.json" \
        "$ISOLATED_B" "$AGENT_B_TOOLS"
    b_exit=$?
    printf '%s\n' "$a_exit" >"$RUN_DIR/agent-a.exit-status" || fail 'could not write Agent A exit evidence.' || return
    printf '%s\n' "$b_exit" >"$RUN_DIR/agent-b.exit-status" || fail 'could not write Agent B exit evidence.' || return
    manifest_set '.agents.a = {exit_status: $exit}' --argjson exit "$a_exit" || return
    manifest_set '.agents.b = {exit_status: $exit}' --argjson exit "$b_exit" || return
    cleanup_local_directories

    [[ $a_exit -eq 0 ]] || { fail "Agent A exited $a_exit (a deadline usually exits 142)."; failed=1; }
    [[ $b_exit -eq 0 ]] || { fail "Agent B exited $b_exit (a deadline usually exits 142)."; failed=1; }
    events_are_clean "$RUN_DIR/agent-a.events.jsonl" 1 || { fail 'Agent A JSONL contains an unexpected error or failed-call count.'; failed=1; }
    events_are_clean "$RUN_DIR/agent-b.events.jsonl" 0 || { fail 'Agent B JSONL contains an error or is malformed.'; failed=1; }

    entity_id="$(find_fixture_entity_id "$entity_name")" || { fail 'validation did not find exactly one fixture Entity on the first list page.'; failed=1; entity_id=''; }
    character_a_json="$(curl_json -H "Aicadia-User-Id: $user_a" "$BASE_URL/api/character")" \
        || { fail 'validation could not read Character A.'; failed=1; character_a_json='{}'; }
    character_b_json="$(curl_json -H "Aicadia-User-Id: $user_b" "$BASE_URL/api/character")" \
        || { fail 'validation could not read Character B.'; failed=1; character_b_json='{}'; }
    activity_a_json="$(curl_json -H "Aicadia-User-Id: $user_a" "$BASE_URL/api/activity?limit=25")" \
        || { fail 'validation could not read Activity A.'; failed=1; activity_a_json='{}'; }
    activity_b_json="$(curl_json -H "Aicadia-User-Id: $user_b" "$BASE_URL/api/activity?limit=25")" \
        || { fail 'validation could not read Activity B.'; failed=1; activity_b_json='{}'; }
    character_a_id="$(jq -er '.entity.id | select(type == "string")' <<<"$character_a_json")" \
        || { fail 'Character A response has no Entity id.'; failed=1; character_a_id=''; }
    character_b_id="$(jq -er '.entity.id | select(type == "string")' <<<"$character_b_json")" \
        || { fail 'Character B response has no Entity id.'; failed=1; character_b_id=''; }
    place_json="$(jq -ec '.current_place | select(type == "object")' <<<"$character_a_json")" \
        || { fail 'Character A is not placed.'; failed=1; place_json='{}'; }
    place_id="$(jq -er '.entity.id | select(type == "string")' <<<"$place_json")" \
        || { fail 'Character A Place has no Entity id.'; failed=1; place_id=''; }

    jq -e --arg user "$user_a" --arg name "$character_a_name" --arg description "$character_a_description" \
        --arg place "$place_id" '
        .owner_user_id == $user
        and .entity.name == $name and .entity.description == $description
        and .current_place.entity.id == $place and .current_place.is_entry == true
    ' <<<"$character_a_json" >/dev/null || { fail 'stored Character A does not match the founded placement.'; failed=1; }
    jq -e --arg user "$user_b" --arg name "$character_b_name" --arg description "$character_b_description" \
        --arg place "$place_id" '
        .owner_user_id == $user
        and .entity.name == $name and .entity.description == $description
        and .current_place.entity.id == $place and .current_place.is_entry == true
    ' <<<"$character_b_json" >/dev/null || { fail 'stored Character B did not join Character A at the same Place.'; failed=1; }
    jq -e --arg place "$place_id" --arg name "$place_name" --arg description "$place_description" '
        .entity.id == $place and .entity.name == $name and .entity.description == $description and .is_entry == true
    ' <<<"$place_json" >/dev/null || { fail 'stored entry Place does not match the exact genesis fixture.'; failed=1; }
    jq -e '[.activity[].operation] == ["create_entity", "enter_world", "create_entry_place", "create_character"] and .next == null' \
        <<<"$activity_a_json" >/dev/null || { fail 'stored Activity A does not contain the exact accepted action history.'; failed=1; }
    jq -e '[.activity[].operation] == ["enter_world", "create_character"] and .next == null' \
        <<<"$activity_b_json" >/dev/null || { fail 'stored Activity B does not contain the exact accepted action history.'; failed=1; }

    if [[ -n "$entity_id" ]]; then
        entity_json="$(curl_json "$BASE_URL/api/entity/$entity_id")" || { fail 'validation could not read the fixture Entity.'; failed=1; entity_json='{}'; }
        jq -e --arg id "$entity_id" --arg user "$user_a" --arg name "$entity_name" --arg description "$entity_description" '
            .id == $id and .introduced_by_user_id == $user and .name == $name and .description == $description
        ' <<<"$entity_json" >/dev/null || { fail 'stored Entity does not match Agent A, User A, and exact fixture content.'; failed=1; }
        agent_a_events_match "$RUN_DIR/agent-a.events.jsonl" \
            "$character_a_name" "$character_a_description" "$place_name" "$place_description" \
            "$entity_name" "$entity_description" "$user_a" \
            || { fail 'Agent A JSONL does not prove the exact genesis, entry, Entity and Activity flow.'; failed=1; }
        agent_b_events_match "$RUN_DIR/agent-b.events.jsonl" "$entity_json" "$user_b" "$place_json" \
            "$character_b_name" "$character_b_description" \
            || { fail 'Agent B JSONL does not prove the exact shared Place, Activity and Entity observation flow.'; failed=1; }
        found_final_is_valid "$RUN_DIR/agent-a.final.json" "$marker" "$character_a_id" "$place_id" "$entity_id" \
            || { fail 'Agent A final artifact does not match exact stored World and Activity state.'; failed=1; }
        joined_final_is_valid "$RUN_DIR/agent-b.final.json" "$marker" "$user_b" "$character_b_id" "$place_id" "$entity_id" \
            || { fail 'Agent B final artifact does not match exact shared World and Activity state.'; failed=1; }
    fi

    if [[ $failed -eq 0 ]]; then
        manifest_set '.validation = {status: "passed", character_a_id: $character_a, character_b_id: $character_b, place_id: $place, entity_id: $entity}' \
            --arg character_a "$character_a_id" --arg character_b "$character_b_id" \
            --arg place "$place_id" --arg entity "$entity_id" || return
    else
        manifest_set '.validation = {status: "failed"}' || return
    fi
    cleanup_deployment || cleanup_failed=1
    [[ $cleanup_failed -eq 0 ]] || return 1
    if [[ $failed -ne 0 ]]; then
        fail "playtest failed after exactly two Agent attempts; inspect $RUN_DIR"
        return 1
    fi
    manifest_set '.run_status = "completed"' || return
    printf 'Playtest passed with two Characters at one shared entry Place, personal Activity proof and cross-User Entity observation in a disposable World, which was dropped. Artifacts: %s\n' "$RUN_DIR"
}

main() {
    case "$#:${1-}" in
        1:preflight)
            preflight
            ;;
        2:run)
            [[ "$2" == '--confirm-token-spend' ]] || {
                fail 'usage: tools/agent-playtest run --confirm-token-spend'
                return 1
            }
            run_playtest
            ;;
        *)
            fail 'usage: tools/agent-playtest preflight | tools/agent-playtest run --confirm-token-spend'
            ;;
    esac
}

main "$@"
