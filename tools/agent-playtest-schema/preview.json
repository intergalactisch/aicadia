{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "const": "previewed" },
    "marker": { "type": "string" },
    "selected_proposal_id": { "type": "string", "const": "two" },
    "prose": { "type": "string" },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "introduce_entity" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "property": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "const": "material" },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "const": "text" },
                  "text": { "type": "string" }
                },
                "required": ["type", "text"]
              }
            },
            "required": ["key", "value"]
          }
        }
      },
      "required": ["type", "name", "description", "property"]
    }
  },
  "required": ["status", "marker", "selected_proposal_id", "prose", "consequence"]
}
