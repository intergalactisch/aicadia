#!/usr/bin/env bash
set -u
set -o pipefail

readonly LAB_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly CARGO_PATH="$LAB_DIR/Cargo.toml"
readonly LAB_BINARY="$LAB_DIR/target/debug/aicadia-host-independent-change-wait-lab"
readonly CLIENT_BINARY="$LAB_DIR/target/debug/client"
readonly FIXTURE_PATH="$LAB_DIR/fixture/state.json"
readonly PROMPT_PATH="$LAB_DIR/fixture/prompt.txt"
readonly INSTRUCTIONS_PATH="$LAB_DIR/fixture/server-instructions.txt"
readonly RESULT_DIR="$LAB_DIR/result"
readonly PREFLIGHT_PATH="$RESULT_DIR/token-free-preflight.json"
readonly BROWSER_PREFLIGHT_PATH="$RESULT_DIR/browser-preflight.json"
readonly LIVE_DIR="$RESULT_DIR/live"
readonly GUARD_DIR="$RESULT_DIR/live.guard"
readonly MANIFEST_PATH="$LIVE_DIR/manifest.json"
readonly BROWSER_CONFIRMATION_PATH="$LIVE_DIR/browser-confirmation.json"
readonly CODEX_VERSION='codex-cli 0.149.0'
readonly CODEX_MODEL='gpt-5.6-sol'
readonly CODEX_EFFORT='high'
readonly MAX_AGENT_SECONDS=120
readonly MCP_START_SECONDS=90
readonly CLIENT_START_SECONDS=25
readonly DISABLED_FEATURES=(
    apps auth_elicitation browser_use browser_use_external browser_use_full_cdp_access
    computer_use goals hooks image_generation in_app_browser multi_agent multi_agent_v2
    plugins remote_plugin shell_snapshot shell_tool skill_mcp_dependency_install
    tool_call_mcp_elicitation tool_suggest unified_exec view_image workspace_dependencies
)

SERVER_PID=''
TERMINAL_PID=''
AGENT_PID=''
WATCHDOG_PID=''
CONTROL_TOKEN=''
BASE_URL=''
MCP_URL=''
CONTROL_URL=''
ISOLATED_CODEX_DIR=''
AGENT_WORK=''
CAPTURE_DIR=''
LIVE_STARTED=0

fail() {
    printf 'change-wait-lab: %s\n' "$*" >&2
    return 1
}

owned_temp_delete() {
    local path="$1" name
    [[ -n "$path" && -d "$path" && ! -L "$path" ]] || return 0
    name="$(basename "$path")"
    [[ "$name" == aicadia-change-wait-* ]] || return 1
    find "$path" -depth -delete
}

atomic_manifest_update() {
    local filter="$1" temporary
    shift
    [[ -f "$MANIFEST_PATH" && ! -L "$MANIFEST_PATH" ]] || return 1
    temporary="$(mktemp "$LIVE_DIR/manifest-update-XXXXXXXX")" || return 1
    if ! jq "$@" "$filter" "$MANIFEST_PATH" >"$temporary"; then
        find "$temporary" -delete
        return 1
    fi
    chmod 600 "$temporary"
    mv "$temporary" "$MANIFEST_PATH"
}

stop_processes() {
    if [[ -n "$WATCHDOG_PID" ]]; then
        kill "$WATCHDOG_PID" 2>/dev/null || true
        wait "$WATCHDOG_PID" 2>/dev/null || true
        WATCHDOG_PID=''
    fi
    if [[ -n "$AGENT_PID" ]]; then
        kill -TERM "-$AGENT_PID" 2>/dev/null || true
        wait "$AGENT_PID" 2>/dev/null || true
        AGENT_PID=''
    fi
    if [[ -n "$TERMINAL_PID" ]]; then
        kill "$TERMINAL_PID" 2>/dev/null || true
        wait "$TERMINAL_PID" 2>/dev/null || true
        TERMINAL_PID=''
    fi
    if [[ -n "$SERVER_PID" ]]; then
        kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
        SERVER_PID=''
    fi
}

cleanup() {
    local cleanup_status='passed'
    stop_processes
    owned_temp_delete "$ISOLATED_CODEX_DIR" || cleanup_status='failed'
    owned_temp_delete "$AGENT_WORK" || cleanup_status='failed'
    owned_temp_delete "$CAPTURE_DIR" || cleanup_status='failed'
    [[ -z "$ISOLATED_CODEX_DIR" || ! -e "$ISOLATED_CODEX_DIR" ]] || cleanup_status='failed'
    [[ -z "$AGENT_WORK" || ! -e "$AGENT_WORK" ]] || cleanup_status='failed'
    [[ -z "$CAPTURE_DIR" || ! -e "$CAPTURE_DIR" ]] || cleanup_status='failed'
    ISOLATED_CODEX_DIR=''
    AGENT_WORK=''
    CAPTURE_DIR=''
    CONTROL_TOKEN=''
    if [[ $LIVE_STARTED -eq 1 && -f "$MANIFEST_PATH" ]]; then
        atomic_manifest_update '
          .cleanup_status = $cleanup
          | if .verdict == "pending" then
              .verdict = "inconclusive"
              | .run_status = "aborted_after_authority_consumption"
              | .classification_reason = "runner stopped after the sole Agent authority was consumed"
            else . end
        ' --arg cleanup "$cleanup_status" || true
    fi
}

trap 'cleanup || true' EXIT INT TERM

digest() {
    shasum -a 256 "$1" | awk '{print $1}'
}

harness_digest() {
    shasum -a 256 \
        "$CARGO_PATH" "$LAB_DIR/Cargo.lock" "$LAB_DIR/src/lib.rs" \
        "$LAB_DIR/src/main.rs" "$LAB_DIR/src/bin/client.rs" "$LAB_DIR/run" \
        "$LAB_DIR/component/index.html" "$FIXTURE_PATH" "$PROMPT_PATH" \
        "$INSTRUCTIONS_PATH" | shasum -a 256 | awk '{print $1}'
}

static_token_free() {
    local prerequisite required
    for prerequisite in cargo curl jq openssl perl shasum; do
        command -v "$prerequisite" >/dev/null 2>&1 \
            || fail "missing prerequisite: $prerequisite" || return
    done
    for required in "$CARGO_PATH" "$LAB_DIR/Cargo.lock" "$LAB_DIR/src/lib.rs" \
        "$LAB_DIR/src/main.rs" "$LAB_DIR/src/bin/client.rs" "$LAB_DIR/run" \
        "$LAB_DIR/component/index.html" "$FIXTURE_PATH" "$PROMPT_PATH" \
        "$INSTRUCTIONS_PATH"; do
        [[ -f "$required" && ! -L "$required" ]] \
            || fail "missing or linked fixed input: $required" || return
    done
    jq -e '
      .subject == "lab://entity/table"
      and .version == 1
      and .description == "brown wooden table"
    ' "$FIXTURE_PATH" >/dev/null || fail 'unexpected fixture' || return
    if grep -Eiq 'blue|blauw|version 2|versie 2' "$PROMPT_PATH"; then
        fail 'the User prompt reveals the future state'
        return
    fi
    grep -F 'wait_for_change' "$INSTRUCTIONS_PATH" >/dev/null \
        || fail 'server instructions lost the bounded-wait route' || return
    cargo fmt --manifest-path "$CARGO_PATH" -- --check || return
    cargo build --quiet --manifest-path "$CARGO_PATH" || return
    cargo test --quiet --manifest-path "$CARGO_PATH" || return
}

codex_base_command() {
    local codex_bin="$1" mcp_url="$2" feature
    CODEX_COMMAND=(
        "$codex_bin" --ask-for-approval never --sandbox read-only --model "$CODEX_MODEL"
        --enable mcp_2026_07_28
        --config 'suppress_unstable_features_warning=true'
        --config "model_reasoning_effort=\"$CODEX_EFFORT\""
        --config 'web_search="disabled"'
        --config 'tools.web_search=false'
        --config "mcp_servers.change_wait_lab.url=\"$mcp_url\""
        --config 'mcp_servers.change_wait_lab.enabled=true'
        --config 'mcp_servers.change_wait_lab.required=true'
    )
    for feature in "${DISABLED_FEATURES[@]}"; do
        CODEX_COMMAND+=(--disable "$feature")
    done
}

static_agent() {
    local codex_bin version login model_catalog features parse_dir parsed parse_status
    command -v codex >/dev/null 2>&1 || fail 'missing prerequisite: codex' || return
    codex_bin="$(command -v codex)" || return
    version="$("$codex_bin" --version)" || return
    [[ "$version" == "$CODEX_VERSION" ]] \
        || fail "expected $CODEX_VERSION; found $version" || return
    login="$("$codex_bin" login status 2>&1)" \
        || fail 'Codex authentication is unavailable' || return
    [[ "$login" == Logged\ in\ using\ * ]] || fail 'Codex is not logged in' || return
    model_catalog="$("$codex_bin" debug models)" \
        || fail 'Codex model catalog is unavailable' || return
    jq -e --arg model "$CODEX_MODEL" --arg effort "$CODEX_EFFORT" '
      [.models[] | select(.slug == $model)] as $entry
      | ($entry | length) == 1
      and any($entry[0].supported_reasoning_levels[]; .effort == $effort)
    ' <<<"$model_catalog" >/dev/null \
        || fail "$CODEX_MODEL/$CODEX_EFFORT is unavailable" || return
    features="$("$codex_bin" features list)" || return
    awk '$1 == "mcp_2026_07_28" && $2 != "removed" { found = 1 } END { exit !found }' \
        <<<"$features" || fail 'required Codex MCP feature is absent' || return

    parse_dir="$(mktemp -d /tmp/aicadia-change-wait-config-XXXXXXXX)" || return
    codex_base_command "$codex_bin" 'http://127.0.0.1:9/mcp'
    parsed="$(CODEX_HOME="$parse_dir" "${CODEX_COMMAND[@]}" mcp get change_wait_lab --json 2>/dev/null)"
    parse_status=$?
    owned_temp_delete "$parse_dir" || true
    [[ $parse_status -eq 0 ]] \
        || fail 'Codex rejected the isolated MCP configuration' || return
    jq -e '
      .name == "change_wait_lab" and .enabled == true
      and .transport.type == "streamable_http"
      and .transport.url == "http://127.0.0.1:9/mcp"
      and .enabled_tools == null and .disabled_tools == null
    ' <<<"$parsed" >/dev/null \
        || fail 'Codex parsed a different MCP configuration' || return
}

write_preflight() {
    local temporary
    mkdir -p "$RESULT_DIR" || return
    [[ -d "$RESULT_DIR" && ! -L "$RESULT_DIR" ]] \
        || fail 'result root must be a real directory' || return
    temporary="$(mktemp "$RESULT_DIR/preflight-XXXXXXXX")" || return
    if ! cargo run --quiet --manifest-path "$CARGO_PATH" \
        --bin aicadia-host-independent-change-wait-lab -- preflight >"$temporary"; then
        find "$temporary" -delete
        return 1
    fi
    jq -e '
      .protocol_version == "2026-07-28"
      and .agent_processes_launched == 0
      and .hot_waiters == 10000
      and .http.initial.version == 1
      and .http.initial.description == "brown wooden table"
      and .http.wait_result == {changed_subjects:["lab://entity/table"],timed_out:false}
      and .http.final_state.version == 2
      and .http.final_state.description == "blue wooden table"
      and .mcp.initial.version == 1
      and .mcp.wait_result == {changed_subjects:["lab://entity/table"],timed_out:false}
      and .mcp.final_state.version == 2
      and .mcp.final_state.description == "blue wooden table"
    ' "$temporary" >/dev/null || {
        find "$temporary" -delete
        fail 'token-free report did not prove the exact scenarios'
        return
    }
    chmod 600 "$temporary"
    mv "$temporary" "$PREFLIGHT_PATH"
}

preflight() {
    static_token_free || return
    write_preflight || return
    printf 'Token-free preflight passed: 11 tests, HTTP and official MCP read→wait→reread, 10,000 hot waiters, Agent processes=0.\n'
}

record_browser() {
    local base_url="${1:-}" token="${2:-}" status="${3:-}" version="${4:-}" description="${5:-}"
    local observations state temporary
    [[ "$base_url" =~ ^http://127\.0\.0\.1:[0-9]+$ ]] \
        || fail 'browser evidence requires a loopback lab URL' || return
    [[ ${#token} -ge 32 ]] || fail 'browser evidence requires the controller token' || return
    [[ "$status" == 'changed and reread' && "$version" == 2 \
        && "$description" == 'blue wooden table' ]] \
        || fail 'browser DOM did not show the exact final state' || return
    [[ -f "$PREFLIGHT_PATH" ]] || fail 'token-free preflight is missing' || return
    observations="$(mktemp /tmp/aicadia-change-wait-browser-observations-XXXXXXXX)" || return
    state="$(mktemp /tmp/aicadia-change-wait-browser-state-XXXXXXXX)" || return
    curl --disable --fail --silent --show-error --connect-timeout 1 --max-time 2 \
        -H "x-lab-control-token: $token" "$base_url/control/observations" >"$observations" || return
    curl --disable --fail --silent --show-error --connect-timeout 1 --max-time 2 \
        -H "x-lab-control-token: $token" "$base_url/control/state" >"$state" || return
    jq -e '
      any(.[]; .event == "state_read" and (.detail | contains("adapter=component")) and (.detail | contains("version=1")))
      and any(.[]; .event == "wait_registered" and (.detail | contains("adapter=component")) and (.detail | contains("known_version=1")))
      and any(.[]; .event == "wait_returned" and (.detail | contains("adapter=component result=changed")))
      and any(.[]; .event == "state_read" and (.detail | contains("adapter=component")) and (.detail | contains("version=2")))
    ' "$observations" >/dev/null || fail 'server observations do not prove the browser path' || return
    jq -e '.version == 2 and .description == "blue wooden table"' "$state" >/dev/null \
        || fail 'controller readback is not blue version 2' || return
    temporary="$(mktemp "$RESULT_DIR/browser-preflight-XXXXXXXX")" || return
    jq -n --arg status "$status" --argjson version "$version" \
      --arg description "$description" --slurpfile observations "$observations" \
      --slurpfile state "$state" '
      {
        observed_in:"Codex In-app Browser",
        agent_processes_launched:0,
        dom:{status:$status,version:$version,description:$description},
        controller_state:$state[0],
        observations:$observations[0]
      }
    ' >"$temporary" || return
    chmod 600 "$temporary"
    mv "$temporary" "$BROWSER_PREFLIGHT_PATH"
    find "$observations" "$state" -delete
    printf 'Browser preflight recorded: waiting at version 1, then changed and reread blue version 2.\n'
}

guard_self_test() {
    local test_root
    test_root="$(mktemp -d /tmp/aicadia-change-wait-guard-XXXXXXXX)" || return
    mkdir "$test_root/guard" || return
    if mkdir "$test_root/guard" 2>/dev/null; then
        owned_temp_delete "$test_root" || true
        fail 'atomic guard admitted a second launch'
        return
    fi
    owned_temp_delete "$test_root" || return
}

start_server() {
    local ready='' attempt=0
    CONTROL_TOKEN="$(openssl rand -hex 32)" || return
    "$LAB_BINARY" serve "$CONTROL_TOKEN" \
        >"$CAPTURE_DIR/server.stdout.log" 2>"$CAPTURE_DIR/server.stderr.log" &
    SERVER_PID=$!
    while [[ $attempt -lt 200 ]]; do
        attempt=$((attempt + 1))
        kill -0 "$SERVER_PID" 2>/dev/null || break
        ready="$(head -n 1 "$CAPTURE_DIR/server.stdout.log" 2>/dev/null || true)"
        jq -e '.base_url and .mcp_url and .control_url' >/dev/null 2>&1 <<<"$ready" && break
        ready=''
        sleep 0.05
    done
    [[ -n "$ready" ]] || fail 'the live server did not become ready' || return
    BASE_URL="$(jq -r '.base_url' <<<"$ready")"
    MCP_URL="$(jq -r '.mcp_url' <<<"$ready")"
    CONTROL_URL="$(jq -r '.control_url' <<<"$ready")"
    [[ "$BASE_URL" =~ ^http://127\.0\.0\.1:[0-9]+$ ]] \
        || fail 'the server is not bounded to loopback' || return
}

controller_get() {
    local suffix="$1" output="$2"
    curl --disable --fail --silent --show-error --connect-timeout 1 --max-time 2 \
        -H "x-lab-control-token: $CONTROL_TOKEN" "$CONTROL_URL/$suffix" >"$output"
}

controller_advance() {
    local output="$1"
    curl --disable --fail --silent --show-error --connect-timeout 1 --max-time 2 \
        -X POST -H "x-lab-control-token: $CONTROL_TOKEN" \
        "$CONTROL_URL/advance" >"$output"
}

write_live_manifest() {
    local temporary
    temporary="$(mktemp "$LIVE_DIR/manifest-initial-XXXXXXXX")" || return
    jq -n \
      --arg started_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg codex_version "$CODEX_VERSION" --arg model "$CODEX_MODEL" \
      --arg effort "$CODEX_EFFORT" --arg fixture "$(digest "$FIXTURE_PATH")" \
      --arg prompt "$(digest "$PROMPT_PATH")" \
      --arg instructions "$(digest "$INSTRUCTIONS_PATH")" \
      --arg harness "$(harness_digest)" --argjson timeout "$MAX_AGENT_SECONDS" '
      {
        evidence_kind:"live_host_independent_change_wait",
        started_at:$started_at,
        preflight_status:"passed",
        browser_preflight_status:"passed",
        run_status:"ready",
        agent_processes:0,
        retries:0,
        authorization_consumed:false,
        codex:{version:$codex_version,model:$model,reasoning_effort:$effort},
        fixed_input_sha256:{fixture:$fixture,prompt:$prompt,instructions:$instructions,harness:$harness},
        agent_timeout_seconds:$timeout,
        agent_exit_status:null,
        timed_out:false,
        registered_waits:{terminal:false,component:false,mcp:false},
        mutation_performed:false,
        rereads:{terminal:false,component:false,mcp:false},
        browser_dom_confirmed:false,
        controller_readback_blue:false,
        cleanup_status:"pending",
        classification_reason:null,
        verdict:"pending"
      }
    ' >"$temporary" || return
    chmod 600 "$temporary"
    mv "$temporary" "$MANIFEST_PATH"
}

consume_authority() {
    mkdir "$GUARD_DIR" || return
    LIVE_STARTED=1
    atomic_manifest_update '
      .agent_processes = 1
      | .authorization_consumed = true
      | .run_status = "agent_running"
    '
}

launch_agent() {
    local codex_bin="$1"
    codex_base_command "$codex_bin" "$MCP_URL"
    CODEX_COMMAND+=(
        exec --ephemeral --ignore-user-config --ignore-rules --strict-config
        --skip-git-repo-check --json --color never --cd "$AGENT_WORK"
        --output-last-message "$CAPTURE_DIR/agent.final.txt" -
    )
    CODEX_HOME="$ISOLATED_CODEX_DIR" perl -e '
      use POSIX qw(setpgid);
      setpgid(0, 0) or die "setpgid: $!";
      exec @ARGV or die "exec: $!";
    ' "${CODEX_COMMAND[@]}" <"$PROMPT_PATH" \
        >"$CAPTURE_DIR/agent.events.jsonl" 2>"$CAPTURE_DIR/agent.stderr.log" &
    AGENT_PID=$!
    perl -e '
      my ($seconds, $pid, $marker) = @ARGV;
      for (1 .. $seconds) {
        sleep 1;
        exit 0 unless kill 0, $pid;
      }
      open my $fh, ">", $marker or die $!;
      print {$fh} "timed_out\n";
      close $fh;
      kill "TERM", -$pid;
      sleep 2;
      kill "KILL", -$pid if kill 0, $pid;
    ' "$MAX_AGENT_SECONDS" "$AGENT_PID" "$CAPTURE_DIR/timed-out" &
    WATCHDOG_PID=$!
}

observation_has() {
    local jq_filter="$1"
    controller_get observations "$CAPTURE_DIR/observations-current.json" 2>/dev/null \
        && jq -e "$jq_filter" "$CAPTURE_DIR/observations-current.json" >/dev/null
}

wait_for_mcp() {
    local attempt=0
    while [[ $attempt -lt $((MCP_START_SECONDS * 10)) ]]; do
        attempt=$((attempt + 1))
        observation_has 'any(.[]; .event == "wait_registered" and (.detail | contains("adapter=mcp")))' \
            && return 0
        kill -0 "$AGENT_PID" 2>/dev/null || return 1
        sleep 0.1
    done
    return 1
}

launch_terminal() {
    "$CLIENT_BINARY" "$BASE_URL" \
        >"$CAPTURE_DIR/terminal.json" 2>"$CAPTURE_DIR/terminal.stderr.log" &
    TERMINAL_PID=$!
}

wait_for_other_clients() {
    local attempt=0
    while [[ $attempt -lt $((CLIENT_START_SECONDS * 10)) ]]; do
        attempt=$((attempt + 1))
        if observation_has '
          any(.[]; .event == "wait_registered" and (.detail | contains("adapter=terminal")))
          and any(.[]; .event == "wait_registered" and (.detail | contains("adapter=component")))
        '; then
            return 0
        fi
        kill -0 "$AGENT_PID" 2>/dev/null || return 1
        sleep 0.1
    done
    return 1
}

confirm_live_browser() {
    local status="${1:-}" version="${2:-}" description="${3:-}" temporary
    [[ -d "$LIVE_DIR" && -f "$MANIFEST_PATH" ]] \
        || fail 'no live run is awaiting browser confirmation' || return
    [[ "$status" == 'changed and reread' && "$version" == 2 \
        && "$description" == 'blue wooden table' ]] \
        || fail 'browser DOM did not show the exact live final state' || return
    [[ ! -e "$BROWSER_CONFIRMATION_PATH" ]] \
        || fail 'live browser confirmation already exists' || return
    temporary="$(mktemp "$LIVE_DIR/browser-confirmation-XXXXXXXX")" || return
    jq -n --arg status "$status" --argjson version "$version" \
      --arg description "$description" --arg observed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
      {
        observed_in:"Codex In-app Browser",
        observed_at:$observed_at,
        dom:{status:$status,version:$version,description:$description}
      }
    ' >"$temporary" || return
    chmod 600 "$temporary"
    mv "$temporary" "$BROWSER_CONFIRMATION_PATH"
    printf 'Live browser DOM confirmation recorded.\n'
}

sanitize_capture() {
    local source="$1" destination="$2"
    [[ -f "$source" && ! -L "$source" ]] || return 1
    perl -pe '
      BEGIN { ($codex, $work, $capture, $token) = splice(@ARGV, 0, 4) }
      s/\Q$codex\E/<isolated-codex>/g if length $codex;
      s/\Q$work\E/<agent-work>/g if length $work;
      s/\Q$capture\E/<capture>/g if length $capture;
      s/\Q$token\E/<controller-token>/g if length $token;
    ' "$ISOLATED_CODEX_DIR" "$AGENT_WORK" "$CAPTURE_DIR" "$CONTROL_TOKEN" \
        "$source" >"$destination"
    chmod 600 "$destination"
}

classify_live_result() {
    local exit_status="$1" timed_out=false terminal_wait=false component_wait=false mcp_wait=false
    local terminal_read=false component_read=false mcp_read=false mutation=false browser_dom=false
    local readback=false agent_grounded=false verdict reason
    [[ -f "$CAPTURE_DIR/timed-out" ]] && timed_out=true
    jq -e 'any(.[]; .event == "wait_registered" and (.detail | contains("adapter=terminal")))' \
        "$LIVE_DIR/observations.json" >/dev/null && terminal_wait=true
    jq -e 'any(.[]; .event == "wait_registered" and (.detail | contains("adapter=component")))' \
        "$LIVE_DIR/observations.json" >/dev/null && component_wait=true
    jq -e 'any(.[]; .event == "wait_registered" and (.detail | contains("adapter=mcp")))' \
        "$LIVE_DIR/observations.json" >/dev/null && mcp_wait=true
    jq -e 'any(.[]; .event == "state_advanced" and (.detail | contains("version=2")))' \
        "$LIVE_DIR/observations.json" >/dev/null && mutation=true
    jq -e '
      .initial.version == 1 and .initial.description == "brown wooden table"
      and .wait_result == {changed_subjects:["lab://entity/table"],timed_out:false}
      and .final_state.version == 2 and .final_state.description == "blue wooden table"
    ' "$LIVE_DIR/terminal.json" >/dev/null && terminal_read=true
    jq -e '
      any(.[]; .event == "wait_returned" and (.detail | contains("adapter=component result=changed")))
      and any(.[]; .event == "state_read" and (.detail | contains("adapter=component")) and (.detail | contains("version=2")))
    ' "$LIVE_DIR/observations.json" >/dev/null && component_read=true
    jq -e '
      any(.[]; .event == "wait_returned" and (.detail | contains("adapter=mcp result=changed")))
      and any(.[]; .event == "state_read" and (.detail | contains("adapter=mcp")) and (.detail | contains("version=2")))
    ' "$LIVE_DIR/observations.json" >/dev/null && mcp_read=true
    [[ -f "$BROWSER_CONFIRMATION_PATH" ]] \
        && jq -e '.dom == {status:"changed and reread",version:2,description:"blue wooden table"}' \
            "$BROWSER_CONFIRMATION_PATH" >/dev/null && browser_dom=true
    jq -e '.version == 2 and .description == "blue wooden table"' \
        "$LIVE_DIR/controller-readback.json" >/dev/null && readback=true
    if [[ -f "$LIVE_DIR/agent.final.txt" ]] \
        && grep -Eiq '(tafel.*blauw|blauw.*tafel)' "$LIVE_DIR/agent.final.txt"; then
        agent_grounded=true
    fi

    if [[ $exit_status -eq 0 && "$terminal_wait" == true && "$component_wait" == true \
        && "$mcp_wait" == true && "$mutation" == true && "$terminal_read" == true \
        && "$component_read" == true && "$mcp_read" == true && "$browser_dom" == true \
        && "$readback" == true && "$agent_grounded" == true ]]; then
        verdict='supported'
        reason='one change woke terminal, browser and MCP Agent waits; all reread blue version 2 and the Agent grounded its User-facing answer'
    elif [[ "$mcp_wait" == true && ( $exit_status -eq 0 || "$timed_out" == true ) ]]; then
        verdict='refuted'
        reason='the pinned Agent entered the bounded MCP wait, but the complete three-client wait and reread path did not finish'
    else
        verdict='inconclusive'
        reason='the process, provider or orchestration failed before the configured three-client capability could be observed cleanly'
    fi

    atomic_manifest_update '
      .completed_at = $completed_at
      | .run_status = "completed"
      | .agent_exit_status = $exit_status
      | .timed_out = $timed_out
      | .registered_waits = {terminal:$terminal,component:$component,mcp:$mcp}
      | .mutation_performed = $mutation
      | .rereads = {terminal:$terminal_read,component:$component_read,mcp:$mcp_read}
      | .browser_dom_confirmed = $browser_dom
      | .controller_readback_blue = $readback
      | .agent_answer_grounded = $agent_grounded
      | .classification_reason = $reason
      | .verdict = $verdict
    ' --arg completed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --argjson exit_status "$exit_status" --argjson timed_out "$timed_out" \
      --argjson terminal "$terminal_wait" --argjson component "$component_wait" \
      --argjson mcp "$mcp_wait" --argjson mutation "$mutation" \
      --argjson terminal_read "$terminal_read" --argjson component_read "$component_read" \
      --argjson mcp_read "$mcp_read" --argjson browser_dom "$browser_dom" \
      --argjson readback "$readback" --argjson agent_grounded "$agent_grounded" \
      --arg reason "$reason" --arg verdict "$verdict" || return
    printf 'Live verdict: %s — %s.\n' "$verdict" "$reason"
}

live() {
    local source_codex_dir codex_bin agent_started agent_finished agent_exit_status
    [[ ! -e "$GUARD_DIR" ]] || fail 'the sole live Agent authority is already consumed' || return
    [[ ! -e "$LIVE_DIR" ]] || fail 'a live result already exists; refusing replacement' || return
    preflight || return
    jq -e '
      .agent_processes_launched == 0
      and .dom == {status:"changed and reread",version:2,description:"blue wooden table"}
    ' "$BROWSER_PREFLIGHT_PATH" >/dev/null \
        || fail 'the real-browser preflight is missing or invalid' || return
    static_agent || return
    guard_self_test || return

    source_codex_dir="${CODEX_HOME:-$HOME/.codex}"
    [[ -f "$source_codex_dir/auth.json" && ! -L "$source_codex_dir/auth.json" ]] \
        || fail 'a regular Codex auth.json is required for isolated execution' || return
    ISOLATED_CODEX_DIR="$(mktemp -d /tmp/aicadia-change-wait-codex-XXXXXXXX)" || return
    AGENT_WORK="$(mktemp -d /tmp/aicadia-change-wait-agent-XXXXXXXX)" || return
    CAPTURE_DIR="$(mktemp -d /tmp/aicadia-change-wait-capture-XXXXXXXX)" || return
    cp "$source_codex_dir/auth.json" "$ISOLATED_CODEX_DIR/auth.json" || return
    chmod 600 "$ISOLATED_CODEX_DIR/auth.json"

    start_server || return
    controller_get state "$CAPTURE_DIR/initial-controller-state.json" || return
    jq -e '.version == 1 and .description == "brown wooden table"' \
        "$CAPTURE_DIR/initial-controller-state.json" >/dev/null \
        || fail 'the live controller did not expose the fixed baseline' || return

    umask 077
    mkdir "$LIVE_DIR" || return
    cp "$FIXTURE_PATH" "$LIVE_DIR/state.json"
    cp "$PROMPT_PATH" "$LIVE_DIR/prompt.txt"
    cp "$INSTRUCTIONS_PATH" "$LIVE_DIR/server-instructions.txt"
    write_live_manifest || return
    consume_authority || return

    codex_bin="$(command -v codex)" || return
    agent_started="$(date +%s)"
    launch_agent "$codex_bin" || return
    if ! wait_for_mcp; then
        fail 'the Agent never entered the MCP wait'
    else
        launch_terminal || return
        printf 'AGENT_WAITING_BROWSER_URL=%s\n' "$BASE_URL"
        if wait_for_other_clients; then
            controller_advance "$CAPTURE_DIR/mutation.json" || return
            printf 'STATE_ADVANCED: inspect the browser, then run ./run confirm-live-browser "changed and reread" 2 "blue wooden table"\n'
        else
            fail 'terminal and browser did not both enter the wait before the deadline'
        fi
    fi

    wait "$AGENT_PID"
    agent_exit_status=$?
    AGENT_PID=''
    if [[ -n "$WATCHDOG_PID" ]]; then
        kill "$WATCHDOG_PID" 2>/dev/null || true
        wait "$WATCHDOG_PID" 2>/dev/null || true
        WATCHDOG_PID=''
    fi
    agent_finished="$(date +%s)"
    if [[ -n "$TERMINAL_PID" ]]; then
        wait "$TERMINAL_PID" || true
        TERMINAL_PID=''
    fi

    for _ in $(seq 1 200); do
        [[ -f "$BROWSER_CONFIRMATION_PATH" ]] && break
        sleep 0.1
    done
    controller_get observations "$CAPTURE_DIR/observations-final.json" || true
    controller_get state "$CAPTURE_DIR/controller-readback.json" || true

    [[ -s "$CAPTURE_DIR/observations-final.json" ]] \
        || printf '[]\n' >"$CAPTURE_DIR/observations-final.json"
    [[ -s "$CAPTURE_DIR/controller-readback.json" ]] \
        || printf '{}\n' >"$CAPTURE_DIR/controller-readback.json"
    [[ -s "$CAPTURE_DIR/terminal.json" ]] || printf '{}\n' >"$CAPTURE_DIR/terminal.json"
    for capture in agent.events.jsonl agent.stderr.log agent.final.txt \
        terminal.stderr.log server.stderr.log; do
        [[ -e "$CAPTURE_DIR/$capture" ]] || : >"$CAPTURE_DIR/$capture"
        sanitize_capture "$CAPTURE_DIR/$capture" "$LIVE_DIR/$capture" || return
    done
    cp "$CAPTURE_DIR/observations-final.json" "$LIVE_DIR/observations.json"
    cp "$CAPTURE_DIR/controller-readback.json" "$LIVE_DIR/controller-readback.json"
    cp "$CAPTURE_DIR/terminal.json" "$LIVE_DIR/terminal.json"
    [[ ! -f "$CAPTURE_DIR/mutation.json" ]] \
        || cp "$CAPTURE_DIR/mutation.json" "$LIVE_DIR/mutation.json"
    chmod 600 "$LIVE_DIR"/*
    if grep -R -F "$CONTROL_TOKEN" "$LIVE_DIR" >/dev/null 2>&1; then
        fail 'controller token appeared in retained evidence'
        return
    fi
    atomic_manifest_update '.agent_wall_seconds = $seconds' \
        --argjson seconds "$((agent_finished - agent_started))" || return
    classify_live_result "$agent_exit_status"
}

case "${1:-}" in
    preflight)
        preflight
        ;;
    record-browser)
        shift
        record_browser "$@"
        ;;
    self-test)
        guard_self_test
        printf 'Guard self-test passed: one admission, a second refused, Agent processes=0.\n'
        ;;
    live)
        live
        ;;
    confirm-live-browser)
        shift
        confirm_live_browser "$@"
        ;;
    *)
        printf 'usage: %s preflight | record-browser URL TOKEN STATUS VERSION DESCRIPTION | self-test | live | confirm-live-browser STATUS VERSION DESCRIPTION\n' "$0" >&2
        exit 64
        ;;
esac
