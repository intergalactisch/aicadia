{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "opening_message",
    "final_player_message",
    "accepted_state",
    "selected_source_ids"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["accepted", "failed"]
    },
    "opening_message": {
      "type": "string",
      "maxLength": 500
    },
    "final_player_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "accepted_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "orientation", "leg_count"],
      "properties": {
        "color": {"type": "string", "minLength": 1, "maxLength": 40},
        "orientation": {"type": "string", "minLength": 1, "maxLength": 40},
        "leg_count": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "selected_source_ids": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": ["turn-table-over", "remove-one-leg", "make-table-red"]
      }
    }
  }
}
