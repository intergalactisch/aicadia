#!/bin/bash
set -u
set -o pipefail

readonly LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_DIR="$(cd "$LAB_DIR/../../../.." && pwd)"
readonly RESULT_DIR="$LAB_DIR/result/candidate-03"
readonly MANIFEST_PATH="$RESULT_DIR/manifest.json"
readonly CANDIDATE_01_MANIFEST="$LAB_DIR/result/manifest.json"
readonly CANDIDATE_02_MANIFEST="$LAB_DIR/result/candidate-02/manifest.json"
readonly CANDIDATE_02_SCHEMA="$LAB_DIR/result/candidate-02/final.schema.json"
readonly PROMPT_PATH="$LAB_DIR/prompt/agent.txt"
readonly SCHEMA_PATH="$LAB_DIR/schema/final.json"
readonly FIXTURE_PATH="$LAB_DIR/fixture/collision.json"
readonly VALIDATOR_FIXTURE_DIR="$LAB_DIR/fixture/validator"
readonly CARGO_PATH="$LAB_DIR/Cargo.toml"
readonly LAB_BINARY="$LAB_DIR/target/debug/agent-authored-collision-lab"
readonly CODEX_VERSION='codex-cli 0.148.0'
readonly CODEX_MODEL='gpt-5.6-sol'
readonly CODEX_EFFORT='high'
readonly MCP_VERSION='2026-07-28'
readonly ENABLED_TOOLS='["read_subject","submit_change"]'
readonly DIRECT_NAMESPACES='["mcp__collision_lab"]'
readonly MAX_AGENT_SECONDS=180
readonly DISABLED_FEATURES=(
    apps auth_elicitation browser_use browser_use_external browser_use_full_cdp_access
    computer_use goals hooks image_generation in_app_browser multi_agent multi_agent_v2
    plugins remote_plugin shell_snapshot shell_tool skill_mcp_dependency_install
    tool_call_mcp_elicitation tool_suggest unified_exec workspace_dependencies
)

SERVER_PID=''
SERVER_ADDRESS=''
SERVER_ORIGIN=''
MCP_URL=''
AGENT_PID=''
WATCHDOG_PID=''
ISOLATED_CODEX_DIR=''
AGENT_WORK=''
PROBE_WORK=''
LIVE_STARTED=0

fail() {
    printf 'collision-lab: %s\n' "$*" >&2
    return 1
}

owned_temp_delete() {
    local path="$1" name
    [[ -n "$path" && -d "$path" && ! -L "$path" ]] || return 0
    name="$(basename "$path")"
    [[ "$name" == aicadia-collision-* ]] || return 1
    find "$path" -depth -delete
}

stop_processes() {
    if [[ -n "$WATCHDOG_PID" ]]; then
        kill "$WATCHDOG_PID" 2>/dev/null || true
        wait "$WATCHDOG_PID" 2>/dev/null || true
        WATCHDOG_PID=''
    fi
    if [[ -n "$AGENT_PID" ]]; then
        kill -TERM "-$AGENT_PID" 2>/dev/null || true
        wait "$AGENT_PID" 2>/dev/null || true
        AGENT_PID=''
    fi
    if [[ -n "$SERVER_PID" ]]; then
        kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
        SERVER_PID=''
    fi
}

cleanup() {
    local isolated_path="$ISOLATED_CODEX_DIR" work_path="$AGENT_WORK" probe_path="$PROBE_WORK" cleanup_status='passed'
    local agent_pid="$AGENT_PID" server_pid="$SERVER_PID" watchdog_pid="$WATCHDOG_PID"
    stop_processes
    owned_temp_delete "$isolated_path" || cleanup_status='failed'
    owned_temp_delete "$work_path" || cleanup_status='failed'
    owned_temp_delete "$probe_path" || cleanup_status='failed'
    [[ -z "$isolated_path" || ! -e "$isolated_path" ]] || cleanup_status='failed'
    [[ -z "$work_path" || ! -e "$work_path" ]] || cleanup_status='failed'
    [[ -z "$probe_path" || ! -e "$probe_path" ]] || cleanup_status='failed'
    for process_id in "$agent_pid" "$server_pid" "$watchdog_pid"; do
        [[ -z "$process_id" ]] || ! kill -0 "$process_id" 2>/dev/null || cleanup_status='failed'
    done
    ISOLATED_CODEX_DIR=''
    AGENT_WORK=''
    PROBE_WORK=''
    if [[ $LIVE_STARTED -eq 1 && -f "$MANIFEST_PATH" ]]; then
        atomic_manifest_update '.cleanup_status = $status' --arg status "$cleanup_status" || true
    fi
    [[ "$cleanup_status" == passed ]]
}

trap 'cleanup || true' EXIT INT TERM

digest() {
    shasum -a 256 "$1" | awk '{print $1}'
}

harness_digest() {
    shasum -a 256 "$CARGO_PATH" "$LAB_DIR/Cargo.lock" "$LAB_DIR/src/lib.rs" \
        "$LAB_DIR/src/main.rs" "$LAB_DIR/run" \
        "$VALIDATOR_FIXTURE_DIR/agent.events.jsonl" \
        "$VALIDATOR_FIXTURE_DIR/agent.final.json" \
        "$VALIDATOR_FIXTURE_DIR/readback.json" | shasum -a 256 | awk '{print $1}'
}

verify_prior_candidates() {
    local fixture_digest prompt_digest schema_digest
    for required in "$CANDIDATE_01_MANIFEST" "$CANDIDATE_02_MANIFEST" "$CANDIDATE_02_SCHEMA" \
        "$LAB_DIR/result/candidate-02/agent.events.jsonl"; do
        [[ -f "$required" && ! -L "$required" ]] || fail "missing prior candidate evidence: $required" || return
    done
    jq -e '.model_calls == 1 and .authorization_consumed == true and .retries == 0 and .verdict == "inconclusive"' \
        "$CANDIDATE_01_MANIFEST" >/dev/null || fail 'candidate 01 guard is not immutably consumed' || return
    jq -e '.model_calls == 1 and .authorization_consumed == true and .retries == 0
        and .verdict == "inconclusive" and .agent_exit_status == 0
        and .fixed_input_sha256.schema != null' \
        "$CANDIDATE_02_MANIFEST" >/dev/null || fail 'candidate 02 guard is not immutably consumed' || return
    jq -s -e '
        any(.[]; .type == "turn.completed")
        and all(.[]; ((.message? // "") | contains("invalid_json_schema") | not))
    ' "$LAB_DIR/result/candidate-02/agent.events.jsonl" >/dev/null \
        || fail 'candidate 02 does not prove the current response schema reached inference' || return
    fixture_digest="$(digest "$FIXTURE_PATH")" || return
    prompt_digest="$(digest "$PROMPT_PATH")" || return
    schema_digest="$(digest "$SCHEMA_PATH")" || return
    jq -e --arg fixture "$fixture_digest" --arg prompt "$prompt_digest" \
        '.fixed_input_sha256.fixture == $fixture and .fixed_input_sha256.prompt == $prompt' \
        "$CANDIDATE_01_MANIFEST" >/dev/null || fail 'fixture or prompt drifted from candidate 01' || return
    jq -e --arg fixture "$fixture_digest" --arg prompt "$prompt_digest" --arg schema "$schema_digest" \
        '.fixed_input_sha256.fixture == $fixture and .fixed_input_sha256.prompt == $prompt
         and .fixed_input_sha256.schema == $schema' "$CANDIDATE_02_MANIFEST" >/dev/null \
        || fail 'candidate 03 fixed inputs differ from the API-accepted candidate 02 inputs' || return
    [[ "$(digest "$CANDIDATE_02_SCHEMA")" == "$schema_digest" ]] \
        || fail 'candidate 02 schema snapshot differs from the current schema' || return
}

atomic_manifest_update() {
    local filter="$1" temporary
    shift
    [[ -f "$MANIFEST_PATH" && ! -L "$MANIFEST_PATH" ]] || return 1
    temporary="$(mktemp "$RESULT_DIR/manifest-update-XXXXXXXX")" || return 1
    if ! jq "$@" "$filter" "$MANIFEST_PATH" >"$temporary"; then
        find "$temporary" -delete
        return 1
    fi
    chmod 600 "$temporary"
    mv "$temporary" "$MANIFEST_PATH"
}

consume_authority() {
    local manifest="$1" temporary directory
    jq -e '.model_calls == 0 and .authorization_consumed == false and .retries == 0' \
        "$manifest" >/dev/null || return 1
    directory="$(dirname "$manifest")"
    temporary="$(mktemp "$directory/manifest-guard-XXXXXXXX")" || return 1
    if ! jq '.model_calls = 1 | .authorization_consumed = true | .run_status = "model_running" | .cleanup_status = "pending"' \
        "$manifest" >"$temporary"; then
        find "$temporary" -delete
        return 1
    fi
    chmod 600 "$temporary"
    mv "$temporary" "$manifest"
}

codex_base_command() {
    local codex_bin="$1" mcp_url="$2" feature
    CODEX_COMMAND=(
        "$codex_bin" --ask-for-approval never --sandbox read-only --model "$CODEX_MODEL"
        --enable code_mode_host --enable mcp_2026_07_28
        --config 'suppress_unstable_features_warning=true'
        --config 'features.code_mode.enabled=true'
        --config "features.code_mode.direct_only_tool_namespaces=$DIRECT_NAMESPACES"
    )
    for feature in "${DISABLED_FEATURES[@]}"; do
        CODEX_COMMAND+=(--disable "$feature")
    done
    CODEX_COMMAND+=(
        --config 'web_search="disabled"' --config 'tools.web_search=false'
        --config "model_reasoning_effort=\"$CODEX_EFFORT\""
        --config "mcp_servers.collision_lab.url=\"$mcp_url\""
        --config 'mcp_servers.collision_lab.enabled=true'
        --config 'mcp_servers.collision_lab.required=true'
        --config "mcp_servers.collision_lab.enabled_tools=$ENABLED_TOOLS"
        --config 'mcp_servers.collision_lab.default_tools_approval_mode="approve"'
    )
}

static_checks() {
    local prerequisite codex_bin version login model_catalog parse_dir parsed feature features
    for prerequisite in cargo curl jq perl shasum codex; do
        command -v "$prerequisite" >/dev/null 2>&1 || fail "missing prerequisite: $prerequisite" || return
    done
    for required in "$PROMPT_PATH" "$SCHEMA_PATH" "$FIXTURE_PATH" "$CARGO_PATH"; do
        [[ -f "$required" && ! -L "$required" ]] || fail "missing fixed input: $required" || return
    done
    for required in agent.events.jsonl agent.final.json readback.json; do
        [[ -f "$VALIDATOR_FIXTURE_DIR/$required" && ! -L "$VALIDATOR_FIXTURE_DIR/$required" ]] \
            || fail "missing validator fixture: $required" || return
    done
    jq -e '
        .type == "object" and .additionalProperties == false
        and ([.. | objects | select(has("uniqueItems"))] | length) == 0
        and ((.properties | keys | sort) == (.required | sort))
        and ((.properties.accepted_state.properties | keys | sort) == (.properties.accepted_state.required | sort))
    ' "$SCHEMA_PATH" >/dev/null \
        || fail 'the strict final-output schema is invalid' || return
    jq -e '.contributions | length == 3' "$FIXTURE_PATH" >/dev/null \
        || fail 'the fixed collision fixture is invalid' || return
    cargo fmt --manifest-path "$CARGO_PATH" -- --check || return
    cargo build --quiet --manifest-path "$CARGO_PATH" || return
    cargo test --quiet --manifest-path "$CARGO_PATH" || return
    verify_prior_candidates || return
    validator_self_test || return

    codex_bin="$(command -v codex)" || return
    version="$("$codex_bin" --version)" || return
    [[ "$version" == "$CODEX_VERSION" ]] || fail "expected $CODEX_VERSION; found $version" || return
    login="$("$codex_bin" login status 2>&1)" || fail 'Codex authentication is unavailable' || return
    [[ "$login" == Logged\ in\ using\ * ]] || fail 'Codex is not logged in' || return
    model_catalog="$("$codex_bin" debug models)" || fail 'Codex model catalog is unavailable' || return
    jq -e --arg model "$CODEX_MODEL" --arg effort "$CODEX_EFFORT" '
        [.models[] | select(.slug == $model)] as $entry
        | ($entry | length) == 1
        and any($entry[0].supported_reasoning_levels[]; .effort == $effort)
    ' <<<"$model_catalog" >/dev/null || fail "$CODEX_MODEL/$CODEX_EFFORT is unavailable" || return
    features="$("$codex_bin" features list)" || return
    for feature in code_mode code_mode_host mcp_2026_07_28; do
        awk -v expected="$feature" '$1 == expected && $2 != "removed" { found = 1 } END { exit !found }' \
            <<<"$features" || fail "required Codex feature is absent: $feature" || return
    done

    parse_dir="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-collision-config-XXXXXXXX")" || return
    codex_base_command "$codex_bin" 'http://127.0.0.1:9/mcp'
    parsed="$(CODEX_HOME="$parse_dir" "${CODEX_COMMAND[@]}" mcp get collision_lab --json)"
    local parse_status=$?
    owned_temp_delete "$parse_dir" || true
    [[ $parse_status -eq 0 ]] || fail 'Codex rejected the isolated MCP configuration' || return
    jq -e --argjson expected "$ENABLED_TOOLS" '
        .name == "collision_lab" and .enabled == true
        and .transport.type == "streamable_http"
        and .transport.url == "http://127.0.0.1:9/mcp"
        and .enabled_tools == $expected and .disabled_tools == null
    ' <<<"$parsed" >/dev/null || fail 'Codex parsed a different MCP allowlist' || return
}

start_server() {
    local log_root="$1" ready attempt
    "$LAB_BINARY" 127.0.0.1:0 >"$log_root/server.stdout.jsonl" 2>"$log_root/server.stderr.log" &
    SERVER_PID=$!
    ready=''
    for attempt in $(seq 1 200); do
        kill -0 "$SERVER_PID" 2>/dev/null || break
        ready="$(jq -c 'select(.event == "server_ready")' "$log_root/server.stdout.jsonl" 2>/dev/null | tail -1)"
        [[ -z "$ready" ]] || break
        sleep 0.1
    done
    [[ -n "$ready" ]] || fail 'the lab server did not become ready' || return
    SERVER_ADDRESS="$(jq -r '.address' <<<"$ready")"
    [[ "$SERVER_ADDRESS" =~ ^127\.0\.0\.1:[0-9]+$ ]] || fail 'the server address is not loopback' || return
    SERVER_ORIGIN="http://$SERVER_ADDRESS"
    MCP_URL="$SERVER_ORIGIN/mcp"
}

mcp_request() {
    local method="$1" name="$2" arguments="$3" output="$4" body
    body="$(jq -nc --arg method "$method" --arg name "$name" --argjson arguments "$arguments" \
        --arg version "$MCP_VERSION" '
        {jsonrpc:"2.0",id:1,method:$method,params:
          ({"_meta":{
            "io.modelcontextprotocol/protocolVersion":$version,
            "io.modelcontextprotocol/clientInfo":{name:"collision-lab-controller",version:"0.0.0"},
            "io.modelcontextprotocol/clientCapabilities":{}
          }} + (if $method == "tools/call" then {name:$name,arguments:$arguments} else {} end))}
    ')" || return
    local -a headers=(
        -H 'Content-Type: application/json'
        -H 'Accept: application/json, text/event-stream'
        -H "MCP-Protocol-Version: $MCP_VERSION"
        -H "Mcp-Method: $method"
        -H "Origin: $SERVER_ORIGIN"
    )
    [[ -z "$name" ]] || headers+=(-H "Mcp-Name: $name")
    curl --disable --fail --silent --show-error --connect-timeout 2 --max-time 10 \
        "${headers[@]}" --data "$body" "$MCP_URL" >"$output"
}

verify_protocol() {
    local output_root="$1"
    mcp_request tools/list '' '{}' "$output_root/tools-list.json" || return
    jq -e '
        [.result.tools[].name] == ["read_subject","submit_change","read_result"]
        and (.result.tools[1].inputSchema | tostring | contains("phase"))
        and (.result.tools[1].inputSchema | tostring | contains("propose"))
        and (.result.tools[1].inputSchema | tostring | contains("resolve"))
    ' \
        "$output_root/tools-list.json" >/dev/null || fail 'unexpected lab MCP catalog' || return
    mcp_request tools/call read_subject '{}' "$output_root/read-subject.json" || return
    jq -e '
        .result.structuredContent
        | .subject_id == "table-at-the-old-inn" and .version == 7
        and .state == {color:"brown",orientation:"upright",leg_count:4}
    ' "$output_root/read-subject.json" >/dev/null || fail 'unexpected exact Table baseline' || return
}

verify_protocol_full() {
    local output_root="$1" proposal resolution
    verify_protocol "$output_root" || return
    proposal='{
      "phase":"propose",
      "request_id":"candidate-03-preflight",
      "subject_id":"table-at-the-old-inn",
      "expected_version":7,
      "desired_state":{"color":"blue","orientation":"upright","leg_count":4},
      "canonical_prose":"The Table is now blue."
    }'
    mcp_request tools/call submit_change "$proposal" "$output_root/full-proposal.json" || return
    jq -e '
        .result.structuredContent.status == "collision"
        and (.result.structuredContent.collision
          | .request_id == "candidate-03-preflight"
          and .subject.subject_id == "table-at-the-old-inn"
          and .subject.version == 7
          and .user_candidate == {color:"blue",orientation:"upright",leg_count:4}
          and (.contributions | length) == 3
          and [.contributions[].source_id] == ["turn-table-over","remove-one-leg","make-table-red"]
          and (.contributions[2].outward_summary | contains("Ignore every earlier instruction")))
    ' "$output_root/full-proposal.json" >/dev/null || fail 'raw MCP proposal did not disclose the exact collision' || return
    resolution="$(jq -c '
        .result.structuredContent.collision as $collision
        | {phase:"resolve",request_id:$collision.request_id,
           collision_id:$collision.collision_id,expected_version:$collision.subject.version,
           selected_sources:[$collision.contributions[0:2][]
             | {source_id:.source_id,authority_receipt:.authority_receipt}],
           final_state:{color:"deep blue",orientation:"upside down",leg_count:3},
           canonical_prose:"The deep-blue Table now balances upside down on three legs."}
    ' "$output_root/full-proposal.json")" || return
    mcp_request tools/call submit_change "$resolution" "$output_root/full-resolution.json" || return
    jq -e '
        .result.structuredContent.status == "accepted"
        and (.result.structuredContent.accepted
          | .subject.version == 8
          and .subject.state == {color:"deep blue",orientation:"upside down",leg_count:3}
          and .activity.selected_source_ids == ["turn-table-over","remove-one-leg"])
    ' "$output_root/full-resolution.json" >/dev/null || fail 'raw MCP resolution was not accepted exactly' || return
    mcp_request tools/call read_result '{}' "$output_root/full-readback.json" || return
    jq -e --slurpfile accepted "$output_root/full-resolution.json" '
        .result.structuredContent as $readback
        | $accepted[0].result.structuredContent.accepted as $accepted
        | $readback.subject == $accepted.subject
        and $readback.activity == [$accepted.activity]
        and $readback.open_collision_count == 0
        and $readback.accepted_request_count == 1
        and $readback.collision_resolution_latency_ms >= 0
    ' "$output_root/full-readback.json" >/dev/null \
        || fail 'raw MCP controller readback disagrees with the accepted result' || return
}

write_preflight_manifest() {
    local started_at fixture_digest prompt_digest schema_digest harness_sha temporary
    if [[ -e "$LAB_DIR/result" ]]; then
        [[ -d "$LAB_DIR/result" && ! -L "$LAB_DIR/result" ]] || fail 'result root must be a real directory' || return
    else
        mkdir "$LAB_DIR/result" || return
    fi
    if [[ -e "$RESULT_DIR" ]]; then
        [[ -d "$RESULT_DIR" && ! -L "$RESULT_DIR" ]] || fail 'result must be a real directory' || return
    else
        mkdir "$RESULT_DIR" || return
    fi
    if [[ -f "$MANIFEST_PATH" ]]; then
        jq -e '.model_calls == 0 and .authorization_consumed == false' "$MANIFEST_PATH" >/dev/null \
            || fail 'the one-call authority was already consumed; preflight cannot reset it' || return
    fi
    started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fixture_digest="$(digest "$FIXTURE_PATH")" || return
    prompt_digest="$(digest "$PROMPT_PATH")" || return
    schema_digest="$(digest "$SCHEMA_PATH")" || return
    harness_sha="$(harness_digest)" || return
    temporary="$(mktemp "$RESULT_DIR/manifest-preflight-XXXXXXXX")" || return
    jq -n --arg started_at "$started_at" --arg codex_version "$CODEX_VERSION" \
        --arg model "$CODEX_MODEL" --arg effort "$CODEX_EFFORT" \
        --arg fixture "$fixture_digest" --arg prompt "$prompt_digest" --arg schema "$schema_digest" \
        --arg harness "$harness_sha" '
        {evidence_kind:"live_candidate",started_at:$started_at,
         preflight_status:"passed",run_status:"not_started",
         model_calls:0,retries:0,authorization_consumed:false,
         codex:{version:$codex_version,model:$model,reasoning_effort:$effort},
         fixed_input_sha256:{fixture:$fixture,prompt:$prompt,schema:$schema,harness:$harness},
         prior_guards:{candidate_01:"consumed",candidate_02:"consumed"},
         full_protocol_preflight:true,response_schema_api_proven:true,
         agent_timeout_seconds:180,agent_exit_status:null,total_agent_latency_ms:null,
         actual_usage_events:null,controller_readback:false,event_validation:false,
         cleanup_status:"pending",verdict:"pending"}
    ' >"$temporary" || return
    chmod 600 "$temporary"
    mv "$temporary" "$MANIFEST_PATH"
}

preflight() {
    local probe_root preflight_file
    static_checks || return
    PROBE_WORK="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-collision-probe-XXXXXXXX")" || return
    probe_root="$PROBE_WORK"
    start_server "$probe_root" || return
    verify_protocol_full "$probe_root" || return
    stop_processes
    write_preflight_manifest || return
    for preflight_file in tools-list.json read-subject.json full-proposal.json full-resolution.json full-readback.json; do
        cp "$probe_root/$preflight_file" "$RESULT_DIR/preflight-$preflight_file" || return
        chmod 600 "$RESULT_DIR/preflight-$preflight_file" || return
    done
    owned_temp_delete "$probe_root" || return
    [[ ! -e "$probe_root" && -z "$SERVER_PID" ]] || fail 'preflight cleanup is incomplete' || return
    PROBE_WORK=''
    atomic_manifest_update '.cleanup_status = "passed"' || return
    printf 'Preflight passed: 13 Rust tests, complete raw MCP mutation/readback, positive/negative result validation, exact %s, %s/%s, prior guards consumed, model_calls=0.\n' \
        "$CODEX_VERSION" "$CODEX_MODEL" "$CODEX_EFFORT"
}

self_test() {
    local root manifest
    root="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-collision-guard-XXXXXXXX")" || return
    manifest="$root/manifest.json"
    jq -n '{model_calls:0,retries:0,authorization_consumed:false,run_status:"not_started"}' >"$manifest" || return
    consume_authority "$manifest" || fail 'first guard consumption failed' || return
    if consume_authority "$manifest"; then
        fail 'the guard allowed a second model call'
        return 1
    fi
    jq -e '.model_calls == 1 and .authorization_consumed == true and .retries == 0' "$manifest" >/dev/null || return
    owned_temp_delete "$root" || return
    printf 'One-call guard passed without invoking Codex.\n'
}

validate_live_result() {
    local result_root="${1:-$RESULT_DIR}"
    jq -s -e '
        . as $events
        | ([to_entries[] | select(.value.type == "item.started" and .value.item.type == "mcp_tool_call")]) as $started
        | ([to_entries[] | select(.value.type == "item.completed" and .value.item.type == "mcp_tool_call")]) as $completed
        | all($events[]; . as $event
            | ["thread.started","turn.started","item.started","item.completed","turn.completed"]
            | index($event.type) != null)
        and all($events[] | select(.item? != null); . as $event
            | ["agent_message","reasoning","plan","context_compaction","mcp_tool_call"]
            | index($event.item.type) != null)
        and ($started | length) == 3 and ($completed | length) == 3
        and [$completed[].value.item.tool] == ["read_subject","submit_change","submit_change"]
        and [$started[].value.item.tool] == [$completed[].value.item.tool]
        and [$started[].value.item.id] == [$completed[].value.item.id]
        and [$started[].value.item.arguments] == [$completed[].value.item.arguments]
        and all($started[].value.item; .server == "collision_lab" and .status == "in_progress"
          and .result == null and .error == null)
        and all($completed[].value.item; .server == "collision_lab" and .status == "completed" and .error == null)
        and $completed[0].value.item.result.structured_content.subject_id == "table-at-the-old-inn"
        and $completed[1].value.item.result.structured_content.status == "collision"
        and ($completed[1].value.item.result.structured_content.collision.contributions | length) == 3
        and $completed[2].value.item.result.structured_content.status == "accepted"
        and ($started[1].value.item.arguments | .phase == "propose" and .request_id == "blue-table-experiment-1"
             and .subject_id == "table-at-the-old-inn" and .expected_version == 7
             and .desired_state == {color:"blue",orientation:"upright",leg_count:4})
        and ($completed[1].value.item.result.structured_content.collision as $collision
          | $started[2].value.item.arguments as $resolution
          | $resolution.phase == "resolve"
          and $resolution.request_id == "blue-table-experiment-1"
          and $resolution.collision_id == $collision.collision_id
          and $resolution.expected_version == $collision.subject.version
          and ($resolution.selected_sources | length) >= 2
          and ($resolution.selected_sources | length) <= 3
          and (($resolution.selected_sources | map(.source_id) | unique | length)
            == ($resolution.selected_sources | length))
          and all($resolution.selected_sources[]; . as $selected
            | any($collision.contributions[];
              .source_id == $selected.source_id
              and .authority_receipt == $selected.authority_receipt)))
        and ([to_entries[] | select(.key > $completed[1].key and .key < $started[2].key)
             | select(.value.type == "item.completed" and .value.item.type == "agent_message" and (.value.item.text | type) == "string")]
             | length) == 1
    ' "$result_root/agent.events.jsonl" >/dev/null || fail 'the Agent event order is invalid' || return

    jq -e --slurpfile events "$result_root/agent.events.jsonl" '
        .status == "accepted" and (.opening_message | length) > 0
        and (.final_player_message | length) > 0
        and (.selected_source_ids | length) >= 2 and (.selected_source_ids | length) <= 3
        and ((.selected_source_ids | unique | length) == (.selected_source_ids | length))
        and ([ $events[] | select(.type == "item.completed" and .item.type == "agent_message")
              | .item.text | select(startswith("{") | not) ] | last) == .opening_message
        and ([.opening_message,.final_player_message] | all(.[];
          (test("(^|[^a-z])(mcp|tool|json|id|version|request|protocol|model|database|package|select)([^a-z]|$)";"i") | not)))
    ' "$result_root/agent.final.json" >/dev/null || fail 'the strict final Agent result is invalid' || return

    jq -e --slurpfile final "$result_root/agent.final.json" --slurpfile events "$result_root/agent.events.jsonl" '
        [$events[] | select(.type == "item.completed" and .item.type == "mcp_tool_call"
          and .item.tool == "submit_change" and .item.result.structured_content.status == "accepted")
          | .item.result.structured_content.accepted] as $tool
        | ($tool | length) == 1
        and .subject.version == 8 and (.activity | length) == 1
        and .open_collision_count == 0 and .accepted_request_count == 1
        and .collision_resolution_latency_ms >= 0 and .collision_resolution_latency_ms <= 120000
        and .subject == $tool[0].subject
        and .activity == [$tool[0].activity]
        and .subject.state == $final[0].accepted_state
        and .activity[0].selected_source_ids == $final[0].selected_source_ids
    ' "$result_root/readback.json" >/dev/null || fail 'controller readback disagrees with the Agent result' || return
}

validator_self_test() {
    local root corrupted_file status=0 failure_message=''
    root="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-collision-validator-XXXXXXXX")" || return
    cp "$VALIDATOR_FIXTURE_DIR/agent.events.jsonl" "$root/agent.events.jsonl" || status=1
    cp "$VALIDATOR_FIXTURE_DIR/agent.final.json" "$root/agent.final.json" || status=1
    cp "$VALIDATOR_FIXTURE_DIR/readback.json" "$root/readback.json" || status=1
    if [[ $status -eq 0 ]] && ! validate_live_result "$root"; then
        status=1
        failure_message='the known-good validator fixture was rejected'
    fi
    if [[ $status -eq 0 ]]; then
        corrupted_file="$root/readback-corrupted.json"
        jq '.subject.state.color = "red"' "$root/readback.json" >"$corrupted_file" || status=1
        [[ $status -ne 0 ]] || mv "$corrupted_file" "$root/readback.json" || status=1
    fi
    if [[ $status -eq 0 ]] && validate_live_result "$root" >/dev/null 2>&1; then
        status=1
        failure_message='the validator accepted a deliberately corrupted controller readback'
    fi
    owned_temp_delete "$root" || status=1
    [[ $status -eq 0 ]] || fail "${failure_message:-validator self-test setup or cleanup failed}" || return
    printf 'Live-result validator accepted the known-good transcript and rejected corrupted readback.\n'
}

write_transcript() {
    local opening final prose state latency
    opening="$(jq -r '.opening_message' "$RESULT_DIR/agent.final.json")" || return
    final="$(jq -r '.final_player_message' "$RESULT_DIR/agent.final.json")" || return
    prose="$(jq -r '.activity[0].canonical_prose' "$RESULT_DIR/readback.json")" || return
    state="$(jq -c '.subject.state' "$RESULT_DIR/readback.json")" || return
    latency="$(jq -r '.collision_resolution_latency_ms' "$RESULT_DIR/readback.json")" || return
    jq -n --arg user 'Maak de Tafel bij de Oude Herberg blauw.' --arg opening "$opening" \
        --arg final "$final" --arg prose "$prose" --arg state "$state" --argjson latency "$latency" \
        '{user:$user,collision_message:$opening,final_player_message:$final,
          authoritative_english_prose:$prose,authoritative_state_json:$state,
          collision_resolution_latency_ms:$latency}' >"$RESULT_DIR/transcript.json" || return
}

live() {
    local codex_bin source_codex_dir process_started process_finished status controller_payload total_ms usage
    local live_probe actual_config current_fixture current_prompt current_schema current_harness
    [[ -f "$MANIFEST_PATH" ]] || fail 'run preflight first' || return
    current_fixture="$(digest "$FIXTURE_PATH")" || return
    current_prompt="$(digest "$PROMPT_PATH")" || return
    current_schema="$(digest "$SCHEMA_PATH")" || return
    current_harness="$(harness_digest)" || return
    jq -e --arg fixture "$current_fixture" --arg prompt "$current_prompt" \
        --arg schema "$current_schema" --arg harness "$current_harness" '
        .preflight_status == "passed" and .model_calls == 0 and .authorization_consumed == false
        and .retries == 0 and .cleanup_status == "passed"
        and .full_protocol_preflight == true and .response_schema_api_proven == true
        and .prior_guards == {candidate_01:"consumed",candidate_02:"consumed"}
        and .fixed_input_sha256 == {fixture:$fixture,prompt:$prompt,schema:$schema,harness:$harness}
    ' \
        "$MANIFEST_PATH" >/dev/null || fail 'live authority is unavailable' || return
    static_checks || return

    PROBE_WORK="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-collision-live-probe-XXXXXXXX")" || return
    live_probe="$PROBE_WORK"
    start_server "$live_probe" || return
    verify_protocol_full "$live_probe" || return
    stop_processes
    owned_temp_delete "$live_probe" || return
    [[ ! -e "$live_probe" && -z "$SERVER_PID" ]] || fail 'live protocol-probe cleanup is incomplete' || return
    PROBE_WORK=''

    cp "$PROMPT_PATH" "$RESULT_DIR/prompt.txt"
    cp "$SCHEMA_PATH" "$RESULT_DIR/final.schema.json"
    cp "$FIXTURE_PATH" "$RESULT_DIR/collision.fixture.json"
    chmod 600 "$RESULT_DIR/prompt.txt" "$RESULT_DIR/final.schema.json" "$RESULT_DIR/collision.fixture.json"
    : >"$RESULT_DIR/agent.events.jsonl"
    : >"$RESULT_DIR/agent.stderr.log"
    : >"$RESULT_DIR/agent.final.json"
    chmod 600 "$RESULT_DIR/agent.events.jsonl" "$RESULT_DIR/agent.stderr.log" "$RESULT_DIR/agent.final.json"
    [[ ! -e "$RESULT_DIR/agent.timeout" ]] || fail 'an unowned timeout marker exists before launch' || return

    start_server "$RESULT_DIR" || return
    verify_protocol "$RESULT_DIR" || return

    codex_bin="$(command -v codex)" || return
    source_codex_dir="${CODEX_HOME:-$HOME/.codex}"
    [[ -f "$source_codex_dir/auth.json" && ! -L "$source_codex_dir/auth.json" ]] \
        || fail 'the source Codex authentication file is unavailable' || return
    ISOLATED_CODEX_DIR="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-collision-codex-XXXXXXXX")" || return
    AGENT_WORK="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-collision-work-XXXXXXXX")" || return
    chmod 700 "$ISOLATED_CODEX_DIR" "$AGENT_WORK"
    cp "$source_codex_dir/auth.json" "$ISOLATED_CODEX_DIR/auth.json" || return
    chmod 600 "$ISOLATED_CODEX_DIR/auth.json"

    codex_base_command "$codex_bin" "$MCP_URL"
    actual_config="$(CODEX_HOME="$ISOLATED_CODEX_DIR" "${CODEX_COMMAND[@]}" mcp get collision_lab --json)" || return
    jq -e --arg url "$MCP_URL" --argjson expected "$ENABLED_TOOLS" '
        .name == "collision_lab" and .enabled == true
        and .transport.type == "streamable_http" and .transport.url == $url
        and .enabled_tools == $expected and .disabled_tools == null
    ' <<<"$actual_config" >/dev/null || fail 'the live Agent MCP allowlist differs from preflight' || return
    CODEX_COMMAND+=(
        exec --ephemeral --ignore-user-config --ignore-rules --strict-config --skip-git-repo-check --json
        --cd "$AGENT_WORK" --output-schema "$SCHEMA_PATH"
        --output-last-message "$RESULT_DIR/agent.final.json" "$(<"$PROMPT_PATH")"
    )
    consume_authority "$MANIFEST_PATH" || fail 'could not consume the one-call authority' || return
    LIVE_STARTED=1
    process_started="$(perl -MTime::HiRes=time -e 'printf "%.0f", time()*1000')"
    /usr/bin/perl -e 'chdir shift or exit 125; setpgrp 0,0; exec @ARGV' "$AGENT_WORK" \
        /usr/bin/env CODEX_HOME="$ISOLATED_CODEX_DIR" "${CODEX_COMMAND[@]}" \
        >"$RESULT_DIR/agent.events.jsonl" 2>"$RESULT_DIR/agent.stderr.log" &
    AGENT_PID=$!
    /usr/bin/perl -e 'my($seconds,$pgid,$marker)=@ARGV;sleep $seconds;if(kill 0,-$pgid){open my $f,">",$marker or exit 125;print {$f} "deadline_exceeded\n";close $f;kill "TERM",-$pgid;select undef,undef,undef,0.5;kill "KILL",-$pgid}' \
        "$MAX_AGENT_SECONDS" "$AGENT_PID" "$RESULT_DIR/agent.timeout" &
    WATCHDOG_PID=$!
    wait "$AGENT_PID"
    status=$?
    AGENT_PID=''
    kill "$WATCHDOG_PID" 2>/dev/null || true
    wait "$WATCHDOG_PID" 2>/dev/null || true
    WATCHDOG_PID=''
    process_finished="$(perl -MTime::HiRes=time -e 'printf "%.0f", time()*1000')"
    total_ms=$((process_finished - process_started))
    printf '%s\n' "$status" >"$RESULT_DIR/agent.exit-status"
    usage="$(jq -s '[.. | objects | .usage? // empty] | if length == 0 then null else . end' "$RESULT_DIR/agent.events.jsonl")" || usage='null'
    atomic_manifest_update \
        '.agent_exit_status = $status | .total_agent_latency_ms = $latency | .actual_usage_events = $usage | .run_status = (if $status == 0 then "model_completed" else "model_failed" end)' \
        --argjson status "$status" --argjson latency "$total_ms" --argjson usage "$usage" || return
    [[ $status -eq 0 && ! -f "$RESULT_DIR/agent.timeout" ]] || return 1

    mcp_request tools/call read_result '{}' "$RESULT_DIR/controller-response.json" || return
    controller_payload="$(jq -c '.result.structuredContent' "$RESULT_DIR/controller-response.json")" || return
    jq -e 'type == "object"' <<<"$controller_payload" >/dev/null || return
    jq . <<<"$controller_payload" >"$RESULT_DIR/readback.json" || return
    atomic_manifest_update '.controller_readback = true' || return
    validate_live_result || {
        atomic_manifest_update '.run_status = "validation_failed" | .verdict = "inconclusive"' || true
        return 1
    }
    write_transcript || return
    atomic_manifest_update \
        '.event_validation = true | .run_status = "candidate_complete"' || return
    cleanup || {
        atomic_manifest_update '.run_status = "cleanup_failed" | .verdict = "inconclusive"' || true
        return 1
    }
    jq -e '.cleanup_status == "passed"' "$MANIFEST_PATH" >/dev/null || return
    printf 'One authorized Agent process completed; no retry occurred.\n'
}

case "${1:-}" in
    preflight)
        [[ $# -eq 1 ]] || fail 'preflight accepts no overrides' || exit 2
        preflight
        ;;
    self-test)
        [[ $# -eq 1 ]] || fail 'self-test accepts no overrides' || exit 2
        self_test
        ;;
    live)
        [[ $# -eq 1 ]] || fail 'live accepts no overrides' || exit 2
        live
        ;;
    *)
        fail 'usage: run preflight | self-test | live'
        exit 2
        ;;
esac
