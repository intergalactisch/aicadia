#!/bin/bash
set -u
set -o pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
readonly SCHEMA_DIR="$SCRIPT_DIR/schema"
readonly PROPOSALS_SCHEMA="$SCHEMA_DIR/proposals.json"
readonly PREVIEW_SCHEMA="$SCHEMA_DIR/preview.json"
readonly COMMIT_SCHEMA="$SCHEMA_DIR/commit.json"
readonly OBSERVER_SCHEMA="$SCHEMA_DIR/observer.json"
readonly INVESTIGATION_MESSAGE_SCHEMA="$SCHEMA_DIR/investigation-message.json"
readonly INVESTIGATION_PREVIEW_SCHEMA="$SCHEMA_DIR/investigation-preview.json"
# Public preflight and live execution bind to the compiler-generated current
# catalog. The Property-era catalog remains a test-only historical snapshot.
readonly TOOL_CATALOG="$REPO_DIR/game/mcp/tool-catalog.json"
readonly CAPABILITIES='["get_world","get_user","get_character","create_character","create_entry_place","enter_world","list_activity","create_entity","list_entity_at_current_place","list_activity_at_current_place","get_entity_at_current_place","start_investigation","submit_action","submit_interaction","submit_discovery"]'
readonly ACTION_READ_TOOLS='["get_world","get_character","list_entity_at_current_place","list_activity_at_current_place"]'
readonly ACTION_COMMIT_TOOLS='["submit_action"]'
readonly OBSERVER_TOOLS='["get_character","list_entity_at_current_place","get_entity_at_current_place","list_activity_at_current_place"]'
readonly INVESTIGATION_TOOLS='["get_world","get_character","list_entity_at_current_place","get_entity_at_current_place","list_activity_at_current_place","start_investigation"]'
readonly DISCOVERY_COMMIT_TOOLS='["submit_discovery"]'
readonly DISCOVERY_RECOVERY_TOOLS='["submit_discovery","get_character","list_entity_at_current_place","get_entity_at_current_place","list_activity_at_current_place"]'
# Public preflight discovers Codex through PATH, canonicalizes that executable once
# for the run and pins its semantic CLI contract. Installation location may differ
# per machine; version or capability drift still fails before database or model work.
readonly CODEX_VERSION='codex-cli 0.147.0'
readonly SYSTEM_ENV='/usr/bin/env'
readonly CODEX_MODEL='gpt-5.6-sol'
readonly CODEX_REASONING_EFFORT='high'
readonly CODE_MODE_DIRECT_ONLY_NAMESPACES='["mcp__aicadia"]'
readonly DEFAULT_AGENT_TIMEOUT_SECONDS=600
readonly MAX_MODEL_CALLS=4
readonly MAX_RETRIES=0
readonly TOKEN_BOUNDARY='four paid model process calls; Codex CLI 0.147.0 exposes no enforceable per-run token ceiling'
readonly SELECTED_PROPOSAL_ID='two'
readonly STEERING='Make it a weathered cedar trail marker whose carving includes the unique playtest marker verbatim.'
readonly DISABLED_CODEX_FEATURES=(
    apps auth_elicitation browser_use browser_use_external browser_use_full_cdp_access
    computer_use goals hooks image_generation in_app_browser multi_agent multi_agent_v2 plugins
    remote_plugin shell_snapshot shell_tool skill_mcp_dependency_install
    tool_call_mcp_elicitation tool_suggest unified_exec workspace_dependencies
)

BASE_URL=''
MCP_URL=''
RUN_DIR=''
MANIFEST=''
DATABASE_NAME=''
OWNERSHIP_TOKEN=''
CLEANUP_REQUIRED=0
CLEANUP_DONE=0
SERVER_PID=''
AGENT_PID=''
AGENT_WATCHDOG_PID=''
ISOLATED_ACTION=''
ISOLATED_OBSERVER=''
CODEX_COMMAND=()
SANITIZED_ENV=()
INTERNAL_TEST_MODE=0
INSPECTED_CODEX_BIN=''
INSPECTED_CODEX_VERSION=''

fail() {
    printf 'agent-playtest: %s\n' "$*" >&2
    return 1
}

resolve_codex_bin() {
    local command_name binary
    if [[ $INTERNAL_TEST_MODE -eq 1 ]]; then
        [[ -n "${CODEX_BIN:-}" ]] || return 1
        command_name="$CODEX_BIN"
    else
        command_name='codex'
    fi
    binary="$(command -v "$command_name" 2>/dev/null)" || return 1
    /usr/bin/perl -MCwd=abs_path -e 'my $path=abs_path(shift); defined $path or exit 1; print "$path\n"' "$binary"
}

reject_public_overrides() {
    local variable
    [[ $INTERNAL_TEST_MODE -eq 0 ]] || return 0
    for variable in CODEX_BIN AICADIA_PLAYTEST_OUTPUT_ROOT AICADIA_PLAYTEST_TEST_MODE AICADIA_PLAYTEST_TEST_TIMEOUT_SECONDS; do
        ! declare -p "$variable" >/dev/null 2>&1 \
            || fail "public playtest forbids test or executable override: $variable" || return
    done
    while IFS= read -r variable; do
        case "$variable" in
            FAKE_*|AICADIA_INTERNAL_TEST_*)
                fail "public playtest forbids fake-only environment: $variable"
                return 1
                ;;
        esac
    done < <(compgen -e)
}

new_ownership_token() {
    openssl rand -hex 32 | tr '[:upper:]' '[:lower:]'
}

database_helper() {
    (cd "$REPO_DIR" && cargo run --quiet --bin aicadia-playtest-database -- "$@")
}

curl_json() {
    curl --disable --fail --silent --show-error --connect-timeout 2 --max-time 10 "$@"
}

http_request() {
    local method="$1" path="$2" user_id="$3" body="$4" expected_status="$5" output_file="$6"
    local status
    local -a arguments
    arguments=(--disable --silent --show-error --connect-timeout 2 --max-time 10
        -X "$method" -H 'Content-Type: application/json')
    [[ -z "$user_id" ]] || arguments+=(-H "Aicadia-User-Id: $user_id")
    [[ -z "$body" ]] || arguments+=(--data "$body")
    arguments+=(-o "$output_file" -w '%{http_code}' "$BASE_URL$path")
    status="$(curl "${arguments[@]}")" || return 1
    [[ "$status" == "$expected_status" ]] || {
        fail "$method $path returned HTTP $status instead of $expected_status."
        return 1
    }
    jq -e 'type == "object"' "$output_file" >/dev/null
}

validate_schema_policy() {
    jq -e '
        def forbidden: [
            "uniqueItems", "minLength", "maxLength", "allOf", "not",
            "dependentRequired", "dependentSchemas", "if", "then", "else"
        ];
        ([.. | objects | keys[] | select(. as $key | (forbidden | index($key)) != null)] | length) == 0
        and all(.. | objects | select(.type? == "object");
            .additionalProperties == false
            and (.properties | type) == "object"
            and (.required | type) == "array"
            and (.required | unique | length) == (.required | length)
            and (.required | sort) == (.properties | keys | sort))
    ' "$1" >/dev/null
}

validate_output_schemas() {
    local schema_dir="$SCHEMA_DIR"
    local proposals_schema preview_schema commit_schema observer_schema schema
    if [[ $INTERNAL_TEST_MODE -eq 1 && -n "${AICADIA_INTERNAL_TEST_SCHEMA_DIR:-}" ]]; then
        schema_dir="$AICADIA_INTERNAL_TEST_SCHEMA_DIR"
    fi
    proposals_schema="$schema_dir/proposals.json"
    preview_schema="$schema_dir/preview.json"
    commit_schema="$schema_dir/commit.json"
    observer_schema="$schema_dir/observer.json"
    for schema in "$proposals_schema" "$preview_schema" "$commit_schema" "$observer_schema"; do
        [[ -f "$schema" ]] || return 1
        validate_schema_policy "$schema" || return 1
    done
    jq -e '
        .type == "object" and .additionalProperties == false
        and .properties.status.const == "proposed"
        and .properties.proposals.minItems == 3 and .properties.proposals.maxItems == 3
        and (.required | sort) == (["status","marker","place_revision","proposals"] | sort)
        and .properties.proposals.items.additionalProperties == false
        and (.properties.proposals.items.required | sort) == (["id","direction","grounding"] | sort)
    ' "$proposals_schema" >/dev/null || return 1
    jq -e '
        .type == "object" and .additionalProperties == false
        and .properties.status.const == "previewed"
        and .properties.selected_proposal_id.const == "two"
        and .properties.consequence.additionalProperties == false
        and .properties.consequence.properties.type.const == "introduce_entity"
        and (.required | sort) == (["status","marker","selected_proposal_id","prose","consequence"] | sort)
        and (.properties.consequence.required | sort) == (["type","name","description","property"] | sort)
        and .properties.consequence.properties.property.minItems == 1
        and .properties.consequence.properties.property.maxItems == 1
        and .properties.consequence.properties.property.items.additionalProperties == false
        and (.properties.consequence.properties.property.items.required | sort) == (["key","value"] | sort)
        and .properties.consequence.properties.property.items.properties.key.const == "material"
        and .properties.consequence.properties.property.items.properties.value.additionalProperties == false
        and (.properties.consequence.properties.property.items.properties.value.required | sort) == (["type","text"] | sort)
        and .properties.consequence.properties.property.items.properties.value.properties.type.const == "text"
    ' "$preview_schema" >/dev/null || return 1
    jq -e '
        .type == "object" and .additionalProperties == false
        and .properties.status.const == "committed"
        and (.required | sort) == (["status","marker","request_id","activity_id","entity_id","place_id","prose","entity_name","entity_description"] | sort)
        and .properties.request_id.format == "uuid"
        and .properties.activity_id.format == "uuid"
        and .properties.entity_id.format == "uuid"
        and .properties.place_id.format == "uuid"
    ' "$commit_schema" >/dev/null || return 1
    jq -e '
        .type == "object" and .additionalProperties == false
        and .properties.status.const == "observed"
        and (.required | sort) == (["status","marker","entity_id","place_id","prose","entity_name","entity_description","property_key","property_text"] | sort)
        and .properties.entity_id.format == "uuid"
        and .properties.place_id.format == "uuid"
        and .properties.property_key.const == "material"
        and .properties.property_text.const == "weathered cedar"
    ' "$observer_schema" >/dev/null
}

validate_catalog_fixture() {
    jq -e --argjson expected "$CAPABILITIES" '
        type == "array" and [.[] | .name] == $expected
        and all(.[];
            (.name | type) == "string"
            and (.description | type) == "string"
            and (.inputSchema | type) == "object"
            and (.outputSchema | type) == "object"
            and (.annotations | type) == "object")
    ' "$TOOL_CATALOG" >/dev/null
}

validate_allowlists() {
    jq -n -e --argjson all "$CAPABILITIES" --argjson reads "$ACTION_READ_TOOLS" \
        --argjson commit "$ACTION_COMMIT_TOOLS" --argjson observer "$OBSERVER_TOOLS" '
        def subset($set): all(.[]; . as $item | ($set | index($item)) != null);
        ($reads | subset($all)) and ($commit | subset($all)) and ($observer | subset($all))
        and ($commit == ["submit_action"])
        and ([$reads[], $observer[]] | index("submit_action") | not)
        and ([$reads[], $observer[]] | index("create_character") | not)
        and ([$reads[], $observer[]] | index("create_entry_place") | not)
        and ([$reads[], $observer[]] | index("enter_world") | not)
        and ([$reads[], $observer[]] | index("create_entity") | not)
    ' >/dev/null
}

validate_investigation_fake_contract() {
    local trace="$1"
    [[ $INTERNAL_TEST_MODE -eq 1 && -f "$trace" ]] || return 1
    jq -e '
        def uuid: type == "string" and test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$");
        def safe_message:
            type == "string" and length > 0
            and (test("(^|[^a-z])(mcp|tool|json|uuid|request|attempt|server|database|protocol|retry|identifier|id)([^a-z]|$)"; "i") | not);
        def grounded($calls):
            ($calls[0:4] | map(.tool)) == [
                "get_world", "get_character", "list_entity_at_current_place",
                "list_activity_at_current_place"
            ]
            and ($calls[1].result.character.entity.id | uuid)
            and ($calls[1].result.character.current_place.entity.id | uuid)
            and $calls[2].result.place.id == $calls[1].result.character.current_place.entity.id
            and $calls[3].result.place.id == $calls[1].result.character.current_place.entity.id
            and $calls[1].result.place_revision == $calls[2].result.place_revision
            and $calls[1].result.place_revision == $calls[3].result.place_revision
            and ($calls[2].result.entity | length) == 1
            and $calls[2].result.entity[0].id != $calls[1].result.character.entity.id
            and $calls[2].result.entity[0].id != $calls[1].result.character.current_place.entity.id;
        def aicadia_calls($calls):
            all($calls[]; .authority == "aicadia");
        def start_shape($call; $outcome):
            $call.tool == "start_investigation"
            and ($call.arguments | keys) == ["request_id"]
            and ($call.arguments.request_id | uuid)
            and ($call.result | keys | sort) == ["attempt_id", "limit", "outcome"]
            and ($call.result.attempt_id | uuid)
            and $call.result.outcome == $outcome
            and $call.result.limit == {result_count:1, kind:"entity_at_current_place"};
        def recovery($entry; $tool; $code):
            ($entry.calls | length) == 1
            and $entry.calls[0].authority == "aicadia"
            and $entry.calls[0].tool == $tool
            and $entry.calls[0].error == $code
            and ($entry.player_message | safe_message);
        . as $trace
        | .evidence_kind == "fake_investigation_contract"
        and .codex_invoked == false and .model_calls == 0
        and .fallback_authority == false and .background_trigger == false
        and (.phase_order == [
            "zero_ground", "zero_start", "zero_retry", "zero_stop",
            "positive_ground", "positive_start", "positive_retry", "positive_reground",
            "preview", "confirmation", "submit", "submit_retry", "observer", "recovery"
        ])
        and grounded(.zero.calls) and aicadia_calls(.zero.calls)
        and (.zero.calls | length) == 6
        and start_shape(.zero.calls[4]; "zero")
        and .zero.calls[4] == .zero.calls[5]
        and ([.zero.calls[].tool] | index("submit_discovery") | not)
        and (.zero.player_message | safe_message)
        and grounded(.positive.calls) and aicadia_calls(.positive.calls)
        and (.positive.calls | length) == 12
        and start_shape(.positive.calls[4]; "positive")
        and .positive.calls[4] == .positive.calls[5]
        and .positive.calls[4].arguments.request_id != .zero.calls[4].arguments.request_id
        and (.positive.calls[6:10] | map(.tool)) == [
            "get_character", "list_entity_at_current_place",
            "get_entity_at_current_place", "list_activity_at_current_place"
        ]
        and .positive.calls[8].arguments.entity_id == .positive.calls[7].result.entity[0].id
        and .positive.calls[6].result.place_revision == .positive.calls[7].result.place_revision
        and .positive.calls[6].result.place_revision == .positive.calls[8].result.place_revision
        and .positive.calls[6].result.place_revision == .positive.calls[9].result.place_revision
        and .positive.calls[8].result.place.id == .positive.calls[6].result.character.current_place.entity.id
        and (.positive.preview | keys | sort) == ["find", "prose"]
        and (.positive.preview.prose | type) == "string" and (.positive.preview.prose | length) > 0
        and (.positive.preview.find | keys | sort) == ["description", "name", "property", "trait"]
        and (.positive.preview.find.name | length) > 0
        and (.positive.preview.find.description | length) > 0
        and (.positive.preview.find.property | length) == 1
        and (.positive.preview.find.trait | length) == 1
        and .positive.confirmation == {explicit:true, package:.positive.preview}
        and .positive.calls[10].tool == "submit_discovery"
        and (.positive.calls[10].arguments | keys | sort) == ["attempt_id", "find", "prose", "request_id"]
        and (.positive.calls[10].arguments.request_id | uuid)
        and .positive.calls[10].arguments.request_id != .positive.calls[4].arguments.request_id
        and .positive.calls[10].arguments.attempt_id == .positive.calls[4].result.attempt_id
        and .positive.calls[10].arguments.prose == .positive.preview.prose
        and .positive.calls[10].arguments.find == .positive.preview.find
        and (.positive.calls[10].result | keys | sort) == ["activity", "entity", "place"]
        and .positive.calls[10].result.activity.operation == "submit_discovery"
        and .positive.calls[10].result.activity.prose == .positive.preview.prose
        and .positive.calls[10].result.entity.name == .positive.preview.find.name
        and .positive.calls[10].result.entity.description == .positive.preview.find.description
        and .positive.calls[10].result.activity.property_change == [{
            entity:{id:.positive.calls[10].result.entity.id,name:.positive.preview.find.name},
            key:.positive.preview.find.property[0].key,
            value:.positive.preview.find.property[0].value
        }]
        and .positive.calls[10].result.activity.trait_change == [{
            type:"establish",
            entity:{id:.positive.calls[10].result.entity.id,name:.positive.preview.find.name},
            trait:{id:.positive.calls[10].result.activity.trait_change[0].trait.id,
                statement:.positive.preview.find.trait[0].statement}
        }]
        and .positive.calls[10] == .positive.calls[11]
        and (.positive.player_message | safe_message)
        and aicadia_calls(.positive.observer_calls)
        and (.positive.observer_calls | map(.tool)) == [
            "get_character", "list_entity_at_current_place",
            "get_entity_at_current_place", "list_activity_at_current_place"
        ]
        and .positive.observer_calls[0].result.character.entity.id != .positive.calls[6].result.character.entity.id
        and .positive.observer_calls[0].result.character.current_place.entity.id == .positive.calls[10].result.place.entity.id
        and .positive.observer_calls[0].result.place_revision == .positive.observer_calls[1].result.place_revision
        and .positive.observer_calls[0].result.place_revision == .positive.observer_calls[2].result.place_revision
        and .positive.observer_calls[0].result.place_revision == .positive.observer_calls[3].result.place_revision
        and ([.positive.observer_calls[1].result.entity[] | select(.id == $trace.positive.calls[10].result.entity.id)] | length) == 1
        and .positive.observer_calls[2].arguments.entity_id == .positive.calls[10].result.entity.id
        and .positive.observer_calls[2].result.entity.id == .positive.calls[10].result.entity.id
        and .positive.observer_calls[2].result.current_state.association == [
            {type:"property", property:.positive.preview.find.property[0]},
            {type:"trait", trait:.positive.calls[10].result.activity.trait_change[0].trait}
        ]
        and any(.positive.observer_calls[3].result.activity[];
            .id == $trace.positive.calls[10].result.activity.id
            and .operation == "submit_discovery"
            and .prose == $trace.positive.preview.prose
            and .actor_character.id == $trace.positive.calls[6].result.character.entity.id
            and .context_place.entity.id == $trace.positive.calls[10].result.place.entity.id
            and .property_change == $trace.positive.calls[10].result.activity.property_change
            and .trait_change == $trace.positive.calls[10].result.activity.trait_change
            and ([.involved_entity[] | select(.role=="subject") | .entity.id] == [$trace.positive.calls[10].result.entity.id])
            and ([.involved_entity[] | select(.role=="location") | .entity.id] == [$trace.positive.calls[10].result.place.entity.id]))
        and (.recovery.admission.calls | length) == 5
        and grounded(.recovery.admission.calls)
        and aicadia_calls(.recovery.admission.calls)
        and .recovery.admission.calls[4].tool == "start_investigation"
        and .recovery.admission.calls[4].error == "investigation_not_admitted"
        and (.recovery.admission.player_message | safe_message)
        and (.recovery.unavailable.calls | length) == 5
        and aicadia_calls(.recovery.unavailable.calls)
        and .recovery.unavailable.calls[0].tool == "submit_discovery"
        and .recovery.unavailable.calls[0].error == "discovery_attempt_unavailable"
        and (.recovery.unavailable.calls[1:5] | map(.tool)) == [
            "get_character", "list_entity_at_current_place",
            "get_entity_at_current_place", "list_activity_at_current_place"
        ]
        and .recovery.unavailable.calls[3].arguments.entity_id == .recovery.unavailable.calls[2].result.entity[0].id
        and .recovery.unavailable.calls[1].result.place_revision == .recovery.unavailable.calls[2].result.place_revision
        and .recovery.unavailable.calls[1].result.place_revision == .recovery.unavailable.calls[3].result.place_revision
        and .recovery.unavailable.calls[1].result.place_revision == .recovery.unavailable.calls[4].result.place_revision
        and (.recovery.unavailable.player_message | safe_message)
        and recovery(.recovery.conflict; "submit_discovery"; "discovery_request_conflict")
    ' "$trace" >/dev/null
}

validate_codex_role_config() {
    local codex_bin="$1" enabled_tools="$2" parse_home parsed features status feature
    local -a command
    parse_home="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-codex-parse-XXXXXXXX")" || return 1
    command=(
        "$codex_bin" --enable code_mode_host --enable mcp_2026_07_28
        --config 'suppress_unstable_features_warning=true'
        --config 'features.code_mode.enabled=true'
        --config "features.code_mode.direct_only_tool_namespaces=$CODE_MODE_DIRECT_ONLY_NAMESPACES"
        --config 'web_search="disabled"' --config 'tools.web_search=false'
        --config "model_reasoning_effort=\"$CODEX_REASONING_EFFORT\""
        --config 'mcp_servers.aicadia.url="http://127.0.0.1:9/mcp"'
        --config 'mcp_servers.aicadia.enabled=true'
        --config 'mcp_servers.aicadia.required=true'
        --config "mcp_servers.aicadia.enabled_tools=$enabled_tools"
        --config 'mcp_servers.aicadia.default_tools_approval_mode="approve"'
        --config 'mcp_servers.aicadia.env_http_headers={"Aicadia-User-Id"="AICADIA_USER_ID"}'
    )
    for feature in "${DISABLED_CODEX_FEATURES[@]}"; do command+=(--disable "$feature"); done
    parsed="$(CODEX_HOME="$parse_home" "${command[@]}" mcp get aicadia --json)"
    status=$?
    features="$(CODEX_HOME="$parse_home" "${command[@]}" features list)" || status=$?
    rm -rf "$parse_home"
    [[ $status -eq 0 ]] || fail 'Codex rejected the pinned Agent configuration.' || return
    for feature in code_mode code_mode_host mcp_2026_07_28; do
        awk -v expected="$feature" '$1 == expected && $NF == "true" { found = 1 } END { exit !found }' <<<"$features" \
            || fail "Codex parsed required MCP execution plumbing as disabled: $feature" || return
    done
    for feature in "${DISABLED_CODEX_FEATURES[@]}"; do
        awk -v expected="$feature" '$1 == expected && $2 != "removed" && $NF == "false" { found = 1 } END { exit !found }' <<<"$features" \
            || fail "Codex did not parse forbidden feature as disabled: $feature" || return
    done
    jq -e --argjson expected "$enabled_tools" '
        .name == "aicadia" and .enabled == true
        and .transport.type == "streamable_http"
        and .transport.url == "http://127.0.0.1:9/mcp"
        and .transport.env_http_headers == {"Aicadia-User-Id": "AICADIA_USER_ID"}
        and .enabled_tools == $expected and .disabled_tools == null
    ' <<<"$parsed" >/dev/null || fail 'Codex parsed an unexpected MCP role configuration.' || return
}

validate_codex() {
    local codex_bin="$1" version login models features exec_help resume_help global_help feature flag
    version="$("$codex_bin" --version)" || fail 'could not read the Codex CLI version.' || return
    [[ "$version" == "$CODEX_VERSION" ]] || fail "Codex CLI must be exactly $CODEX_VERSION; found $version." || return
    INSPECTED_CODEX_BIN="$codex_bin"
    INSPECTED_CODEX_VERSION="$version"
    login="$("$codex_bin" login status 2>&1)" || fail 'Codex authentication is unavailable.' || return
    [[ "$login" == Logged\ in\ using\ * ]] || fail 'Codex must be logged in before the paid run is confirmed.' || return
    models="$("$codex_bin" debug models)" || fail 'Codex model catalog is unavailable.' || return
    jq -e --arg model "$CODEX_MODEL" --arg effort "$CODEX_REASONING_EFFORT" '
        [.models[] | select(.slug == $model)] as $entry
        | ($entry | length) == 1
        and any($entry[0].supported_reasoning_levels[]; .effort == $effort)
    ' <<<"$models" >/dev/null || fail "$CODEX_MODEL with $CODEX_REASONING_EFFORT reasoning is unavailable." || return
    features="$("$codex_bin" features list)" || fail 'Codex feature catalog is unavailable.' || return
    for feature in "${DISABLED_CODEX_FEATURES[@]}" code_mode code_mode_host mcp_2026_07_28; do
        awk -v expected="$feature" '$1 == expected && $2 != "removed" { found = 1 } END { exit !found }' <<<"$features" \
            || fail "Codex $CODEX_VERSION no longer exposes required feature control: $feature" || return
    done
    exec_help="$("$codex_bin" exec --help)" || fail 'Codex exec help is unavailable.' || return
    resume_help="$("$codex_bin" exec resume --help)" || fail 'Codex resume help is unavailable.' || return
    global_help="$("$codex_bin" --help)" || fail 'Codex global help is unavailable.' || return
    for flag in --ignore-user-config --ignore-rules --strict-config --skip-git-repo-check --json --output-schema --output-last-message; do
        grep -F -- "$flag" <<<"$exec_help" >/dev/null || fail "Codex exec flag is absent: $flag" || return
        grep -F -- "$flag" <<<"$resume_help" >/dev/null || fail "Codex resume flag is absent: $flag" || return
    done
    for flag in --ask-for-approval --sandbox --model; do
        grep -F -- "$flag" <<<"$global_help" >/dev/null || fail "Codex global flag is absent: $flag" || return
    done
    grep -F -- '[SESSION_ID]' <<<"$resume_help" >/dev/null || fail 'Codex cannot resume an explicit session id.' || return
    validate_codex_role_config "$codex_bin" "$ACTION_READ_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$ACTION_COMMIT_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$OBSERVER_TOOLS" || return
}

preflight() {
    local codex_bin prerequisite probe_token
    reject_public_overrides || return
    [[ -n "${DATABASE_URL:-}" ]] || fail 'DATABASE_URL must name a PostgreSQL administration database.' || return
    for prerequisite in cargo curl jq openssl perl; do
        command -v "$prerequisite" >/dev/null 2>&1 || fail "missing prerequisite: $prerequisite" || return
    done
    [[ -x "$SYSTEM_ENV" ]] || fail "required exact environment launcher is unavailable: $SYSTEM_ENV" || return
    codex_bin="$(resolve_codex_bin)" \
        || fail 'required Codex CLI is unavailable through PATH for this playtest mode.' || return
    [[ -x "$codex_bin" ]] || fail "Codex binary is not executable: $codex_bin" || return
    [[ -f "$REPO_DIR/Cargo.toml" && -f "$REPO_DIR/game/src/bin/aicadia-provision-user.rs" && -f "$REPO_DIR/dev/src/bin/aicadia-playtest-database.rs" ]] \
        || fail 'Agent playtest operator binaries are missing.' || return
    validate_output_schemas || fail 'strict action playtest schemas are invalid.' || return
    validate_catalog_fixture || fail 'the checked-in complete Agent tool catalog is invalid.' || return
    validate_allowlists || fail 'least-privilege Agent role allowlists are invalid.' || return
    validate_codex "$codex_bin" || return
    (cd "$REPO_DIR" && cargo build --quiet --bin aicadia --bin aicadia-provision-user --bin aicadia-playtest-database) \
        || fail 'required Aicadia operator binaries do not build.' || return
    probe_token="$(new_ownership_token)" || fail 'could not generate an unguessable database ownership token.' || return
    [[ "$probe_token" =~ ^[0-9a-f]{64}$ ]] || fail 'generated database ownership token is malformed.' || return
    database_helper probe "$probe_token" >/dev/null \
        || fail 'DATABASE_URL failed the real create, ownership-tag, verify and drop probe.' || return
    printf 'Preflight passed without codex exec: exact %s at %s, %s/%s, explicit-session resume, four strict schemas, fifteen-tool catalog, three least-privilege roles, operator builds, and a real PostgreSQL owned create/verified-drop probe are ready.\n' \
        "$INSPECTED_CODEX_VERSION" "$INSPECTED_CODEX_BIN" "$CODEX_MODEL" "$CODEX_REASONING_EFFORT"
}

manifest_set() {
    local filter="$1" temporary
    shift
    [[ -n "$MANIFEST" && -f "$MANIFEST" ]] || return 0
    temporary="$(mktemp "$RUN_DIR/manifest-XXXXXXXX")" || return 1
    jq "$@" "$filter" "$MANIFEST" >"$temporary" || { rm -f "$temporary"; return 1; }
    chmod 600 "$temporary"
    mv "$temporary" "$MANIFEST"
}

agent_timeout_seconds() {
    local value="${AICADIA_AGENT_TIMEOUT_SECONDS:-$DEFAULT_AGENT_TIMEOUT_SECONDS}"
    if [[ $INTERNAL_TEST_MODE -eq 1 ]]; then
        value="${AICADIA_PLAYTEST_TEST_TIMEOUT_SECONDS:-$value}"
        [[ "$value" =~ ^[0-9]+$ && "$value" -ge 1 && "$value" -le 5 ]] \
            || fail 'fake timeout must be an integer from 1 through 5.' || return
    else
        [[ "$value" =~ ^[0-9]+$ && "$value" -ge 30 && "$value" -le 1800 ]] \
            || fail 'AICADIA_AGENT_TIMEOUT_SECONDS must be 30 through 1800.' || return
    fi
    printf '%s\n' "$value"
}

prepare_artifacts() {
    local run_root run_id marker recovery started_at timeout
    umask 077
    if [[ $INTERNAL_TEST_MODE -eq 1 ]]; then
        run_root="${AICADIA_PLAYTEST_OUTPUT_ROOT:?internal tests require a private output root}"
    else
        run_root="$REPO_DIR/dev/.playtest/agent"
    fi
    if [[ -e "$run_root" ]]; then
        [[ -d "$run_root" && ! -L "$run_root" ]] || fail 'artifact root must be a real directory.' || return
    else
        mkdir -p "$run_root" || return
    fi
    RUN_DIR="$(mktemp -d "$run_root/run-XXXXXXXX")" || return
    chmod 700 "$RUN_DIR"
    MANIFEST="$RUN_DIR/manifest.json"
    run_id="$(basename "$RUN_DIR")"
    marker="aicadia-action-playtest-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
    started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    timeout="$(agent_timeout_seconds)" || return
    OWNERSHIP_TOKEN="$(new_ownership_token)" || return
    [[ "$OWNERSHIP_TOKEN" =~ ^[0-9a-f]{64}$ ]] || fail 'generated database ownership token is malformed.' || return
    DATABASE_NAME="aicadia_playtest_$(date -u +%Y%m%d_%H%M%S)_$$_${OWNERSHIP_TOKEN:0:12}"
    recovery="DATABASE_URL=<PostgreSQL administration URL> cargo run --quiet --bin aicadia-playtest-database -- drop $DATABASE_NAME $OWNERSHIP_TOKEN"
    jq -n --arg run_id "$run_id" --arg started_at "$started_at" --arg database "$DATABASE_NAME" \
        --arg evidence_kind "$([[ $INTERNAL_TEST_MODE -eq 1 ]] && printf fake_controller_test || printf live_candidate)" \
        --arg codex_path "$INSPECTED_CODEX_BIN" --arg codex_version "$INSPECTED_CODEX_VERSION" \
        --arg model "$CODEX_MODEL" --arg effort "$CODEX_REASONING_EFFORT" \
        --arg ownership_token "$OWNERSHIP_TOKEN" --arg recovery "$recovery" --arg boundary "$TOKEN_BOUNDARY" \
        --argjson timeout "$timeout" '
        {run_id:$run_id,started_at:$started_at,evidence_kind:$evidence_kind,
         candidate_started:($evidence_kind=="live_candidate"),
         authorization_consumed:($evidence_kind=="live_candidate"),
         codex_invoked:false,model_calls:0,actual_usage_events:null,
         paid_candidate:($evidence_kind=="live_candidate"),
         frozen:{agents:2,sessions:2,process_calls:4,retries:0,token_boundary:$boundary},
         codex:{path:$codex_path,version:$codex_version,model:$model,reasoning_effort:$effort},
         agent_timeout_seconds:$timeout,
         deployment:{database:$database,ownership_token:$ownership_token,server_address:null,status:"not_created"},
         provisioning:{action_user:"pending",observer_user:"pending"},
         setup:"pending",
         phases:{proposals:"pending",preview:"pending",commit:"pending",http:"pending",observer:"pending"},
         validation:"pending",run_status:"preparing",
         cleanup:{intent:"drop_only_after_name_and_token_proof",status:"not_armed",recovery:$recovery}}
    ' >"$MANIFEST" || return
    chmod 600 "$MANIFEST"
    printf '%s\n' "$marker" >"$RUN_DIR/marker.txt"
    chmod 600 "$RUN_DIR/marker.txt"
    ISOLATED_ACTION="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-action-agent-XXXXXXXX")" || return
    ISOLATED_OBSERVER="$(mktemp -d "${TMPDIR:-/tmp}/aicadia-observer-agent-XXXXXXXX")" || return
    chmod 700 "$ISOLATED_ACTION" "$ISOLATED_OBSERVER"
}

write_initial_prompts() {
    local marker="$1"
    cat >"$RUN_DIR/action-phase-1.prompt.txt" <<PROMPT
You are the action Agent in a bounded Aicadia MCP clean-room playtest. The User has consciously asked for their next action in a disposable shared World. You have only four read-only Aicadia tools. Call each exactly once in this order: get_world, get_character, list_entity_at_current_place, list_activity_at_current_place. Use no cursor and supply no out-of-band or User-provided ids; read authoritative ids only from World responses. If the three exact-Place results do not have the same place_revision, fail instead of proposing. Confirm from get_character that the actor's combined current Property/Trait page is empty.

After those grounded reads, return exactly three distinct private action directions. Do not call submit_action or any mutating tool. Do not draft a final package, choose for the User, invent a confirmation or expose private reasoning. The evidence marker is $marker; copy it only into the required marker field. Return only the strict schema result. Copy the unchanged common place_revision into place_revision. Give proposal ids exactly one, two and three in that order, and ground every direction in the observed Character, Place, Entity or Activity state.
PROMPT
    cat >"$RUN_DIR/observer.prompt.txt" <<PROMPT
You are an independent observer Agent in a bounded Aicadia MCP clean-room playtest. A different Character has already committed one action at your exact current Place. The evidence marker is $marker. Use only direct Aicadia MCP reads. Call get_character, list_entity_at_current_place, get_entity_at_current_place for the marker Entity id derived from compact orientation, and list_activity_at_current_place exactly once each in that order, with no cursors and no out-of-band or User-provided ids. Require one shared place_revision. Find exactly one placed Entity whose name contains the marker, fetch its complete current state, require exactly material = weathered cedar, and find exactly one submit_action Activity whose canonical prose and Property change match it. Return only the strict schema result, copying authoritative ids, exact Entity name and description, exact prose, Property key and text. Never mutate, delegate, use another tool or fabricate missing evidence.
PROMPT
    chmod 600 "$RUN_DIR/action-phase-1.prompt.txt" "$RUN_DIR/observer.prompt.txt"
}

write_phase_two_prompt() {
    local marker="$1"
    cat >"$RUN_DIR/action-phase-2.prompt.txt" <<PROMPT
The User now selects proposal id $SELECTED_PROPOSAL_ID and adds this steering exactly: "$STEERING" The unique playtest marker is $marker. Draft the complete irreversible package, but do not call any tool and do not mutate World state. The prose, Entity name and Entity description must each contain the marker verbatim, must be English and must satisfy the published semantic bounds. The introduce_entity consequence must preview exactly one initial text Property with canonical key material and text weathered cedar. Return only the strict preview schema with the exact prose and complete consequence. This selection is not confirmation.
PROMPT
    chmod 600 "$RUN_DIR/action-phase-2.prompt.txt"
}

write_phase_three_prompt() {
    local marker="$1" preview="$2"
    local prose name description property
    prose="$(jq -r '.prose' "$preview")"
    name="$(jq -r '.consequence.name' "$preview")"
    description="$(jq -r '.consequence.description' "$preview")"
    property="$(jq -c '.consequence.property' "$preview")"
    cat >"$RUN_DIR/action-phase-3.prompt.txt" <<PROMPT
The User explicitly confirms the exact retained package below without edits. This is the one irreversible confirmation. Generate one fresh UUID request_id and call submit_action exactly once using the unchanged place_revision from your grounded reads, the exact prose and exact consequence below. Do not re-read, retry or call any other tool. Return only the strict commit schema copied from the accepted result.

Exact confirmed prose:
$prose

Exact confirmed consequence:
{"type":"introduce_entity","name":$(jq -Rn --arg value "$name" '$value'),"description":$(jq -Rn --arg value "$description" '$value'),"property":$property}

Evidence marker: $marker
PROMPT
    chmod 600 "$RUN_DIR/action-phase-3.prompt.txt"
}

start_deployment() {
    local ready address attempt create_result expected_create_result manual_recovery
    manifest_set '.deployment.status="create_attempted" | .cleanup.status="not_armed"' || return
    if ! create_result="$(database_helper create "$DATABASE_NAME" "$OWNERSHIP_TOKEN" 2>"$RUN_DIR/database-create.log")"; then
        manual_recovery="Manual inspection required: verify the pg_database comment for $DATABASE_NAME before any DROP; automatic cleanup is forbidden because ownership was not proved."
        manifest_set '.deployment.status="create_ambiguous_unowned" | .cleanup.status="manual_inspection_required" | .cleanup.recovery=$recovery' \
            --arg recovery "$manual_recovery" || true
        fail 'database creation was unsuccessful or ambiguous; ownership was not proved, so automatic cleanup is forbidden.'
        return 1
    fi
    printf '%s\n' "$create_result" >"$RUN_DIR/database-create.stdout.log"
    chmod 600 "$RUN_DIR/database-create.stdout.log" "$RUN_DIR/database-create.log"
    expected_create_result="ownership_verified $DATABASE_NAME $OWNERSHIP_TOKEN"
    if [[ "$create_result" != "$expected_create_result" ]]; then
        manual_recovery="Manual inspection required: helper output did not prove ownership for $DATABASE_NAME; automatic cleanup is forbidden."
        manifest_set '.deployment.status="create_ambiguous_unowned" | .cleanup.status="manual_inspection_required" | .cleanup.recovery=$recovery' \
            --arg recovery "$manual_recovery" || true
        fail 'database helper did not return exact ownership proof; automatic cleanup is forbidden.'
        return 1
    fi
    CLEANUP_REQUIRED=1
    manifest_set '.deployment.status="ownership_verified" | .cleanup.status="armed"' || return
    perl -e 'chdir shift or exit 125; setpgrp 0,0; exec @ARGV' "$REPO_DIR" \
        "$SYSTEM_ENV" DATABASE_URL="$DATABASE_URL" AICADIA_DATABASE_NAME="$DATABASE_NAME" AICADIA_PORT=0 \
        cargo run --quiet --bin aicadia >"$RUN_DIR/server.stdout.log" 2>"$RUN_DIR/server.stderr.log" &
    SERVER_PID=$!
    ready=''
    for attempt in $(seq 1 200); do
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            wait "$SERVER_PID" 2>/dev/null || true
            fail 'disposable server exited before readiness.'
            return 1
        fi
        ready="$(jq -c 'select(.event=="server_ready" and (.address|type)=="string")' "$RUN_DIR/server.stdout.log" 2>/dev/null | tail -1)"
        [[ -z "$ready" ]] || break
        sleep 0.1
    done
    [[ -n "$ready" ]] || fail 'disposable server was not ready within 20 seconds.' || return
    address="$(jq -r '.address' <<<"$ready")"
    [[ "$address" =~ ^127\.0\.0\.1:[0-9]+$ ]] || fail 'server readiness address was not loopback.' || return
    BASE_URL="http://$address"
    MCP_URL="$BASE_URL/mcp"
    manifest_set '.deployment.server_address=$address | .deployment.status="ready"' --arg address "$address"
}

verify_deployment() {
    local world openapi listed probe
    world="$(curl_json "$BASE_URL/api/world")" || return
    jq -e '.name=="Aicadia"' <<<"$world" >/dev/null || return
    openapi="$(curl_json "$BASE_URL/api/openapi.json")" || return
    jq -e --argjson expected "$CAPABILITIES" '([.paths[][]|.operationId]|sort)==($expected|sort) and ([.paths[][]|.operationId]|length)==15' <<<"$openapi" >/dev/null \
        || fail 'HTTP is not the exact fifteen-capability catalog.' || return
    listed="$(curl_json -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
        -H 'MCP-Protocol-Version: 2026-07-28' -H 'Mcp-Method: tools/list' -H "Origin: $BASE_URL" \
        --data '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientInfo":{"name":"aicadia-action-playtest","version":"0.1.0"},"io.modelcontextprotocol/clientCapabilities":{}}}}' "$MCP_URL")" || return
    jq -e --slurpfile expected "$TOOL_CATALOG" '.result.tools == $expected[0]' <<<"$listed" >/dev/null \
        || fail 'MCP tools/list differs from the complete checked-in catalog.' || return
    probe="$(curl --disable --silent --show-error --connect-timeout 2 --max-time 10 \
        -H 'Aicadia-User-Id: 00000000-0000-0000-0000-000000000000' -o /dev/null -w '%{http_code}' "$BASE_URL/api/user")" || return
    [[ "$probe" == 404 ]] || fail "disposable database probe returned HTTP $probe." || return
}

provision_user() {
    (cd "$REPO_DIR" && DATABASE_URL="$DATABASE_URL" AICADIA_DATABASE_NAME="$DATABASE_NAME" cargo run --quiet --bin aicadia-provision-user)
}

setup_world() {
    local marker="$1" user_a="$2" user_b="$3" body
    body="$(jq -nc --arg name "Action Character $marker" --arg description "Disposable action Character for $marker" '{name:$name,description:$description}')"
    http_request POST /api/character "$user_a" "$body" 201 "$RUN_DIR/setup-character-a.json" || return
    http_request POST /api/world/entry "$user_a" '' 404 "$RUN_DIR/setup-entry-missing.json" || return
    jq -e '.error.code=="entry_place_not_found"' "$RUN_DIR/setup-entry-missing.json" >/dev/null || return
    body="$(jq -nc --arg name "Entry Place $marker" --arg description "Disposable shared entry Place for $marker" '{name:$name,description:$description}')"
    http_request POST /api/place/entry "$user_a" "$body" 201 "$RUN_DIR/setup-place.json" || return
    http_request POST /api/world/entry "$user_a" '' 200 "$RUN_DIR/setup-enter-a.json" || return
    body="$(jq -nc --arg name "Observer Character $marker" --arg description "Disposable observer Character for $marker" '{name:$name,description:$description}')"
    http_request POST /api/character "$user_b" "$body" 201 "$RUN_DIR/setup-character-b.json" || return
    http_request POST /api/world/entry "$user_b" '' 200 "$RUN_DIR/setup-enter-b.json" || return
    jq -e --slurpfile a "$RUN_DIR/setup-enter-a.json" --slurpfile b "$RUN_DIR/setup-enter-b.json" \
        '$a[0].owner_user_id != $b[0].owner_user_id and $a[0].entity.id != $b[0].entity.id and $a[0].current_place == $b[0].current_place' \
        "$RUN_DIR/setup-enter-a.json" >/dev/null || fail 'setup did not place two distinct Characters together.' || return
    manifest_set '.setup={status:"passed",place_id:$place}' --arg place "$(jq -r '.current_place.entity.id' "$RUN_DIR/setup-enter-a.json")"
}

prepare_evidence_files() {
    local path
    for path in \
        action-phase-1.events.jsonl action-phase-1.stderr.log action-phase-1.final.json action-phase-1.exit-status \
        action-phase-2.events.jsonl action-phase-2.stderr.log action-phase-2.final.json action-phase-2.exit-status \
        action-phase-3.events.jsonl action-phase-3.stderr.log action-phase-3.final.json action-phase-3.exit-status \
        observer.events.jsonl observer.stderr.log observer.final.json observer.exit-status; do
        : >"$RUN_DIR/$path" || return
        chmod 600 "$RUN_DIR/$path" || return
    done
}

build_common_codex_command() {
    local codex_bin="$1" enabled_tools="$2" feature
    CODEX_COMMAND=(
        "$codex_bin" --ask-for-approval never --sandbox read-only --model "$CODEX_MODEL"
        --enable code_mode_host --enable mcp_2026_07_28 --config 'suppress_unstable_features_warning=true'
        --config 'features.code_mode.enabled=true'
        --config "features.code_mode.direct_only_tool_namespaces=$CODE_MODE_DIRECT_ONLY_NAMESPACES"
    )
    for feature in "${DISABLED_CODEX_FEATURES[@]}"; do CODEX_COMMAND+=(--disable "$feature"); done
    CODEX_COMMAND+=(
        --config 'web_search="disabled"' --config 'tools.web_search=false'
        --config "model_reasoning_effort=\"$CODEX_REASONING_EFFORT\""
        --config "mcp_servers.aicadia.url=\"$MCP_URL\""
        --config 'mcp_servers.aicadia.enabled=true'
        --config 'mcp_servers.aicadia.required=true'
        --config "mcp_servers.aicadia.enabled_tools=$enabled_tools"
        --config 'mcp_servers.aicadia.default_tools_approval_mode="approve"'
        --config 'mcp_servers.aicadia.env_http_headers={"Aicadia-User-Id"="AICADIA_USER_ID"}'
    )
}

build_sanitized_env() {
    local variable
    SANITIZED_ENV=()
    while IFS= read -r variable; do
        case "$variable" in
            DATABASE_URL|AICADIA_DATABASE_NAME|AICADIA_PORT|AICADIA_AGENT_TIMEOUT_SECONDS|AICADIA_PLAYTEST_*|CODEX_BIN|FAKE_*|PGDATABASE|PGHOST|PGHOSTADDR|PGPASSWORD|PGPORT|PGSERVICE|PGSERVICEFILE|PGSSLMODE|PGUSER)
                SANITIZED_ENV+=(-u "$variable") ;;
        esac
    done < <(compgen -e)
}

run_codex_process() {
    local cwd="$1" user_id="$2" events="$3" stderr="$4" timeout status timeout_marker agent_pgid actual_usage
    shift 4
    timeout="$(agent_timeout_seconds)" || return
    build_sanitized_env
    timeout_marker="${events%.events.jsonl}.timeout"
    if [[ $INTERNAL_TEST_MODE -eq 0 ]]; then
        manifest_set '.codex_invoked=true | .model_calls += 1' || return
    fi
    perl -e 'chdir shift or exit 125; setpgrp 0,0; exec @ARGV' "$cwd" \
        "$SYSTEM_ENV" "${SANITIZED_ENV[@]}" AICADIA_USER_ID="$user_id" "$@" >"$events" 2>"$stderr" &
    AGENT_PID=$!
    agent_pgid="$AGENT_PID"
    perl -e 'my($seconds,$pgid,$marker)=@ARGV;sleep $seconds;if(kill 0,-$pgid){open my $f,">",$marker or exit 125;print {$f} "deadline_exceeded\n";close $f;kill "TERM",-$pgid;select undef,undef,undef,0.5;kill "KILL",-$pgid}' \
        "$timeout" "$agent_pgid" "$timeout_marker" &
    AGENT_WATCHDOG_PID=$!
    wait "$AGENT_PID"; status=$?
    if [[ -f "$timeout_marker" ]]; then wait "$AGENT_WATCHDOG_PID" 2>/dev/null || true; else stop_agent_watchdog; fi
    AGENT_WATCHDOG_PID=''
    terminate_agent_group "$agent_pgid"
    AGENT_PID=''
    if [[ $INTERNAL_TEST_MODE -eq 0 ]]; then
        actual_usage="$(jq -s '[..|objects|.usage? // empty]|if length==0 then null else . end' "$RUN_DIR"/*.events.jsonl)" || return
        manifest_set '.actual_usage_events=$usage' --argjson usage "$actual_usage" || return
    fi
    [[ ! -f "$timeout_marker" ]] || return 142
    return "$status"
}

run_initial_action_agent() {
    local codex_bin="$1" user_id="$2"
    build_common_codex_command "$codex_bin" "$ACTION_READ_TOOLS"
    CODEX_COMMAND+=(exec --ignore-user-config --ignore-rules --strict-config --skip-git-repo-check --json
        --output-schema "$PROPOSALS_SCHEMA" --output-last-message "$RUN_DIR/action-phase-1.final.json"
        "$(<"$RUN_DIR/action-phase-1.prompt.txt")")
    run_codex_process "$ISOLATED_ACTION" "$user_id" "$RUN_DIR/action-phase-1.events.jsonl" "$RUN_DIR/action-phase-1.stderr.log" "${CODEX_COMMAND[@]}"
}

run_resumed_action_agent() {
    local codex_bin="$1" user_id="$2" session_id="$3" prompt_file="$4" schema="$5" events="$6" stderr="$7" final="$8" enabled_tools="$9"
    build_common_codex_command "$codex_bin" "$enabled_tools"
    CODEX_COMMAND+=(exec resume --ignore-user-config --ignore-rules --strict-config --skip-git-repo-check --json
        --output-schema "$schema" --output-last-message "$final" "$session_id" "$(<"$prompt_file")")
    run_codex_process "$ISOLATED_ACTION" "$user_id" "$events" "$stderr" "${CODEX_COMMAND[@]}"
}

run_observer_agent() {
    local codex_bin="$1" user_id="$2"
    build_common_codex_command "$codex_bin" "$OBSERVER_TOOLS"
    CODEX_COMMAND+=(exec --ephemeral --ignore-user-config --ignore-rules --strict-config --skip-git-repo-check --json
        --output-schema "$OBSERVER_SCHEMA" --output-last-message "$RUN_DIR/observer.final.json"
        "$(<"$RUN_DIR/observer.prompt.txt")")
    run_codex_process "$ISOLATED_OBSERVER" "$user_id" "$RUN_DIR/observer.events.jsonl" "$RUN_DIR/observer.stderr.log" "${CODEX_COMMAND[@]}"
}

events_are_clean() {
    local file="$1"
    [[ -s "$file" ]] || return 1
    jq -s -e '
        length>0 and all(.[];type=="object")
        and ([..|objects|select(.type?=="error" or .type?=="turn.failed" or .type?=="turn.aborted" or .status?=="failed" or .error?!=null)]|length)==0
        and all(.[]|select(.item?!=null);
            .item.type as $type
            | ["agent_message","reasoning","plan","context_compaction","mcp_tool_call"]
            | index($type)!=null)
    ' "$file" >/dev/null
}

investigation_events_are_paired() {
    local file="$1"
    jq -s -e '
        length>0 and all(.[];type=="object")
        and all(.[]; [.type] | inside(["thread.started","turn.started","item.started","item.completed","turn.completed","aicadia.test.delivery_uncertain"]))
        and all(.[] | select(.item?!=null); .item.type=="mcp_tool_call")
        and
        [.[] | select(.item?.type=="mcp_tool_call") | {event_type:.type,item:.item}] as $events
        | [.[] | select(.type=="aicadia.test.delivery_uncertain")] as $uncertain
        | [$events[] | select(.event_type=="item.started") | .item] as $started
        | [$events[] | select(.event_type=="item.completed") | .item] as $completed
        | ($events|length)>0 and ($events|length)==(($started|length)*2)
        and [$events[].event_type]==([range(0;($started|length))|["item.started","item.completed"]]|add)
        and [$started[].id]==[$completed[].id]
        and [$started[].tool]==[$completed[].tool]
        and [$started[].arguments]==[$completed[].arguments]
        and all($started[];.server=="aicadia" and .status=="in_progress" and .result==null and .error==null)
        and all($completed[];.server=="aicadia" and .status=="completed" and .error==null and (.result|type)=="object")
        and all($completed[];
            if .result.is_error? == true then
                (.result|keys|sort)==["content","is_error"]
                and (.result.content|length)==1 and .result.content[0].type=="text"
                and (.result.content[0].text|fromjson|.error.code|type)=="string"
            else
                (.result|keys|sort)==["content","structured_content"]
                and (.result.structured_content|type)=="object"
            end)
        and ($uncertain|length)<=1
        and (if ($uncertain|length)==1 then
            $uncertain[0] as $u
            | $u.server=="aicadia"
            and ([$completed[] | select(.tool==$u.tool and .arguments==$u.arguments
                and .result.structured_content==$u.persisted_result)] | length)==1
          else true end)
    ' "$file" >/dev/null
}

session_id_from_events() {
    jq -sr '[.[]|select(.type=="thread.started")|.thread_id|select(type=="string" and test("^[0-9a-fA-F-]{36}$"))] | select(length==1) | .[0]' "$1"
}

phase_one_is_valid() {
    local events="$1" final="$2" marker="$3"
    events_are_clean "$events" || return
    jq -s -e '
        def valid_optional_limit:
            . == {} or ((keys == ["limit"])
                and (.limit|type)=="number" and (.limit|floor)==.limit
                and .limit>=1 and .limit<=100);
        [.[]|select(.item?.type=="mcp_tool_call")|{event_type:.type,item:.item}] as $observed
        | [$observed[]|select(.event_type=="item.started")|.item] as $started
        | [$observed[]|select(.event_type=="item.completed")|.item] as $c
        | ($observed|length)==8
        and [$observed[].event_type]==["item.started","item.completed","item.started","item.completed","item.started","item.completed","item.started","item.completed"]
        and ($started|length)==4 and ($c|length)==4
        and [$started[].id]==[$c[].id] and ([$c[].id]|unique|length)==4
        and [$started[].tool]==[$c[].tool] and [$started[].arguments]==[$c[].arguments]
        and all($started[];.server=="aicadia" and .status=="in_progress" and .result==null and .error==null)
        and [$c[].tool]==["get_world","get_character","list_entity_at_current_place","list_activity_at_current_place"]
        and all($c[];.server=="aicadia" and .status=="completed" and .error==null and (.result.structured_content|type)=="object")
        and $c[0].arguments=={} and $c[1].arguments=={}
        and ($c[2].arguments|valid_optional_limit)
        and ($c[3].arguments|valid_optional_limit)
        and $c[0].result.structured_content.name=="Aicadia"
        and ($c[1].result.structured_content.character.current_place|type)=="object"
        and $c[1].result.structured_content.current_state.association==[]
        and $c[1].result.structured_content.current_state.next==null
        and $c[2].result.structured_content.place.id==$c[1].result.structured_content.character.current_place.entity.id
        and $c[3].result.structured_content.place.id==$c[1].result.structured_content.character.current_place.entity.id
        and $c[1].result.structured_content.place_revision==$c[2].result.structured_content.place_revision
        and $c[1].result.structured_content.place_revision==$c[3].result.structured_content.place_revision
        and $c[2].result.structured_content.place_revision==$c[3].result.structured_content.place_revision
    ' "$events" >/dev/null || return
    local revision
    revision="$(jq -sr '[.[]|select(.type=="item.completed" and .item.type=="mcp_tool_call")|.item][2].result.structured_content.place_revision' "$events")" || return
    jq -e --arg marker "$marker" --arg revision "$revision" '
        (keys|sort)==(["status","marker","place_revision","proposals"]|sort)
        and .status=="proposed" and .marker==$marker and .place_revision==$revision
        and (.proposals|length)==3 and [.proposals[].id]==["one","two","three"]
        and ([.proposals[].direction]|unique|length)==3
        and ([.proposals[].grounding]|unique|length)==3
        and all(.proposals[];(.direction|length)>0 and (.grounding|length)>0)
    ' "$final" >/dev/null
}

preview_is_valid() {
    local events="$1" final="$2" marker="$3"
    events_are_clean "$events" || return
    jq -s -e '[.[]|select(.item?.type=="mcp_tool_call")]|length==0' "$events" >/dev/null || return
    jq -e --arg marker "$marker" '
        (keys|sort)==(["status","marker","selected_proposal_id","prose","consequence"]|sort)
        and .status=="previewed" and .marker==$marker and .selected_proposal_id=="two"
        and .consequence.type=="introduce_entity"
        and .consequence.property==[{key:"material",value:{type:"text",text:"weathered cedar"}}]
        and (.prose|contains($marker)) and (.consequence.name|contains($marker)) and (.consequence.description|contains($marker))
        and (.prose|length)>0 and (.prose|length)<=4000
        and (.consequence.name|length)>0 and (.consequence.name|length)<=120
        and (.consequence.description|length)>0 and (.consequence.description|length)<=4000
    ' "$final" >/dev/null
}

commit_is_valid() {
    local events="$1" final="$2" preview="$3" marker="$4" revision="$5"
    events_are_clean "$events" || return
    jq -s -e --arg revision "$revision" --slurpfile preview "$preview" '
        [.[]|select(.item?.type=="mcp_tool_call")|{event_type:.type,item:.item}] as $observed
        | [$observed[]|select(.event_type=="item.started")|.item] as $started
        | [$observed[]|select(.event_type=="item.completed")|.item] as $c
        | ($observed|length)==2 and [$observed[].event_type]==["item.started","item.completed"]
        and ($started|length)==1 and ($c|length)==1
        and ($started[0].id|type)=="string" and $started[0].id==$c[0].id
        and $started[0].server=="aicadia" and $started[0].tool=="submit_action"
        and $started[0].status=="in_progress" and $started[0].result==null and $started[0].error==null
        and $started[0].arguments==$c[0].arguments
        and all($observed[];.item.server=="aicadia" and .item.tool=="submit_action")
        and ($c|length)==1 and $c[0].server=="aicadia" and $c[0].tool=="submit_action"
        and $c[0].status=="completed" and $c[0].error==null
        and ($c[0].arguments|keys|sort)==(["request_id","expected_place_revision","prose","consequence"]|sort)
        and ($c[0].arguments.request_id|test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"))
        and $c[0].arguments.expected_place_revision==$revision
        and $c[0].arguments.prose==$preview[0].prose
        and $c[0].arguments.consequence==$preview[0].consequence
        and ($c[0].result.structured_content|type)=="object"
        and $c[0].result.structured_content.activity.operation=="submit_action"
        and $c[0].result.structured_content.activity.prose==$preview[0].prose
        and $c[0].result.structured_content.consequence.type=="introduce_entity"
        and $c[0].result.structured_content.consequence.entity.name==$preview[0].consequence.name
        and $c[0].result.structured_content.consequence.entity.description==$preview[0].consequence.description
        and $c[0].result.structured_content.activity.property_change==[{
            entity:{id:$c[0].result.structured_content.consequence.entity.id,name:$preview[0].consequence.name},
            key:"material",value:{type:"text",text:"weathered cedar"}
        }]
        and $c[0].result.structured_content.activity.context_place.entity.id==$c[0].result.structured_content.place.entity.id
        and ($c[0].result.structured_content.activity.involved_entity|map(.role)|sort)==["location","subject"]
    ' "$events" >/dev/null || return
    local result
    result="$(jq -sc '[.[]|select(.type=="item.completed" and .item.type=="mcp_tool_call")|.item][0]' "$events")" || return
    jq -e --arg marker "$marker" --argjson call "$result" --slurpfile preview "$preview" '
        .status=="committed" and .marker==$marker
        and .request_id==$call.arguments.request_id
        and .activity_id==$call.result.structured_content.activity.id
        and .entity_id==$call.result.structured_content.consequence.entity.id
        and .place_id==$call.result.structured_content.place.entity.id
        and .prose==$preview[0].prose and .entity_name==$preview[0].consequence.name
        and .entity_description==$preview[0].consequence.description
    ' "$final" >/dev/null
}

observer_is_valid() {
    local events="$1" final="$2" marker="$3" preview="$4" entity_id="$5" place_id="$6"
    events_are_clean "$events" || return
    jq -s -e --arg marker "$marker" --arg entity "$entity_id" --arg place "$place_id" --slurpfile preview "$preview" '
        def valid_optional_limit:
            . == {} or ((keys == ["limit"])
                and (.limit|type)=="number" and (.limit|floor)==.limit
                and .limit>=1 and .limit<=100);
        def valid_entity_args($entity):
            . == {entity_id:$entity} or (((keys|sort) == ["entity_id","limit"])
                and .entity_id==$entity and (.limit|type)=="number"
                and (.limit|floor)==.limit and .limit>=1 and .limit<=100);
        [.[]|select(.item?.type=="mcp_tool_call")|{event_type:.type,item:.item}] as $observed
        | [$observed[]|select(.event_type=="item.started")|.item] as $started
        | [$observed[]|select(.event_type=="item.completed")|.item] as $c
        | ($observed|length)==8
        and [$observed[].event_type]==["item.started","item.completed","item.started","item.completed","item.started","item.completed","item.started","item.completed"]
        and ($started|length)==4 and ($c|length)==4
        and [$started[].id]==[$c[].id] and ([$c[].id]|unique|length)==4
        and [$started[].tool]==[$c[].tool] and [$started[].arguments]==[$c[].arguments]
        and all($started[];.server=="aicadia" and .status=="in_progress" and .result==null and .error==null)
        and [$c[].tool]==["get_character","list_entity_at_current_place","get_entity_at_current_place","list_activity_at_current_place"]
        and all($c[];.server=="aicadia" and .status=="completed" and .error==null)
        and $c[0].arguments=={}
        and ($c[1].arguments|valid_optional_limit)
        and ($c[2].arguments|valid_entity_args($entity))
        and ($c[3].arguments|valid_optional_limit)
        and $c[0].result.structured_content.character.current_place.entity.id==$place
        and $c[1].result.structured_content.place.id==$place
        and any($c[1].result.structured_content.entity[];
            .id==$entity and .name==$preview[0].consequence.name
            and .description==$preview[0].consequence.description and (has("current_state")|not))
        and $c[2].result.structured_content.place.id==$place
        and $c[2].result.structured_content.entity=={
            id:$entity,name:$preview[0].consequence.name,description:$preview[0].consequence.description}
        and $c[2].result.structured_content.current_state.association==[{
            type:"property",property:{key:"material",value:{type:"text",text:"weathered cedar"}}}]
        and $c[2].result.structured_content.current_state.next==null
        and $c[3].result.structured_content.place.id==$place
        and $c[0].result.structured_content.place_revision==$c[1].result.structured_content.place_revision
        and $c[0].result.structured_content.place_revision==$c[2].result.structured_content.place_revision
        and $c[0].result.structured_content.place_revision==$c[3].result.structured_content.place_revision
        and any($c[3].result.structured_content.activity[];
            .operation=="submit_action" and .prose==$preview[0].prose
            and .context_place.entity.id==$place
            and .property_change==[{entity:{id:$entity,name:$preview[0].consequence.name},key:"material",value:{type:"text",text:"weathered cedar"}}]
            and any(.involved_entity[];.entity.id==$entity and .role=="subject"))
    ' "$events" >/dev/null || return
    jq -e --arg marker "$marker" --arg entity "$entity_id" --arg place "$place_id" --slurpfile preview "$preview" '
        .status=="observed" and .marker==$marker and .entity_id==$entity and .place_id==$place
        and .prose==$preview[0].prose and .entity_name==$preview[0].consequence.name
        and .entity_description==$preview[0].consequence.description
        and .property_key=="material" and .property_text=="weathered cedar"
    ' "$final" >/dev/null
}

validate_authoritative_http() {
    local user_a="$1" user_b="$2" preview="$3" commit="$4" entity_id place_id activity_id
    entity_id="$(jq -r '.entity_id' "$commit")"
    place_id="$(jq -r '.place_id' "$commit")"
    activity_id="$(jq -r '.activity_id' "$commit")"
    http_request GET '/api/place/current/entity?limit=100' "$user_b" '' 200 "$RUN_DIR/http-observer-entity.json" || return
    http_request GET "/api/place/current/entity/$entity_id?limit=100" "$user_b" '' 200 "$RUN_DIR/http-observer-entity-state.json" || return
    http_request GET '/api/place/current/activity?limit=100' "$user_b" '' 200 "$RUN_DIR/http-observer-activity.json" || return
    http_request GET /api/character "$user_a" '' 200 "$RUN_DIR/http-action-character.json" || return
    http_request GET /api/character "$user_b" '' 200 "$RUN_DIR/http-observer-character.json" || return
    jq -e --arg entity "$entity_id" --arg place "$place_id" --slurpfile preview "$preview" \
        '.place.id==$place
        and ([.entity[]|select(.id==$entity
          and .name==$preview[0].consequence.name
          and .description==$preview[0].consequence.description)]|length)==1' \
        "$RUN_DIR/http-observer-entity.json" >/dev/null || return
    jq -e --arg entity "$entity_id" --arg place "$place_id" --slurpfile preview "$preview" '
        .place.id==$place and .entity.id==$entity
        and .entity.name==$preview[0].consequence.name
        and .entity.description==$preview[0].consequence.description
        and .current_state.association==[{
          type:"property",property:{key:"material",value:{type:"text",text:"weathered cedar"}}}]
        and .current_state.next==null
    ' "$RUN_DIR/http-observer-entity-state.json" >/dev/null || return
    jq -e --arg activity "$activity_id" --arg entity "$entity_id" --arg place "$place_id" \
        --slurpfile preview "$preview" --slurpfile action_character "$RUN_DIR/http-action-character.json" '
        .place.id==$place
        and ([.activity[]|select(.operation=="submit_action")]|length)==1
        and ([.activity[]|select(.id==$activity and .operation=="submit_action" and .prose==$preview[0].prose
            and .actor_character.id==$action_character[0].character.entity.id
            and .context_place.entity.id==$place
            and .property_change==[{
              entity:{id:$entity,name:$preview[0].consequence.name},
              key:"material",value:{type:"text",text:"weathered cedar"}}]
            and any(.involved_entity[];.entity.id==$entity and .role=="subject")
            and any(.involved_entity[];.entity.id==$place and .role=="location"))]|length)==1
    ' "$RUN_DIR/http-observer-activity.json" >/dev/null || return
    jq -e --arg place "$place_id" '.character.current_place.entity.id==$place' "$RUN_DIR/http-action-character.json" >/dev/null || return
    jq -e --arg place "$place_id" '.character.current_place.entity.id==$place' "$RUN_DIR/http-observer-character.json" >/dev/null
}

stop_server() {
    if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
        kill -TERM -- "-$SERVER_PID" 2>/dev/null || kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    SERVER_PID=''
}

stop_agent_watchdog() {
    if [[ -n "$AGENT_WATCHDOG_PID" ]]; then
        kill -TERM "$AGENT_WATCHDOG_PID" 2>/dev/null || true
        wait "$AGENT_WATCHDOG_PID" 2>/dev/null || true
    fi
    AGENT_WATCHDOG_PID=''
}

terminate_agent_group() {
    [[ -n "$1" ]] || return 0
    kill -TERM -- "-$1" 2>/dev/null || true
    sleep 0.1
    kill -KILL -- "-$1" 2>/dev/null || true
}

stop_agent() {
    local pgid="$AGENT_PID"
    stop_agent_watchdog
    terminate_agent_group "$pgid"
    [[ -z "$AGENT_PID" ]] || wait "$AGENT_PID" 2>/dev/null || true
    AGENT_PID=''
}

cleanup_deployment() {
    local recovery
    stop_server
    if [[ $CLEANUP_REQUIRED -eq 1 ]]; then
        if database_helper drop "$DATABASE_NAME" "$OWNERSHIP_TOKEN" >"$RUN_DIR/database-drop.log" 2>&1; then
            CLEANUP_REQUIRED=0
            manifest_set '.deployment.status="dropped" | .deployment.server_address=null
                | .cleanup.status="dropped" | .cleanup.recovery=null' || true
        else
            recovery="DATABASE_URL=<PostgreSQL administration URL> cargo run --quiet --bin aicadia-playtest-database -- drop $DATABASE_NAME $OWNERSHIP_TOKEN"
            manifest_set '.cleanup.status="failed" | .cleanup.recovery=$recovery' --arg recovery "$recovery" || true
            fail "could not drop disposable database $DATABASE_NAME; recovery is in $MANIFEST"
            return 1
        fi
    else
        manifest_set '.cleanup.status="not_needed"' || true
    fi
}

cleanup_local_directories() {
    [[ -z "$ISOLATED_ACTION" ]] || rmdir "$ISOLATED_ACTION" 2>/dev/null || true
    [[ -z "$ISOLATED_OBSERVER" ]] || rmdir "$ISOLATED_OBSERVER" 2>/dev/null || true
    ISOLATED_ACTION=''; ISOLATED_OBSERVER=''
}

cleanup_all() {
    local status=0
    [[ $CLEANUP_DONE -eq 0 ]] || return 0
    CLEANUP_DONE=1
    stop_agent
    if [[ $CLEANUP_REQUIRED -eq 1 ]]; then cleanup_deployment || status=1; else stop_server; fi
    cleanup_local_directories
    return "$status"
}

run_internal_investigation_phase() {
    local codex_bin="$1" user_id="$2" phase="$3" tools="$4" schema="$5" prompt="$6" home="$7" execution="$8"
    build_common_codex_command "$codex_bin" "$tools"
    case "$execution" in
        ephemeral) CODEX_COMMAND+=(exec --ephemeral) ;;
        new) CODEX_COMMAND+=(exec) ;;
        resume:*) CODEX_COMMAND+=(exec resume "${execution#resume:}") ;;
        *) return 1 ;;
    esac
    CODEX_COMMAND+=(--ignore-user-config --ignore-rules --strict-config --skip-git-repo-check
        --json --output-schema "$schema" --output-last-message "$RUN_DIR/investigation-$phase.final.json" "$prompt")
    run_codex_process "$home" "$user_id" "$RUN_DIR/investigation-$phase.events.jsonl" \
        "$RUN_DIR/investigation-$phase.stderr.log" "${CODEX_COMMAND[@]}"
}

run_investigation_fake_playtest() {
    local codex_bin marker user_a_json user_b_json user_a user_b preview prompt phase investigation_session preview_session
    [[ $INTERNAL_TEST_MODE -eq 1 ]] || return 1
    preflight || return 1
    codex_bin="$INSPECTED_CODEX_BIN"
    validate_codex_role_config "$codex_bin" "$INVESTIGATION_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$DISCOVERY_COMMIT_TOOLS" || return
    validate_codex_role_config "$codex_bin" "$DISCOVERY_RECOVERY_TOOLS" || return
    validate_schema_policy "$INVESTIGATION_MESSAGE_SCHEMA" || return
    validate_schema_policy "$INVESTIGATION_PREVIEW_SCHEMA" || return
    prepare_artifacts || return 1
    manifest_set '.frozen.sessions=5 | .frozen.process_calls=7
        | .frozen.token_boundary="zero paid model calls; seven deterministic fake Codex controller process calls"' || return
    trap 'on_exit $?' EXIT
    marker="$(<"$RUN_DIR/marker.txt")"
    start_deployment || return
    verify_deployment || return
    user_a_json="$(provision_user)" || return
    user_b_json="$(provision_user)" || return
    user_a="$(jq -er '.id' <<<"$user_a_json")" || return
    user_b="$(jq -er '.id' <<<"$user_b_json")" || return
    [[ "$user_a" != "$user_b" ]] || return
    manifest_set '.provisioning.action_user=$a | .provisioning.observer_user=$b' \
        --arg a "$user_a" --arg b "$user_b" || return
    setup_world "$marker" "$user_a" "$user_b" || return
    for phase in zero preview commit observer admission unavailable conflict; do
        : >"$RUN_DIR/investigation-$phase.events.jsonl"
        : >"$RUN_DIR/investigation-$phase.stderr.log"
        : >"$RUN_DIR/investigation-$phase.final.json"
    done

    prompt="Ground only through Aicadia, start one free investigation, retry its uncertain delivery exactly, render an honest zero naturally, and stop without discovery. Never use source, HTTP, database, shell, web, remembered state, another Agent or background work. Evidence marker: $marker"
    run_internal_investigation_phase "$codex_bin" "$user_a" zero "$INVESTIGATION_TOOLS" "$INVESTIGATION_MESSAGE_SCHEMA" "$prompt" "$ISOLATED_ACTION" new || return
    investigation_session="$(session_id_from_events "$RUN_DIR/investigation-zero.events.jsonl")" || return
    prompt="Ground only through Aicadia, start one investigation with a fresh private id, retry it exactly, then after positive re-read Character, current Place Entities, relevant Entity state and current Place Activity before producing one complete found Entity and prose preview. Do not submit or invent confirmation. Evidence marker: $marker"
    run_internal_investigation_phase "$codex_bin" "$user_a" preview "$INVESTIGATION_TOOLS" "$INVESTIGATION_PREVIEW_SCHEMA" "$prompt" "$ISOLATED_ACTION" "resume:$investigation_session" || return
    preview_session="$(session_id_from_events "$RUN_DIR/investigation-preview.events.jsonl")" || return
    [[ "$preview_session" == "$investigation_session" ]] || return
    preview="$RUN_DIR/investigation-preview.final.json"
    prompt="The User explicitly confirms this exact complete discovery package without edits. Submit it once, retry only the exact uncertain delivery, and return the accepted Entity and Activity naturally without ids or protocol language: $(jq -c . "$preview")"
    run_internal_investigation_phase "$codex_bin" "$user_a" commit "$DISCOVERY_COMMIT_TOOLS" "$INVESTIGATION_MESSAGE_SCHEMA" "$prompt" "$ISOLATED_ACTION" "resume:$preview_session" || return
    prompt="As the distinct co-present observer, derive the found Entity id only from compact Aicadia orientation, read its current state and the same discovery Activity, and report naturally. Never mutate or use fallback authority. Evidence marker: $marker"
    run_internal_investigation_phase "$codex_bin" "$user_b" observer "$OBSERVER_TOOLS" "$INVESTIGATION_MESSAGE_SCHEMA" "$prompt" "$ISOLATED_OBSERVER" ephemeral || return
    prompt="Ground through Aicadia, handle investigation_not_admitted naturally without repeated start, mechanics or background work. Evidence marker: $marker"
    run_internal_investigation_phase "$codex_bin" "$user_a" admission "$INVESTIGATION_TOOLS" "$INVESTIGATION_MESSAGE_SCHEMA" "$prompt" "$ISOLATED_ACTION" ephemeral || return
    prompt="Handle discovery_attempt_unavailable neutrally, infer no reason, then re-orient through current Aicadia reads and claim no find. Evidence marker: $marker"
    run_internal_investigation_phase "$codex_bin" "$user_a" unavailable "$DISCOVERY_RECOVERY_TOOLS" "$INVESTIGATION_MESSAGE_SCHEMA" "$prompt" "$ISOLATED_ACTION" ephemeral || return
    prompt="Handle discovery_request_conflict naturally without editing or reusing the conflicted id, exposing protocol work or triggering background work. Evidence marker: $marker"
    run_internal_investigation_phase "$codex_bin" "$user_a" conflict "$DISCOVERY_COMMIT_TOOLS" "$INVESTIGATION_MESSAGE_SCHEMA" "$prompt" "$ISOLATED_ACTION" ephemeral || return

    for phase in zero preview commit observer admission unavailable conflict; do
        investigation_events_are_paired "$RUN_DIR/investigation-$phase.events.jsonl" || return
    done
    jq -e '(keys|sort)==["player_message","status"] and .status=="zero"' "$RUN_DIR/investigation-zero.final.json" >/dev/null || return
    jq -e '(keys|sort)==["package","status"] and .status=="previewed"' "$RUN_DIR/investigation-preview.final.json" >/dev/null || return
    jq -e '(keys|sort)==["player_message","status"] and .status=="committed"' "$RUN_DIR/investigation-commit.final.json" >/dev/null || return
    jq -e '(keys|sort)==["player_message","status"] and .status=="observed"' "$RUN_DIR/investigation-observer.final.json" >/dev/null || return
    for phase in admission unavailable conflict; do
        jq -e '(keys|sort)==["player_message","status"] and .status=="recovered"' "$RUN_DIR/investigation-$phase.final.json" >/dev/null || return
    done

    jq -n \
        --slurpfile zero_events "$RUN_DIR/investigation-zero.events.jsonl" \
        --slurpfile positive_events "$RUN_DIR/investigation-preview.events.jsonl" \
        --slurpfile submit_events "$RUN_DIR/investigation-commit.events.jsonl" \
        --slurpfile observer_events "$RUN_DIR/investigation-observer.events.jsonl" \
        --slurpfile admission_events "$RUN_DIR/investigation-admission.events.jsonl" \
        --slurpfile unavailable_events "$RUN_DIR/investigation-unavailable.events.jsonl" \
        --slurpfile conflict_events "$RUN_DIR/investigation-conflict.events.jsonl" \
        --slurpfile zero "$RUN_DIR/investigation-zero.final.json" \
        --slurpfile preview "$RUN_DIR/investigation-preview.final.json" \
        --slurpfile commit "$RUN_DIR/investigation-commit.final.json" \
        --slurpfile observer "$RUN_DIR/investigation-observer.final.json" \
        --slurpfile admission "$RUN_DIR/investigation-admission.final.json" \
        --slurpfile unavailable "$RUN_DIR/investigation-unavailable.final.json" \
        --slurpfile conflict "$RUN_DIR/investigation-conflict.final.json" '
        def calls($events):
          [$events[]
            | if .type=="aicadia.test.delivery_uncertain" then
                {authority:.server,tool,arguments,result:.persisted_result}
              elif .type=="item.completed" and .item.type=="mcp_tool_call" then
                .item | {authority:.server,tool,arguments}
                  + if .result.is_error==true
                      and (.result|has("structured_content")|not)
                      and (.result.content|length)==1
                      and .result.content[0].type=="text"
                    then {error:(.result.content[0].text|fromjson|.error.code)}
                    else {result:.result.structured_content} end
              else empty end];
        {evidence_kind:"fake_investigation_contract",codex_invoked:false,model_calls:0,
         fallback_authority:false,background_trigger:false,
         phase_order:["zero_ground","zero_start","zero_retry","zero_stop",
           "positive_ground","positive_start","positive_retry","positive_reground",
           "preview","confirmation","submit","submit_retry","observer","recovery"],
         zero:{calls:calls($zero_events),player_message:$zero[0].player_message},
         positive:{calls:(calls($positive_events)+calls($submit_events)),preview:$preview[0].package,
           confirmation:{explicit:true,package:$preview[0].package},player_message:$commit[0].player_message,
           observer_calls:calls($observer_events)},
         recovery:{admission:{calls:calls($admission_events),player_message:$admission[0].player_message},
           unavailable:{calls:calls($unavailable_events),player_message:$unavailable[0].player_message},
           conflict:{calls:calls($conflict_events),player_message:$conflict[0].player_message}}}
    ' >"$RUN_DIR/investigation-trace.json" || return
    validate_investigation_fake_contract "$RUN_DIR/investigation-trace.json" || return
    manifest_set '.phases={investigation_contract:{status:"passed",processes:7}}
        | .validation={status:"passed",fake_investigation_contract:true}
        | .codex_invoked=false | .model_calls=0' || return
    cleanup_deployment || return
    manifest_set '.run_status="fake_completed"' || return
    cleanup_local_directories
    CLEANUP_DONE=1
    printf 'Fake investigation controller passed with zero real Codex/model calls. Artifacts: %s\n' "$RUN_DIR"
}

on_exit() {
    local status="$1"
    trap - EXIT INT TERM HUP
    cleanup_all || status=1
    if [[ $status -ne 0 && -n "$MANIFEST" ]]; then
        manifest_set 'if .run_status=="interrupted" then . else .run_status="failed" end' || true
    fi
    exit "$status"
}

on_signal() {
    local signal="$1" status="$2"
    trap - INT TERM HUP
    [[ -z "$MANIFEST" ]] || manifest_set '.run_status="interrupted" | .interrupted_by=$signal' --arg signal "$signal" || true
    on_exit "$status"
}

run_playtest() {
    local codex_bin marker user_a_json user_b_json user_a user_b session_id revision
    local phase1_exit phase2_exit phase3_exit observer_exit entity_id place_id cleanup_failed=0
    preflight || return 1
    codex_bin="$INSPECTED_CODEX_BIN"
    [[ -x "$codex_bin" ]] || fail 'the Codex executable inspected by preflight is no longer executable.' || return
    prepare_artifacts || return 1
    trap 'on_exit $?' EXIT
    trap 'on_signal INT 130' INT
    trap 'on_signal TERM 143' TERM
    trap 'on_signal HUP 129' HUP
    marker="$(<"$RUN_DIR/marker.txt")"
    write_initial_prompts "$marker" || return
    start_deployment || return
    verify_deployment || return
    user_a_json="$(provision_user)" || fail 'failed to provision action User.' || return
    user_b_json="$(provision_user)" || fail 'failed to provision observer User.' || return
    user_a="$(jq -er '.id|select(type=="string")' <<<"$user_a_json")" || return
    user_b="$(jq -er '.id|select(type=="string")' <<<"$user_b_json")" || return
    [[ "$user_a" != "$user_b" ]] || fail 'provisioned Users are not distinct.' || return
    printf '%s\n' "$user_a_json" >"$RUN_DIR/user-action.json"
    printf '%s\n' "$user_b_json" >"$RUN_DIR/user-observer.json"
    chmod 600 "$RUN_DIR/user-action.json" "$RUN_DIR/user-observer.json"
    manifest_set '.provisioning.action_user=$a | .provisioning.observer_user=$b' --arg a "$user_a" --arg b "$user_b" || return
    setup_world "$marker" "$user_a" "$user_b" || fail 'could not establish the two-Character disposable setup.' || return
    prepare_evidence_files || return

    run_initial_action_agent "$codex_bin" "$user_a"; phase1_exit=$?
    printf '%s\n' "$phase1_exit" >"$RUN_DIR/action-phase-1.exit-status"
    [[ $phase1_exit -eq 0 ]] || fail "proposal phase exited $phase1_exit." || return
    phase_one_is_valid "$RUN_DIR/action-phase-1.events.jsonl" "$RUN_DIR/action-phase-1.final.json" "$marker" \
        || fail 'proposal phase did not prove grounded reads, exactly three proposals and zero mutation.' || return
    session_id="$(session_id_from_events "$RUN_DIR/action-phase-1.events.jsonl")" || fail 'proposal phase did not expose one resumable session id.' || return
    revision="$(jq -r '.place_revision' "$RUN_DIR/action-phase-1.final.json")"
    manifest_set '.phases.proposals={status:"passed",session_id:$session}' --arg session "$session_id" || return

    write_phase_two_prompt "$marker" || return
    run_resumed_action_agent "$codex_bin" "$user_a" "$session_id" "$RUN_DIR/action-phase-2.prompt.txt" \
        "$PREVIEW_SCHEMA" "$RUN_DIR/action-phase-2.events.jsonl" "$RUN_DIR/action-phase-2.stderr.log" \
        "$RUN_DIR/action-phase-2.final.json" "$ACTION_READ_TOOLS"; phase2_exit=$?
    printf '%s\n' "$phase2_exit" >"$RUN_DIR/action-phase-2.exit-status"
    [[ $phase2_exit -eq 0 ]] || fail "preview phase exited $phase2_exit." || return
    preview_is_valid "$RUN_DIR/action-phase-2.events.jsonl" "$RUN_DIR/action-phase-2.final.json" "$marker" \
        || fail 'preview phase did not retain one exact marker package with zero mutation.' || return
    write_phase_three_prompt "$marker" "$RUN_DIR/action-phase-2.final.json" || return
    manifest_set '.phases.preview={status:"passed"}' || return

    run_resumed_action_agent "$codex_bin" "$user_a" "$session_id" "$RUN_DIR/action-phase-3.prompt.txt" \
        "$COMMIT_SCHEMA" "$RUN_DIR/action-phase-3.events.jsonl" "$RUN_DIR/action-phase-3.stderr.log" \
        "$RUN_DIR/action-phase-3.final.json" "$ACTION_COMMIT_TOOLS"; phase3_exit=$?
    printf '%s\n' "$phase3_exit" >"$RUN_DIR/action-phase-3.exit-status"
    if [[ $phase3_exit -ne 0 ]]; then
        manifest_set '.phases.commit={status:"failed",reason:"agent_exit",exit_status:$exit}' --argjson exit "$phase3_exit" || return
        fail "commit phase exited $phase3_exit."
        return
    fi
    if ! commit_is_valid "$RUN_DIR/action-phase-3.events.jsonl" "$RUN_DIR/action-phase-3.final.json" \
        "$RUN_DIR/action-phase-2.final.json" "$marker" "$revision"; then
        manifest_set '.phases.commit={status:"failed",reason:"validation"}' || return
        fail 'commit phase did not prove exactly one confirmed submit_action.'
        return
    fi
    entity_id="$(jq -r '.entity_id' "$RUN_DIR/action-phase-3.final.json")"
    place_id="$(jq -r '.place_id' "$RUN_DIR/action-phase-3.final.json")"
    manifest_set '.phases.commit={status:"passed",entity_id:$entity,place_id:$place}' --arg entity "$entity_id" --arg place "$place_id" || return

    if ! validate_authoritative_http "$user_a" "$user_b" "$RUN_DIR/action-phase-2.final.json" "$RUN_DIR/action-phase-3.final.json"; then
        manifest_set '.phases.http={status:"failed"} | .validation={status:"failed",authoritative_http:false}' || return
        fail 'independent HTTP validation disagreed with committed World state.'
        return
    fi
    manifest_set '.phases.http={status:"passed"} | .validation={status:"passed",authoritative_http:true}' || return

    run_observer_agent "$codex_bin" "$user_b"; observer_exit=$?
    printf '%s\n' "$observer_exit" >"$RUN_DIR/observer.exit-status"
    if [[ $observer_exit -ne 0 ]]; then
        manifest_set '.phases.observer={status:"failed",reason:"agent_exit",exit_status:$exit}' --argjson exit "$observer_exit" || return
        fail "observer phase exited $observer_exit."
        return
    fi
    if ! observer_is_valid "$RUN_DIR/observer.events.jsonl" "$RUN_DIR/observer.final.json" "$marker" \
        "$RUN_DIR/action-phase-2.final.json" "$entity_id" "$place_id"; then
        manifest_set '.phases.observer={status:"failed",reason:"validation"}' || return
        fail 'observer did not independently prove the marker and canonical prose.'
        return
    fi
    manifest_set '.phases.observer={status:"passed"}' || return
    if [[ $INTERNAL_TEST_MODE -eq 0 ]]; then
        [[ "$(jq -r '.model_calls' "$MANIFEST")" == "$MAX_MODEL_CALLS" ]] \
            || fail 'candidate did not consume exactly four frozen calls.' || return
    fi
    cleanup_deployment || cleanup_failed=1
    if [[ $cleanup_failed -ne 0 ]]; then
        cleanup_local_directories
        CLEANUP_DONE=1
        return 1
    fi
    if [[ $INTERNAL_TEST_MODE -eq 1 ]]; then
        manifest_set '.run_status="fake_completed"' || return
    else
        manifest_set '.run_status="completed"' || return
    fi
    cleanup_local_directories
    CLEANUP_DONE=1
    if [[ $INTERNAL_TEST_MODE -eq 1 ]]; then
        printf 'Fake controller test passed; this is not live Agent evidence. Artifacts: %s\n' "$RUN_DIR"
    else
        printf 'Property live candidate passed exactly four calls with zero retries: one resumed Agent produced three proposals, retained one confirmed initial-Property package and submitted exactly once; an independent Agent and HTTP observed current Property state; disposable World dropped. Artifacts: %s\n' "$RUN_DIR"
    fi
}

main() {
    case "$#:${1-}" in
        1:preflight) preflight ;;
        2:run)
            [[ "$2" == --confirm-token-spend ]] || { fail 'usage: dev/playtest/agent/run run --confirm-token-spend'; return 1; }
            run_playtest ;;
        2:test-internal-preflight)
            [[ "$2" == --confirm-fake-controller-test ]] || return 1
            INTERNAL_TEST_MODE=1
            preflight
            ;;
        2:test-internal-run)
            [[ "$2" == --confirm-fake-controller-test ]] || return 1
            INTERNAL_TEST_MODE=1
            run_playtest
            ;;
        3:test-internal-investigation-contract)
            [[ "$2" == --confirm-fake-controller-test ]] || return 1
            INTERNAL_TEST_MODE=1
            validate_investigation_fake_contract "$3"
            ;;
        2:test-internal-investigation-run)
            [[ "$2" == --confirm-fake-controller-test ]] || return 1
            INTERNAL_TEST_MODE=1
            run_investigation_fake_playtest
            ;;
        *) fail 'usage: dev/playtest/agent/run preflight | dev/playtest/agent/run run --confirm-token-spend' ;;
    esac
}

main "$@"
